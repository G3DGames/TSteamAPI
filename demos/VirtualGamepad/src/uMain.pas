{ @abstract(Main form of the 3D gamepad visualiser (FMX + Gorilla3D).)

  Shows the 3D model of the connected controller (models/*.glb, chosen by
  the type Steam reports) in a Gorilla3D viewport and turns the whole
  model with the pad's own motion sensors. The mouse orbits the camera
  around it (the viewport's design camera), the wheel zooms.

  Steam Input is set up exactly as in SteamInputDemo: TSteamAPI and
  TSteamInput on the form, Steam opened by itself once the window is up
  (and again every few seconds while it fails or after the Steam client
  exits), ISteamInput started with an explicit RunFrame from a 16 ms timer
  on the UI thread, the SAME manifest and default layouts (generated by
  tools/gen_input_mapping.py; InGame set: one action per physical
  control). The banner names the pad; the rest of the window is the 3D
  view (owner 2026-11-01: no log panel - remote logging and the log file
  carry the log).

  The model does NOT follow the pad's motion at start. A long press of
  Start (LONG_PRESS_MS, 0.8 s) shows an overlay menu and switches to the
  Menu action set (D-pad up / down, A chooses, B goes back): with more
  than one controller connected, first a controller row (D-pad left /
  right goes through the pads, wrapping; A shows the one named), then
  Return to App, Enable / Disable Motion (greyed out while the pad has reported no
  motion data), Start / Stop Remote Logging (the log sender of
  SteamInputDemo, RemoteLogging/src) and Exit; every choice closes the
  overlay. When the layout Steam loaded does not bind the Menu set (an
  older copy), the overlay reads the InGame set's D-pad, A and B instead.

  Every button, both sticks and both triggers move the model's parts as
  the player moves them, any number at once: Gorilla3D's parallel
  animator (TGorillaParallelAnimator, src/Gorilla.Animation.Parallel.pas -
  written for this project by Gorilla3D's author, not part of Gorilla3D
  1.5.4) plays one clip per control,
  additively on the rest pose. Gyro and trackpads have no clips: the
  gyro turns the whole model, the trackpads are not shown yet.

  Data files (manifest, layouts, models) are read from @link(DataFolder):
  next to the executable on Windows and Linux, in Contents/Resources of
  the bundle on macOS. Every line of the log is written to
  VirtualGamepad.log next to the executable, to stderr on Linux / macOS
  and, when switched on, to a LogReceiver. }
unit uMain;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Math.Vectors, FMX.Types, FMX.Graphics, FMX.Types3D, FMX.Controls, FMX.Forms,
  FMX.StdCtrls, FMX.Controls.Presentation, FMX.Menus, FMX.Objects,
  FMX.Controls3D, FMX.Objects3D,
  Gorilla.Viewport, Gorilla.Camera, Gorilla.Light, Gorilla.Model,
  Gorilla.GLB.Loader,
  // Gorilla3D's parallel animator (src/, written for this project by
  // Gorilla3D's author; not part of Gorilla3D 1.5.4)
  Gorilla.Animation.Parallel,
  // orbit camera with exact framing (FitToBounds) - an UNCHANGED copy of
  // the owner's Sprite3D unit (github.com/peardox/Sprite3D, src/lib)
  Sprite3DCamera,
  Steamworks.Types, Steamworks.SDKTypes, Steamworks.Core, Steamworks.Components,
  Steamworks.FMX, Steamworks.Plugin.Input,
  // optional remote logging (RemoteLogging\src, nothing to do with Steam;
  // the same code as SteamInputDemo's)
  RemoteLog.Sender;

type
  { The InGame actions of steam_input_manifest.vdf: one per physical
    control, named by position with the Xbox letters (iaButtonA = the
    bottom face button on every pad). Same order as in SteamInputDemo. }
  TInputAction = (iaLeftStick, iaRightStick, iaGyro,
    iaLeftTrackpad, iaRightTrackpad, iaCenterTrackpad, iaLeftTrigger, iaRightTrigger,
    iaButtonA, iaButtonB, iaButtonX, iaButtonY, iaLeftBumper, iaRightBumper,
    iaLeftStickClick, iaRightStickClick, iaDPadUp, iaDPadDown, iaDPadLeft, iaDPadRight,
    iaStart, iaSelect, iaBackLeft, iaBackRight, iaBackLeftUpper, iaBackRightUpper,
    iaLeftTrackpadClick, iaRightTrackpadClick, iaCenterTrackpadClick);

  { The Menu set's actions (the overlay menu, see
    @link(TfrmGamepad.OpenOverlay)): A, B, D-pad up / down. }
  TMenuAction = (maConfirm, maBack, maUp, maDown, maLeft, maRight);

  { The overlay menu's items, top to bottom (oiController only with more
    than one controller connected). }
  TOverlayItem = (oiController, oiReturn, oiMotion, oiRemoteLog, oiExit);

  { A rotation as Steam reports it (InputMotionData_t.rotQuat*). }
  TPadQuat = record
    { X part. }
    X: Single;
    { Y part. }
    Y: Single;
    { Z part. }
    Z: Single;
    { W (real) part. }
    W: Single;
  end;

  { Main form: the 3D view of the connected controller. }
  TfrmGamepad = class(TForm)
    { Banner: the controller shown. }
    pnlPad: TPanel;
    { Name of the controller shown (large, bold). }
    lblPadName: TLabel;
    { The "game loop": RunFrame, reading the actions, turning the model. }
    tmPoll: TTimer;
    { Opens Steam once the form is up, and again while it fails / after
      the Steam client exited. }
    tmStart: TTimer;
    { The menu bar. }
    MainMenu1: TMainMenu;
    { File menu. }
    mnuFile: TMenuItem;
    { Opens Steam's controller layout screen for the controller shown. }
    mnuLayout: TMenuItem;
    { Separator above @link(mnuExit). }
    mnuSep1: TMenuItem;
    { Starts / stops sending the log to a LogReceiver (its text says
      which). }
    mnuRemoteLog: TMenuItem;
    { Closes the program. }
    mnuExit: TMenuItem;
    { View menu. }
    mnuView: TMenuItem;
    { Switches turning the model with the pad's motion sensors on / off
      (its text says which). }
    mnuMotion: TMenuItem;
    { Takes the pad's present orientation as the model's front view. }
    mnuRecenter: TMenuItem;
    { Turns the model round to show its back (paddles) or its face again
      (its text says which). }
    mnuShowBack: TMenuItem;
    { The Steam root component (Active False: tmStart opens Steam). }
    SteamAPI1: TSteamAPI;
    { ISteamInput component. }
    SteamInput1: TSteamInput;
    { Linux menu fix, log file, debug-only Steam settings, the 3D scene,
      the deployment check. }
    procedure FormCreate(Sender: TObject);
    { Stops polling and shuts Steam down while the controls still exist. }
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    { One frame of the "game loop". }
    procedure tmPollTimer(Sender: TObject);
    { Opens Steam (see @link(tmStart)). }
    procedure tmStartTimer(Sender: TObject);
    { File > View Controller Settings: Steam's layout screen (overlay
      binding panel). }
    procedure mnuLayoutClick(Sender: TObject);
    { File > Send log to receiver / Stop sending log. }
    procedure mnuRemoteLogClick(Sender: TObject);
    { File > Exit. }
    procedure mnuExitClick(Sender: TObject);
    { View > Follow pad motion. }
    procedure mnuMotionClick(Sender: TObject);
    { View > Recenter motion. }
    procedure mnuRecenterClick(Sender: TObject);
    { View > Show back / Show face. }
    procedure mnuShowBackClick(Sender: TObject);
    { SteamAPI1.OnLog: core log messages. }
    procedure SteamLog(Sender: TObject; ALevel: TSteamLogLevel; const AMessage: string);
    { SteamAPI1.OnInitialized: Steam started - start ISteamInput. }
    procedure SteamInitialized(Sender: TObject);
    { SteamAPI1.OnInitFailed: Steam failed to start - try again later. }
    procedure SteamInitFailed(Sender: TObject; AResult: Integer; const AMessage: string);
    { SteamAPI1.OnShutdown: Steam shut down - stop polling, wait for it. }
    procedure SteamShutdown(Sender: TObject);
    { SteamAPI1.OnSteamShutdown: the Steam client is exiting. }
    procedure SteamClientExit(Sender: TObject);
    { SteamInput1.OnSteamInputConfigurationLoaded (callback 2803): Steam
      loaded a layout for a controller. }
    procedure InputConfigurationLoaded(Sender: TObject; const AData: SteamInputConfigurationLoaded_t);
  public
    { Frees @link(FLogLines). }
    destructor Destroy; override;
  private
    { Log file every line is appended to; '' if it cannot be written. }
    FLogFile: string;
    { The Gorilla3D viewport (created in code, Align Client). }
    FViewport: TGorillaViewport;
    { The camera: Sprite3D's orbit camera, framing the model exactly with
      FitToBounds from Gorilla's own projection. }
    FCamera: TSprite3DCamera;
    { Point light riding on @link(FCamera), so the side looked at is lit. }
    FLight: TGorillaLight;
    { The left mouse button is down on the view: moving orbits. }
    FDragging: Boolean;
    { Mouse position of the last orbit step. }
    FDragLast: TPointF;
    { Zoom from the mouse wheel, applied after every fit (1 = fitted). }
    FZoom: Single;
    { Plays any number of the model's clips at once (one per pressed
      control), additively on the rest pose. }
    FAnimator: TGorillaParallelAnimator;
    { The model uses the PlayStation clip names (Cross / Circle / Square /
      Triangle) for the face buttons. }
    FPlayStation: Boolean;
    { Sign the stick x AND y values get before SetAxis: -1 (as in
      Gorilla3D's sample) for the PS5 model, +1 for the Xbox and Steam
      Controller models, whose stick clips tilt the other way on both axes
      (owner 2026-11-01: vertical first, then horizontal mirrored). }
    FStickSign: Single;
    { Scale that makes the model's largest side MODEL_SIZE scene units. }
    FModelScale: Single;
    { Last x / y given to the animator for each analog action (a clip is
      only driven when its value changes). }
    FAnimX: array[TInputAction] of Single;
    { See @link(FAnimX). }
    FAnimY: array[TInputAction] of Single;
    { The model shown, or @nil. }
    FModel: TGorillaModel;
    { File name (no folder) of @link(FModel); '' when none is loaded. }
    FModelFile: string;
    { Turn the model with the pad's motion sensors (View menu). }
    FFollowMotion: Boolean;
    { Orientation of the pad that counts as "facing the camera". }
    FMotionZero: TPadQuat;
    { @link(FMotionZero) is set (taken from the first motion data, or by
      View > Recenter). }
    FHasMotionZero: Boolean;
    { The next motion data becomes @link(FMotionZero). }
    FRecenter: Boolean;
    { Show the model's back (View > Show back) instead of its face. }
    FShowBack: Boolean;
    { The pad's rotation last applied (relative to @link(FMotionZero)),
      so View > Show back can redraw at once. }
    FLastMotion: TPadQuat;
    { Holds the model; placed at minus the model's centre, so the camera
      looks at the middle of the pad (as in the author's sample). }
    FPivot: TDummy;
    { The model's transform was written by @link(SetModelRotation) (gyro
      or Show back); until then it is exactly the sample's setup. }
    FTransformWritten: Boolean;
    { The InGame action set handle (0 until Steam has loaded the
      manifest). }
    FSetHandle: InputActionSetHandle_t;
    { Action handles, digital or analog (0 until resolved). }
    FActionHandles: array[TInputAction] of UInt64;
    { Pressed state of each digital action in the last frame (presses
      and releases are logged). }
    FPressed: array[TInputAction] of Boolean;
    { Every handle is non-zero. }
    FResolved: Boolean;
    { The "handles still 0" hint was logged. }
    FResolveWarned: Boolean;
    { When the handles were last looked up. }
    FLastResolve: TDateTime;
    { The controller shown (0 = none): the first one Steam lists. }
    FActive: InputHandle_t;
    { Number of controllers in the last frame (a change is logged). }
    FControllerCount: Integer;
    { Controllers Steam has loaded a layout for. }
    FConfigHandles: TSteamInputHandleArray;
    { Which layout Steam loaded for each of @link(FConfigHandles). }
    FConfigTexts: array of string;
    { What the banner shows (handle, type, count, layout): rebuilt only
      when this changes. }
    FPadKey: string;
    { Every line logged so far (sent first when remote logging starts);
      the oldest are dropped past LOG_KEEP_LINES. }
    FLogLines: TStringList;
    { The controller the user chose in the overlay (0 = none: the first
      one Steam lists is shown). }
    FChosenPad: InputHandle_t;
    { The controllers connected when the overlay opened (its controller
      row goes through these). }
    FMenuPads: TSteamInputHandleArray;
    { Index in @link(FMenuPads) of the controller the row names. }
    FMenuPadIndex: Integer;
    { The first non-zero motion data was logged. }
    FMotionLogged: Boolean;
    { The Menu action set handle (0 until Steam has loaded the manifest). }
    FMenuSetHandle: InputActionSetHandle_t;
    { Digital action handles of the Menu set (0 until resolved). }
    FMenuHandles: array[TMenuAction] of UInt64;
    { Pressed state of each Menu action in the last frame. Set to True
      when the overlay opens, so a button already held then must be let go
      before it counts. }
    FMenuPressed: array[TMenuAction] of Boolean;
    { The overlay menu is shown and the Menu action set is active. }
    FMenuOpen: Boolean;
    { The overlay reads the InGame set's D-pad, ButtonA and ButtonB
      instead of the Menu set: the layout Steam loaded for this pad
      binds no button to some Menu action (an older copy of our layout or
      a player's own; owner 2026-11-01: the Steam Controller's D-pad moved
      the model but not the menu). Decided in @link(OpenOverlay). }
    FMenuUsesInGame: Boolean;
    { The item the overlay highlights. }
    FMenuItem: TOverlayItem;
    { When Start went down (0 = not held). }
    FStartDownAt: TDateTime;
    { This hold of Start has opened the overlay already: Start must be let
      go before it can open it again. }
    FStartUsed: Boolean;
    { The controller shown has reported real motion data (gyro): the
      overlay's motion item is enabled. }
    FHasMotion: Boolean;
    { The overlay: dims the whole window, holds @link(FOverlayPanel)
      (Align Contents, so it moves nothing else). }
    FOverlay: TRectangle;
    { The overlay's box in the middle of the window. }
    FOverlayPanel: TRectangle;
    { Background of each item (its colour shows the highlight). }
    FOverlayItems: array[TOverlayItem] of TRectangle;
    { Text of each item (grey when it cannot be chosen). }
    FOverlayLabels: array[TOverlayItem] of TLabel;
    { The key help at the bottom of the overlay. }
    FOverlayHint: TLabel;
    { Streams every log line to a LogReceiver while assigned (optional, see
      RemoteLogging/README.md). }
    FSender: TRemoteLogSender;
    { The last search for receivers (kept until the next one or the end:
      it must not be freed from its own result handler). }
    FDiscovery: TRemoteLogDiscovery;
    { From the start of a search until its result is handled: a second
      start is ignored. }
    FRemoteBusy: Boolean;
    { Guards @link(tmPollTimer) against re-entry. }
    FPolling: Boolean;
    { Exceptions raised by the poll so far (polling stops at 3). }
    FPollErrors: Integer;
    { The window is closing: Steam is not opened again. }
    FClosing: Boolean;
    { Appends a time-stamped line to @link(FLogLines), the log file,
      stderr (POSIX) and the LogReceiver (when sending). }
    procedure AddLog(const S: string);
    { Status messages of @link(FSender), written to the log. }
    procedure RemoteLogStatus(Sender: TObject; const AText: string);
    { Starts sending the log: searches for receivers in the background
      (@link(RemoteLogDiscovered) goes on). AWhy names what asked (menu or
      overlay) in the log. Ignored while sending or searching. }
    procedure StartRemoteLog(const AWhy: string);
    { Stops sending the log. AWhy names what asked in the log. }
    procedure StopRemoteLog(const AWhy: string);
    { Result of the search: connects to the receiver found (the first one
      if several answered); none -> logs what to do. }
    procedure RemoteLogDiscovered(Sender: TObject; const AFound: TRemoteLogReceiverArray;
      const AError: string);
    { Creates @link(FSender), sends the log so far and connects. }
    procedure ConnectRemoteLog(const AHost: string; APort: Word);
    { Puts the remote log state into the File menu and the overlay. }
    procedure UpdateRemoteLogText;
    { Logs whether the manifest, the layouts and the models are in
      @link(DataFolder). }
    procedure CheckDeployment;
    { Creates the viewport, the orbiting camera and the light. }
    procedure CreateScene;
    { Shows the model for controller type T (keeps the one shown when it
      is the same file). }
    procedure ShowModelFor(T: ESteamInputType);
    { Removes the model shown (no controller: the view stays empty). }
    procedure RemoveModel;
    { Turns the model to the pad's orientation (relative to
      @link(FMotionZero)), or to the front view when motion is off. }
    procedure ApplyMotion(const M: InputMotionData_t);
    { Sizes, turns and centres the model exactly as Gorilla3D's
      ParallelAnimation sample does; logs the bounding box. }
    procedure PlaceModel;
    { Frames the model with the camera (FitToBounds for the current
      angles, a small margin), then applies the wheel zoom. }
    procedure FitView;
    { Viewport OnResize: the frame depends on the aspect ratio - refit. }
    procedure ViewportResize(Sender: TObject);
    { Viewport OnMouseDown: left starts orbiting, right resets the view. }
    procedure ViewMouseDown(Sender: TObject; Button: TMouseButton; Shift: TShiftState;
      X, Y: Single);
    { Viewport OnMouseMove: orbits while the left button is held. }
    procedure ViewMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Single);
    { Viewport OnMouseUp: ends orbiting. }
    procedure ViewMouseUp(Sender: TObject; Button: TMouseButton; Shift: TShiftState;
      X, Y: Single);
    { Viewport OnMouseWheel: zooms. }
    procedure ViewMouseWheel(Sender: TObject; Shift: TShiftState; WheelDelta: Integer;
      var Handled: Boolean);
    { Drives the clips of analog action A (sticks: SetAxis, triggers:
      SetValue) when its value changed. }
    procedure AnimateAnalog(A: TInputAction; X, Y: Single);
    { Presses or releases the clip of button action A on the model. }
    procedure AnimateButton(A: TInputAction; APressed: Boolean);
    { Puts every clip back to rest and forgets the analog values given to
      the animator (another model or controller). }
    procedure ResetAnimState;
    { Puts the model in its front view, rotated by AQ. }
    procedure SetModelRotation(const AQ: TPadQuat);
    { The started ISteamInput plug-in, or @nil. }
    function Input: TSteamInputPlugin;
    { Full path of steam_input_manifest.vdf, or '' when not found. }
    function ManifestPath: string;
    { Full path of the model file AFileName: in @link(DataFolder), or - run
      from the IDE without the post-build copy - in the repository's
      models folder; '' when in neither. }
    function ModelPath(const AFileName: string): string;
    { Forgets every handle and controller (Steam stopped or a new layout). }
    procedure ResetState;
    { Looks up the action set and action handles; logs them once resolved. }
    procedure ResolveHandles(P: TSteamInputPlugin);
    { Picks the controller to show (the first connected one); logs changes. }
    procedure RefreshControllers(P: TSteamInputPlugin);
    { Shows the controller in the banner and loads its model; logs each
      change. Cheap unless something changed. }
    procedure UpdatePadBanner(P: TSteamInputPlugin);
    { Reads every InGame action of the controller shown, logs presses and
      releases, turns the model, opens the overlay on a long press of
      Start. }
    procedure ReadActions(P: TSteamInputPlugin);
    { Reads the pad's motion data: logs the first, notes that the pad has
      motion sensors, turns the model. }
    procedure ReadMotion(P: TSteamInputPlugin);
    { Switches turning the model with the pad's motion on or off (View
      menu and the overlay): on, the pad's present orientation becomes the
      front view; off, the model goes back to its front view. }
    procedure SetFollowMotion(AOn: Boolean);
    { Creates the overlay menu (hidden). }
    procedure CreateOverlay;
    { Long press of Start: shows the overlay and switches to the Menu
      action set. }
    procedure OpenOverlay;
    { Hides the overlay and goes back to the InGame action set. }
    procedure CloseOverlay;
    { Item I can be chosen (the motion item needs motion sensors). }
    function OverlayItemEnabled(I: TOverlayItem): Boolean;
    { Redraws the overlay's texts, greying and highlight. }
    procedure UpdateOverlay;
    { Moves the highlight ADelta items down (negative: up), skipping items
      that cannot be chosen; stops at the ends. }
    procedure MoveOverlay(ADelta: Integer);
    { Does what the highlighted item says (A, or a click on it), then
      closes the overlay. }
    procedure ChooseOverlayItem;
    { OnClick of an overlay item: highlights and chooses it. }
    procedure OverlayItemClick(Sender: TObject);
    { Reads the Menu set while the overlay is shown: D-pad up / down
      moves, left / right changes the controller row, A chooses, B
      closes. }
    procedure ReadMenuActions(P: TSteamInputPlugin);
    { Moves the controller row ADelta pads on, wrapping. }
    procedure CyclePad(ADelta: Integer);
    { The controller row's text for the pad it names. }
    function PadRowText: string;
  end;

{ The folder holding the program's data files (Steam Input manifest and
  layouts, models), with a trailing path delimiter: the executable's
  folder, or Contents/Resources of the application bundle on macOS.
  @returns(Absolute folder path.) }
function DataFolder: string;

var
  { The application's main form. }
  frmGamepad: TfrmGamepad;

implementation

{$R *.fmx}

uses
  System.IOUtils, System.DateUtils,
  System.Math,       // Max - BEFORE System.StrUtils, whose string IfThen must win
  System.StrUtils, Steamworks.API, FmxLinuxMenu;

const
  { Manifest file name, in @link(DataFolder). }
  MANIFEST_FILE = 'steam_input_manifest.vdf';
  { Default layouts expected next to the manifest (keep in step with
    CONTROLLERS in tools/gen_input_mapping.py). }
  EXPECTED_LAYOUTS = 11;
  { The models, in @link(DataFolder) (keep in step with MODEL_FILES in
    tools/gen_projects.py). }
  MODEL_XBOX = 'XBoxOne_Animated.glb';
  { PlayStation model. }
  MODEL_PS = 'PS5_Animated.glb';
  { Steam Controller model. }
  MODEL_STEAM = 'SteamController_Animated.glb';
  { Every model (the deployment check looks for each). }
  MODEL_FILES: array[0..2] of string = (MODEL_XBOX, MODEL_PS, MODEL_STEAM);
  { Size of the model's largest side in scene units (as in Gorilla3D's
    ParallelAnimation sample; the camera frames it whatever its size). }
  MODEL_SIZE = 8.0;
  { Padding round the model as a fraction of the view (FitToBounds). }
  VIEW_MARGIN = 0.08;
  { Degrees the camera orbits per pixel of mouse movement. }
  ORBIT_DEGREES_PER_PIXEL = 0.4;
  { Distance factor per wheel notch (120): rolling away brings it nearer. }
  ZOOM_STEP = 1.1;
  { Text of each log level. }
  LevelNames: array[TSteamLogLevel] of string = ('debug', 'info', 'warn', 'ERROR');
  { Action names as in the manifest. }
  ActionNames: array[TInputAction] of string =
    ('LeftStick', 'RightStick', 'Gyro',
     'LeftTrackpad', 'RightTrackpad', 'CenterTrackpad', 'LeftTrigger', 'RightTrigger',
     'ButtonA', 'ButtonB', 'ButtonX', 'ButtonY', 'LeftBumper', 'RightBumper',
     'LeftStickClick', 'RightStickClick', 'DPadUp', 'DPadDown', 'DPadLeft', 'DPadRight',
     'Start', 'Select', 'BackLeft', 'BackRight', 'BackLeftUpper', 'BackRightUpper',
     'LeftTrackpadClick', 'RightTrackpadClick', 'CenterTrackpadClick');
  { Analog actions (StickPadGyro / AnalogTrigger); the rest are buttons. }
  ActionAnalog: array[TInputAction] of Boolean =
    (True, True, True,
     True, True, True, True, True,
     False, False, False, False, False, False,
     False, False, False, False, False, False,
     False, False, False, False, False, False,
     False, False, False);
  { The InGame action set name as in the manifest. }
  SET_NAME = 'InGame';
  { The Menu action set name as in the manifest (the overlay menu). }
  MENU_SET_NAME = 'Menu';
  { The Menu set's action names as in the manifest. }
  MenuActionNames: array[TMenuAction] of string =
    ('MenuConfirm', 'MenuBack', 'MenuUp', 'MenuDown', 'MenuLeft', 'MenuRight');
  { The InGame action read instead of each Menu action when the loaded
    layout does not bind the Menu set (see FMenuUsesInGame). }
  MenuFallback: array[TMenuAction] of TInputAction =
    (iaButtonA, iaButtonB, iaDPadUp, iaDPadDown, iaDPadLeft, iaDPadRight);
  { Lines kept in memory for the remote log's backlog. }
  LOG_KEEP_LINES = 20000;
  { Milliseconds Start must be held to open the overlay menu (a short
    press is just a button, shown on the model). }
  LONG_PRESS_MS = 800;
  { Overlay colours: item highlighted. }
  OVERLAY_SELECTED: TAlphaColor = $FF3A6EA5;
  { Overlay colours: item not highlighted. }
  OVERLAY_ITEM: TAlphaColor = $FF353A40;
  { Overlay colours: text of an item that can be chosen. }
  OVERLAY_TEXT: TAlphaColor = $FFFFFFFF;
  { Overlay colours: text of an item that cannot be chosen (greyed out). }
  OVERLAY_GREYED: TAlphaColor = $FF6E747B;
  { Milliseconds between attempts to open Steam while it fails. }
  RETRY_MS = 5000;
  { The identity rotation. }
  QUAT_IDENTITY: TPadQuat = (X: 0; Y: 0; Z: 0; W: 1);
  { Half a turn about X: the model's FACE to the camera, right way up
    (owner's screenshots 2026-10-31: unturned the back faced the camera
    upside down; half a turn about Y alone showed the face upside down). }
  QUAT_HALF_TURN_X: TPadQuat = (X: 1; Y: 0; Z: 0; W: 0);
  { Half a turn about Z: the model's BACK to the camera, right way up
    (View > Show back). }
  QUAT_HALF_TURN_Z: TPadQuat = (X: 0; Y: 0; Z: 1; W: 0);

function DataFolder: string;
begin
  // ExpandFileName: ParamStr(0) can be relative on POSIX (argv[0])
  Result := ExtractFilePath(ExpandFileName(ParamStr(0)));
{$IF DEFINED(MACOS) and not DEFINED(IOS)}
  // <bundle>/Contents/MacOS/<exe> -> <bundle>/Contents/Resources/
  Result := IncludeTrailingPathDelimiter(
    ExpandFileName(Result + '..' + PathDelim + 'Resources'));
{$ENDIF}
end;

{ Fixed-format number (invariant decimal point).
  @param(V The value.)
  @returns(Text such as +0.25.) }
function F2(V: Single): string;
begin
  Result := FormatFloat('+0.00;-0.00;0.00', V, TFormatSettings.Invariant);
end;

{ Readable name of a Steam Input controller type (every type of SDK 1.65).
  @param(T The type.)
  @returns(Name for the banner and the log.) }
function InputTypeName(T: ESteamInputType): string;
begin
  case T of
    k_ESteamInputType_Unknown:                  Result := 'unknown controller';
    k_ESteamInputType_SteamController:          Result := 'Steam Controller (2015)';
    k_ESteamInputType_XBox360Controller:        Result := 'Xbox 360 controller';
    k_ESteamInputType_XBoxOneController:        Result := 'Xbox One / Series controller';
    k_ESteamInputType_GenericGamepad:           Result := 'generic gamepad';
    k_ESteamInputType_PS4Controller:            Result := 'PS4 controller';
    k_ESteamInputType_AppleMFiController:       Result := 'Apple MFi controller';
    k_ESteamInputType_AndroidController:        Result := 'Android controller';
    k_ESteamInputType_SwitchJoyConPair:         Result := 'Joy-Con pair';
    k_ESteamInputType_SwitchJoyConSingle:       Result := 'single Joy-Con';
    k_ESteamInputType_SwitchProController:      Result := 'Switch Pro controller';
    k_ESteamInputType_MobileTouch:              Result := 'Remote Play touch controller';
    k_ESteamInputType_PS3Controller:            Result := 'PS3 controller';
    k_ESteamInputType_PS5Controller:            Result := 'PS5 DualSense controller';
    k_ESteamInputType_SteamDeckController:      Result := 'Steam Deck';
    k_ESteamInputType_SteamOSHandheld:          Result := 'SteamOS handheld';
    k_ESteamInputType_Switch2ProController:     Result := 'Switch 2 Pro controller';
    k_ESteamInputType_SteamController2026:      Result := 'Steam Controller (2026)';
    k_ESteamInputType_SteamFrameControllerPair: Result := 'Steam Frame controllers';
  else
    Result := 'controller type ' + IntToStr(Ord(T));
  end;
end;

{ The model file for a controller type (docs/SteamInputMapping.md,
  section 5 "Which picture or model for which pad"): PlayStation pads ->
  PS5, Steam Controllers and the Deck -> Steam Controller, everything else
  (Xbox, generic, Switch until its model exists) -> Xbox One.
  @param(T The type.)
  @returns(File name in @link(DataFolder).) }
function ModelFileFor(T: ESteamInputType): string;
begin
  case T of
    k_ESteamInputType_PS3Controller, k_ESteamInputType_PS4Controller,
    k_ESteamInputType_PS5Controller:
      Result := MODEL_PS;
    k_ESteamInputType_SteamController, k_ESteamInputType_SteamController2026,
    k_ESteamInputType_SteamDeckController:
      Result := MODEL_STEAM;
  else
    Result := MODEL_XBOX;
  end;
end;

{ The model clip of a button action. Positional, like our layouts: on
  every pad ButtonA is the BOTTOM face button - the PS5 model names its
  face clips after the PlayStation symbols (X_Press = Cross, the bottom
  one), the Xbox and Steam Controller models after the Xbox letters.
  @param(A The action.)
  @param(APlayStation The model uses the PlayStation clip names.)
  @returns(Clip name, or '' when the models have no clip for it.) }
function ButtonClip(A: TInputAction; APlayStation: Boolean): string;
begin
  case A of
    iaButtonA:         Result := IfThen(APlayStation, 'X_Press', 'A_Press');
    iaButtonB:         Result := IfThen(APlayStation, 'Circle_Press', 'B_Press');
    iaButtonX:         Result := IfThen(APlayStation, 'Square_Press', 'X_Press');
    iaButtonY:         Result := IfThen(APlayStation, 'Triangle_Press', 'Y_Press');
    iaLeftBumper:      Result := 'Shoulder_Left_Press';
    iaRightBumper:     Result := 'Shoulder_Right_Press';
    iaLeftStickClick:  Result := 'Stick_Left_Press';
    iaRightStickClick: Result := 'Stick_Right_Press';
    iaDPadUp:          Result := 'DPad_Up';
    iaDPadDown:        Result := 'DPad_Down';
    iaDPadLeft:        Result := 'DPad_Left';
    iaDPadRight:       Result := 'DPad_Right';
    iaStart:           Result := 'Menu_Press';
    iaSelect:          Result := 'View_Press';
    // back paddles: lower = L5 / R5 (button_back_left / _right), upper =
    // L4 / R4 - confirmed on the 2026 Steam Controller (CLAUDE.md)
    iaBackLeft:        Result := 'L5_Press';
    iaBackRight:       Result := 'R5_Press';
    iaBackLeftUpper:   Result := 'L4_Press';
    iaBackRightUpper:  Result := 'R4_Press';
  else
    Result := '';
  end;
end;

{ Quaternion product A * B (B applied first).
  @param(A Left factor.)
  @param(B Right factor.)
  @returns(The product.) }
function QuatMul(const A, B: TPadQuat): TPadQuat;
begin
  Result.W := A.W * B.W - A.X * B.X - A.Y * B.Y - A.Z * B.Z;
  Result.X := A.W * B.X + A.X * B.W + A.Y * B.Z - A.Z * B.Y;
  Result.Y := A.W * B.Y - A.X * B.Z + A.Y * B.W + A.Z * B.X;
  Result.Z := A.W * B.Z + A.X * B.Y - A.Y * B.X + A.Z * B.W;
end;

{ Conjugate (the inverse of a unit quaternion).
  @param(Q The quaternion.)
  @returns(Its conjugate.) }
function QuatConj(const Q: TPadQuat): TPadQuat;
begin
  Result.X := -Q.X;
  Result.Y := -Q.Y;
  Result.Z := -Q.Z;
  Result.W := Q.W;
end;

{ Scales Q to length 1 (identity when it is all zeros - no motion data).
  @param(Q The quaternion.)
  @returns(Unit quaternion.) }
function QuatNormalize(const Q: TPadQuat): TPadQuat;
var
  L: Single;
begin
  L := Sqrt(Q.X * Q.X + Q.Y * Q.Y + Q.Z * Q.Z + Q.W * Q.W);
  if L < 1E-6 then
    Exit(QUAT_IDENTITY);
  Result.X := Q.X / L;
  Result.Y := Q.Y / L;
  Result.Z := Q.Z / L;
  Result.W := Q.W / L;
end;

{ Rotation matrix of a unit quaternion for FMX's row-vector convention
  (v' = v * M), i.e. the transpose of the usual column-vector matrix.
  @param(Q Unit quaternion.)
  @returns(The matrix.) }
function QuatToMatrix(const Q: TPadQuat): TMatrix3D;
var
  XX, YY, ZZ, XY, XZ, YZ, WX, WY, WZ: Single;
begin
  XX := Q.X * Q.X; YY := Q.Y * Q.Y; ZZ := Q.Z * Q.Z;
  XY := Q.X * Q.Y; XZ := Q.X * Q.Z; YZ := Q.Y * Q.Z;
  WX := Q.W * Q.X; WY := Q.W * Q.Y; WZ := Q.W * Q.Z;
  Result := TMatrix3D.Identity;
  Result.m11 := 1 - 2 * (YY + ZZ);
  Result.m12 := 2 * (XY + WZ);
  Result.m13 := 2 * (XZ - WY);
  Result.m21 := 2 * (XY - WZ);
  Result.m22 := 1 - 2 * (XX + ZZ);
  Result.m23 := 2 * (YZ + WX);
  Result.m31 := 2 * (XZ + WY);
  Result.m32 := 2 * (YZ - WX);
  Result.m33 := 1 - 2 * (XX + YY);
end;

procedure TfrmGamepad.FormCreate(Sender: TObject);
var
  LogFileError: string;
begin
  LogFileError := '';
  FLogLines := TStringList.Create;
  // The log file FIRST, so a crash in anything below (the Linux menu swap
  // included) still leaves a line saying how far the start got - under
  // Steam's Linux runtimes the program died before the log was written
  // (owner's runs 2026-11-01), and stderr is all there was
  FLogFile := TPath.Combine(ExpandFileName(ExtractFilePath(ParamStr(0))), 'VirtualGamepad.log');
  try
    TFile.WriteAllText(FLogFile, '');
  except
    on E: Exception do
    begin
      // say why (in Steam's Linux runtime the game folder is not writable)
      LogFileError := FLogFile + ': ' + E.Message;
      FLogFile := '';
    end;
  end;
  AddLog('FormCreate started');
  // Which build runs on which system (native or Proton / Wine on SteamOS,
  // Rosetta 2 on macOS, Steam's Linux runtime container ...)
  Caption := Caption + ' - ' + TSteamLib.PlatformDescription;
  AddLog('Platform: ' + TSteamLib.PlatformDescription);
  if LogFileError <> '' then
    AddLog('Log file NOT written: ' + LogFileError);
  // Linux: FMX's menu bar instead of GTK's, which shows only first letters
  // (FmxLinuxMenu). Before anything else touches a menu item.
  ReplaceMainMenu(Self, MainMenu1);
  AddLog('Main menu ready (on Linux: replaced by FMX''s own menu bar)');
  // A form file cannot depend on the build configuration, so this is here:
{$IFDEF DEBUG}
  SteamAPI1.SetAppIdEnvironment := True;   // no steam_appid.txt needed
  SteamAPI1.RestartIfNecessary := False;   // never relaunch through Steam
{$ELSE}
  SteamAPI1.RestartIfNecessary := True;
{$ENDIF}
  // Large type for the banner (set here: a wrong font property name in the
  // form file would stop it loading)
  lblPadName.StyledSettings := lblPadName.StyledSettings - [TStyledSetting.Size, TStyledSetting.Style];
  lblPadName.TextSettings.Font.Size := 24;
  lblPadName.TextSettings.Font.Style := [TFontStyle.fsBold];
  // motion off at start (owner 2026-11-01): the overlay menu (long press
  // of Start) or View > Follow pad motion switches it on
  FFollowMotion := False;
  FLastMotion := QUAT_IDENTITY;
  ResetState;
  AddLog('Virtual Gamepad, AppID ' + IntToStr(SteamAPI1.AppID));
  if FLogFile <> '' then
    AddLog('Log file: ' + FLogFile)
  else
    AddLog('Log file could not be created; log is on screen only');
  CheckDeployment;
  try
    // no model until Steam reports a controller: an empty view means none
    CreateScene;
  except
    on E: Exception do
      AddLog('3D scene could not be created: ' + E.ClassName + ': ' + E.Message);
  end;
  try
    CreateOverlay;
  except
    on E: Exception do
      AddLog('Overlay menu could not be created: ' + E.ClassName + ': ' + E.Message);
  end;
  AddLog(Format('Hold Start for %d ms for the overlay menu (motion, remote logging, exit).',
    [LONG_PRESS_MS]));
  AddLog('Drag on the 3D view to orbit the camera. Steam is opened automatically; then '
    + 'connect a controller. Steam Input must be enabled for this game in the Steam client '
    + 'for Xbox / generic controllers.');
  // tmStart (enabled in the form, short interval) opens Steam once the
  // window is up, so the first log lines are visible before Steam starts
end;

procedure TfrmGamepad.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  AddLog(Format('FormClose: window closing (Steam running: %s)', [BoolToStr(SteamAPI1.IsRunning, True)]));
  FClosing := True;
  tmStart.Enabled := False;
  tmPoll.Enabled := False;
  SteamAPI1.Close;
  // a search still running ends within 2.5 s; its result is dropped
  FreeAndNil(FDiscovery);
  // last: the shutdown lines above are still sent (Stop waits briefly)
  FreeAndNil(FSender);
end;

destructor TfrmGamepad.Destroy;
begin
  FreeAndNil(FLogLines);
  inherited;
end;

procedure TfrmGamepad.AddLog(const S: string);
var
  Line: string;
begin
  Line := FormatDateTime('hh:nn:ss.zzz', Now) + '  ' + S;
{$IFDEF POSIX}
  // Every line on stderr too, FIRST and flushed: inside Steam's Linux
  // runtime the log file could not be written and the program crashed
  // (owner's runs 2026-11-01) - stderr is what the launch options capture
  WriteLn(ErrOutput, Line);
  Flush(ErrOutput);
{$ENDIF}
  if FLogLines <> nil then
  begin
    FLogLines.Add(Line);
    if FLogLines.Count > LOG_KEEP_LINES then
      FLogLines.Delete(0);
  end;
  if FSender <> nil then
    FSender.Send(Line);
  if FLogFile <> '' then
  try
    TFile.AppendAllText(FLogFile, Line + sLineBreak);
  except
    FLogFile := '';
  end;
end;

procedure TfrmGamepad.CheckDeployment;
var
  Dir, Missing: string;
  Layouts: TStringDynArray;
  I: Integer;
begin
  Dir := DataFolder;
  AddLog('Data folder: ' + Dir);
  Layouts := nil;
  if TDirectory.Exists(Dir) then
    Layouts := TDirectory.GetFiles(Dir, 'controller_*.vdf');
  Missing := '';
  if not TFile.Exists(Dir + MANIFEST_FILE) then
    Missing := Missing + ' ' + MANIFEST_FILE;
  for I := Low(MODEL_FILES) to High(MODEL_FILES) do
    if not TFile.Exists(Dir + MODEL_FILES[I]) then
      Missing := Missing + ' ' + MODEL_FILES[I];
  if (Missing = '') and (Length(Layouts) = EXPECTED_LAYOUTS) then
    AddLog(Format('Deployment OK: manifest, %d layouts, 3 models', [Length(Layouts)]))
  else
    AddLog(Format('Deployment INCOMPLETE: %d of %d layouts; missing:%s',
      [Length(Layouts), EXPECTED_LAYOUTS, IfThen(Missing = '', ' nothing else', Missing)]));
end;

procedure TfrmGamepad.CreateScene;
begin
  FViewport := TGorillaViewport.Create(Self);
  FViewport.Parent := Self;
  FViewport.Align := TAlignLayout.Client;
  FViewport.Color := $FF202428;
  FViewport.OnResize := ViewportResize;
  FViewport.OnMouseDown := ViewMouseDown;
  FViewport.OnMouseMove := ViewMouseMove;
  FViewport.OnMouseUp := ViewMouseUp;
  FViewport.OnMouseWheel := ViewMouseWheel;
  // The camera as in Sprite3D: its own orbit camera (the rig parents itself
  // to the viewport), not the design camera
  FViewport.UsingDesignCamera := False;
  FCamera := TSprite3DCamera.Create(FViewport);
  FViewport.Camera := FCamera;
  FCamera.FOV := 45;
  FZoom := 1;
  // The light rides on the camera: a child at its origin with no turn of
  // its own, so it lights whatever side of the model is in view (Sprite3D)
  FLight := TGorillaLight.Create(FViewport);
  FLight.Parent := FCamera;
  FLight.Position.Point := TPoint3D.Zero;
  FLight.RotationAngle.Point := TPoint3D.Zero;
  FLight.LightType := FMX.Types3D.TLightType.Point;
  // pivot: centres the model at the origin (Gorilla3D's sample)
  FPivot := TDummy.Create(FViewport);
  FPivot.Parent := FViewport;
  FAnimator := TGorillaParallelAnimator.Create(Self);
  AddLog('3D scene created: Gorilla3D viewport, Sprite3D orbit camera, point light, parallel animator');
end;

procedure TfrmGamepad.FitView;
begin
  if (FModel = nil) or (FCamera = nil) then
    Exit;
  try
    if FCamera.FitToBounds(FModel, VIEW_MARGIN) then
      FCamera.Distance := FCamera.Distance * FZoom;
  except
    on E: Exception do AddLog('Framing the model failed: ' + E.ClassName + ': ' + E.Message);
  end;
end;

procedure TfrmGamepad.ViewportResize(Sender: TObject);
begin
  FitView;
end;

procedure TfrmGamepad.ViewMouseDown(Sender: TObject; Button: TMouseButton; Shift: TShiftState;
  X, Y: Single);
begin
  // a Control-click counts as a right-click (one-button Mac), as in Sprite3D
  if (Button = TMouseButton.mbRight) or ((Button = TMouseButton.mbLeft) and (ssCtrl in Shift)) then
  begin
    FCamera.Azimuth := 0;
    FCamera.PolarAngle := 0;
    FZoom := 1;
    FitView;
  end
  else if Button = TMouseButton.mbLeft then
  begin
    FDragging := True;
    FDragLast := PointF(X, Y);
  end;
end;

procedure TfrmGamepad.ViewMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Single);
begin
  if not FDragging then
    Exit;
  // a button let go outside the view sends no mouse-up: the first move
  // without it ends the orbit (as in Sprite3D)
  if not (ssLeft in Shift) then
  begin
    FDragging := False;
    Exit;
  end;
  FCamera.Azimuth := FCamera.Azimuth - (X - FDragLast.X) * ORBIT_DEGREES_PER_PIXEL;
  FCamera.PolarAngle := FCamera.PolarAngle + (Y - FDragLast.Y) * ORBIT_DEGREES_PER_PIXEL;
  FDragLast := PointF(X, Y);
  // FitToBounds fits for the current angles only: refit after each turn
  FitView;
end;

procedure TfrmGamepad.ViewMouseUp(Sender: TObject; Button: TMouseButton; Shift: TShiftState;
  X, Y: Single);
begin
  if Button = TMouseButton.mbLeft then
    FDragging := False;
end;

procedure TfrmGamepad.ViewMouseWheel(Sender: TObject; Shift: TShiftState; WheelDelta: Integer;
  var Handled: Boolean);
begin
  Handled := True;
  // a notch is 120; rolling the wheel away brings the camera nearer
  FZoom := FZoom * Power(ZOOM_STEP, -WheelDelta / 120);
  FitView;
end;

procedure TfrmGamepad.RemoveModel;
begin
  if FModel <> nil then
  begin
    // the animator must not keep the freed model's joints
    if FAnimator <> nil then
      FAnimator.Model := nil;
    FModel.Parent := nil;
    FreeAndNil(FModel);
    AddLog('Model removed: ' + FModelFile);
  end;
  FModelFile := '';
  FTransformWritten := False;
  if FPivot <> nil then
    FPivot.Position.Point := TPoint3D.Zero;
end;

procedure TfrmGamepad.ShowModelFor(T: ESteamInputType);
var
  FileName, Path: string;
begin
  if FViewport = nil then
    Exit;
  FileName := ModelFileFor(T);
  if FileName = FModelFile then
    Exit;
  Path := ModelPath(FileName);
  RemoveModel;
  if Path = '' then
  begin
    AddLog('Model NOT FOUND: ' + FileName + ' is neither in ' + DataFolder
      + ' nor in the repository''s models folder (deployment - see the check at start)');
    Exit;
  end;
  if not SameFileName(ExtractFilePath(Path), DataFolder) then
    AddLog('Model ' + FileName + ' is not in the data folder - using the repository''s copy '
      + '(run from the IDE without the post-build copy; a deployed build needs it beside the program)');
  try
    // no animation caching: cached clips draw baked frames instead of the
    // joints the parallel animator moves
    FModel := TGorillaModel.LoadNewModelFromFile(FPivot, nil, Path, []);
    FModel.Parent := FPivot;
    FModelFile := FileName;
    AddLog('Model loaded: ' + Path);
    PlaceModel;
    // the animator extracts the clips, resets the model to its bind pose
    // and stops its own AnimationManager (both would move the same joints)
    FAnimator.Model := FModel;
    FPlayStation := FAnimator.FindClip('Circle_Press') <> nil;
    // the Xbox and Steam Controller models' stick clips are the other way
    // round from the PS5's on both axes (owner 2026-11-01)
    if FileName = MODEL_PS then
      FStickSign := -1
    else
      FStickSign := 1;
    ResetAnimState;
    AddLog(Format('Animator: %d clips, %d moving parts, %s clip names',
      [FAnimator.ClipCount, FAnimator.Joints.Count, IfThen(FPlayStation, 'PlayStation', 'Xbox / Steam')]));
    FHasMotionZero := False;   // the next motion data is the front view
    // no SetModelRotation here: the sample's setup stays untouched until
    // the pad reports motion (never on an Xbox pad) or Show back is used
    FLastMotion := QUAT_IDENTITY;
    FitView;
  except
    on E: Exception do
    begin
      FModel := nil;
      AddLog('Loading the model FAILED: ' + Path + ': ' + E.ClassName + ': ' + E.Message);
    end;
  end;
end;

procedure TfrmGamepad.PlaceModel;
var
  B: TBoundingBox;
  Size: Single;
begin
  // EXACTLY Gorilla3D's ParallelAnimation sample (its author's, shown
  // working with these models): normalise the size, turn the pad upright
  // and to the camera, centre it through the pivot
  B := FModel.GetAbsoluteBoundingBox;
  Size := Max(B.Width, Max(B.Height, B.Depth));
  FModelScale := 1;
  if Size > 0 then
    FModelScale := MODEL_SIZE / Size;
  FModel.Scale.Point := Point3D(FModelScale, FModelScale, FModelScale);
  FModel.RotationAngle.X := 180;
  B := FModel.GetAbsoluteBoundingBox;
  FPivot.Position.Point := -B.CenterPoint;
  AddLog(Format('Model placed: largest side %s -> scale %s, centre %s %s %s moved to the origin',
    [F2(Size), F2(FModelScale), F2(B.CenterPoint.X), F2(B.CenterPoint.Y), F2(B.CenterPoint.Z)]));
end;

procedure TfrmGamepad.SetModelRotation(const AQ: TPadQuat);
var
  Q: TPadQuat;
begin
  FLastMotion := AQ;
  if FModel = nil then
    Exit;
  // As imported, the model showed the camera its BACK, upside down (glTF:
  // Y up, face +Z; FMX: Y down, camera looking from -Z). The base turn
  // first, then the pad's rotation.
  if FShowBack then
    Q := QuatMul(AQ, QUAT_HALF_TURN_Z)
  else
    Q := QuatMul(AQ, QUAT_HALF_TURN_X);
  // scale, then rotate (FMX row vectors: v * S * R); the pivot keeps the
  // centring. With AQ = identity and the face shown this equals the
  // sample's Scale + RotationAngle.X := 180. NOT YET SEEN ON SCREEN with
  // the pivot (the gyro pads and Show back are the only callers).
  FModel.TransformMatrix := TMatrix3D.CreateScaling(Point3D(FModelScale, FModelScale, FModelScale))
    * QuatToMatrix(Q);
  if not FTransformWritten then
  begin
    FTransformWritten := True;
    AddLog('Model transform now set by the program (pad motion / Show back)');
  end;
end;

procedure TfrmGamepad.ApplyMotion(const M: InputMotionData_t);
var
  Q: TPadQuat;
begin
  Q.X := M.rotQuatX;
  Q.Y := M.rotQuatY;
  Q.Z := M.rotQuatZ;
  Q.W := M.rotQuatW;
  if (Q.X = 0) and (Q.Y = 0) and (Q.Z = 0) and ((Q.W = 0) or (Q.W = 1)) then
    Exit;   // no motion sensors (all zeros or the identity Steam reports then)
  if not FHasMotion then
  begin
    // real motion data: the overlay's motion item can be chosen now
    FHasMotion := True;
    UpdateOverlay;
  end;
  Q := QuatNormalize(Q);
  if FRecenter or not FHasMotionZero then
  begin
    FMotionZero := Q;
    FHasMotionZero := True;
    if FRecenter then
      AddLog(Format('Motion recentered at quat %s %s %s %s', [F2(Q.X), F2(Q.Y), F2(Q.Z), F2(Q.W)]));
    FRecenter := False;
  end;
  if FFollowMotion then
    // the turn since the front view (FMotionZero) was taken
    SetModelRotation(QuatMul(QuatConj(FMotionZero), Q));
end;

function TfrmGamepad.Input: TSteamInputPlugin;
begin
  Result := SteamInput1.Plugin;
  if (Result <> nil) and not Result.Started then
    Result := nil;
end;

function TfrmGamepad.ManifestPath: string;
var
  P: string;
begin
  // the data folder (post-build copy / deployment) ...
  P := DataFolder + MANIFEST_FILE;
  if not TFile.Exists(P) then
    // ... or the project's src folder when run from .\<platform>\<config>
    P := ExpandFileName(ExtractFilePath(ExpandFileName(ParamStr(0))) + '..' + PathDelim + '..'
      + PathDelim + 'src' + PathDelim + MANIFEST_FILE);
  if TFile.Exists(P) then
    Result := P
  else
    Result := '';
end;

function TfrmGamepad.ModelPath(const AFileName: string): string;
begin
  Result := DataFolder + AFileName;
  if TFile.Exists(Result) then
    Exit;
  // <repo>\demos\VirtualGamepad\<platform>\<config>\ -> <repo>\models\
  Result := ExpandFileName(ExtractFilePath(ExpandFileName(ParamStr(0))) + '..' + PathDelim + '..'
    + PathDelim + '..' + PathDelim + '..' + PathDelim + 'models' + PathDelim + AFileName);
  if not TFile.Exists(Result) then
    Result := '';
end;

procedure TfrmGamepad.ResetState;
var
  A: TInputAction;
  M: TMenuAction;
begin
  CloseOverlay;
  FSetHandle := 0;
  FMenuSetHandle := 0;
  for M := Low(TMenuAction) to High(TMenuAction) do
    FMenuHandles[M] := 0;
  for A := Low(TInputAction) to High(TInputAction) do
  begin
    FActionHandles[A] := 0;
    FPressed[A] := False;
  end;
  FStartDownAt := 0;
  FStartUsed := False;
  FHasMotion := False;
  UpdateOverlay;
  ResetAnimState;
  FResolved := False;
  FResolveWarned := False;
  FLastResolve := 0;
  FActive := 0;
  FControllerCount := 0;
  FConfigHandles := nil;
  FConfigTexts := nil;
  FPadKey := '';
  FChosenPad := 0;
  FMotionLogged := False;
  FPollErrors := 0;
end;

procedure TfrmGamepad.mnuLayoutClick(Sender: TObject);
var
  P: TSteamInputPlugin;
begin
  P := Input;
  if (P = nil) or (FActive = 0) then
  begin
    AddLog('View Controller Settings: no controller (Steam not running or no pad connected)');
    Exit;
  end;
  try
    if P.ShowBindingPanel(FActive) then
      AddLog('ShowBindingPanel: True - the Steam overlay shows the layout screen; the new '
        + 'layout arrives as OnSteamInputConfigurationLoaded')
    else
      AddLog('ShowBindingPanel: False (no Steam overlay in this process) - choose the layout '
        + 'in the Steam client: this game > Controller settings');
  except
    on E: Exception do AddLog('View Controller Settings failed: ' + E.Message);
  end;
end;

procedure TfrmGamepad.mnuExitClick(Sender: TObject);
begin
  Close;
end;

procedure TfrmGamepad.mnuRemoteLogClick(Sender: TObject);
begin
  if FSender <> nil then
    StopRemoteLog('File > Stop sending log')
  else
    StartRemoteLog('File > Send log to receiver');
end;

procedure TfrmGamepad.UpdateRemoteLogText;
begin
  if FSender <> nil then
    mnuRemoteLog.Text := 'Stop sending log'
  else
    mnuRemoteLog.Text := 'Send log to receiver...';
  UpdateOverlay;
end;

procedure TfrmGamepad.StopRemoteLog(const AWhy: string);
begin
  if FSender = nil then
    Exit;
  AddLog('[remote log] stopped by the user (' + AWhy + ')');
  FreeAndNil(FSender);
  UpdateRemoteLogText;
end;

// StartRemoteLog .. RemoteLogStatus: the same code as SteamInputDemo's
procedure TfrmGamepad.StartRemoteLog(const AWhy: string);
begin
  if FClosing then
    Exit;
  if FSender <> nil then
  begin
    AddLog('[remote log] ' + AWhy + ': already sending');
    Exit;
  end;
  if FRemoteBusy then
  begin
    AddLog('[remote log] ' + AWhy + ': already looking for a receiver');
    Exit;
  end;
  FRemoteBusy := True;
  // the previous search has delivered its result (FRemoteBusy was False)
  FreeAndNil(FDiscovery);
  AddLog('[remote log] ' + AWhy + ': looking for LogReceiver apps on the network (2.5 s)...');
  // in the background: the window and the controller poll keep running
  FDiscovery := TRemoteLogDiscovery.Create(2500, RemoteLogDiscovered);
  UpdateRemoteLogText;
end;

procedure TfrmGamepad.RemoteLogDiscovered(Sender: TObject; const AFound: TRemoteLogReceiverArray;
  const AError: string);
var
  I: Integer;
begin
  // FDiscovery is NOT freed here (it is the caller of this handler)
  FRemoteBusy := False;
  if FClosing then
    Exit;
  UpdateRemoteLogText;
  if FSender <> nil then
    Exit;
  if AError <> '' then
  begin
    AddLog('[remote log] could not search the network: ' + AError);
    Exit;
  end;
  if Length(AFound) = 0 then
  begin
    AddLog('[remote log] no LogReceiver answered within 2.5 s - start LogReceiver on a machine '
      + 'on this network, click OK there, then try again');
    Exit;
  end;
  for I := 0 to High(AFound) do
    AddLog(Format('[remote log] found %s at %s:%d', [AFound[I].Name, AFound[I].Host, AFound[I].Port]));
  if Length(AFound) > 1 then
    AddLog(Format('[remote log] %d receivers answered - using the first (%s); close the others '
      + 'to send elsewhere', [Length(AFound), AFound[0].Name]));
  ConnectRemoteLog(AFound[0].Host, AFound[0].Port);
end;

procedure TfrmGamepad.ConnectRemoteLog(const AHost: string; APort: Word);
var
  I: Integer;
begin
  FSender := TRemoteLogSender.Create;
  FSender.OnStatus := RemoteLogStatus;
  // the log so far first, so the receiver gets the whole run
  for I := 0 to FLogLines.Count - 1 do
    FSender.Send(FLogLines[I]);
  FSender.Start(AHost, APort, 'VirtualGamepad', TSteamLib.PlatformDescription);
  UpdateRemoteLogText;
  AddLog(Format('[remote log] sending to %s:%d - click Yes in LogReceiver', [AHost, APort]));
end;

procedure TfrmGamepad.RemoteLogStatus(Sender: TObject; const AText: string);
begin
  AddLog('[remote log] ' + AText);
  // refused / no answer: the sender has given up - offer to start again
  if (FSender <> nil) and not FSender.Active then
  begin
    FreeAndNil(FSender);
    UpdateRemoteLogText;
  end;
end;

procedure TfrmGamepad.mnuMotionClick(Sender: TObject);
begin
  SetFollowMotion(not FFollowMotion);
end;

procedure TfrmGamepad.SetFollowMotion(AOn: Boolean);
begin
  FFollowMotion := AOn;
  if AOn then
  begin
    mnuMotion.Text := 'Follow pad motion: on';
    // the pad's orientation NOW becomes the front view: the model does not
    // jump when motion is switched on
    FRecenter := True;
  end
  else
  begin
    mnuMotion.Text := 'Follow pad motion: off';
    SetModelRotation(QUAT_IDENTITY);
  end;
  AddLog('Follow pad motion: ' + BoolToStr(AOn, True));
  UpdateOverlay;
end;

procedure TfrmGamepad.CreateOverlay;
const
  ITEM_HEIGHT = 48;
  ITEM_GAP = 8;

  procedure StyleLabel(L: TLabel; ASize: Single; AColor: TAlphaColor);
  begin
    L.StyledSettings := L.StyledSettings - [TStyledSetting.Size, TStyledSetting.FontColor,
      TStyledSetting.Style];
    L.TextSettings.Font.Size := ASize;
    L.TextSettings.FontColor := AColor;
    L.TextSettings.HorzAlign := TTextAlign.Center;
    L.HitTest := False;
  end;

var
  I: TOverlayItem;
  L: TLabel;
begin
  // Align Contents: covers the whole window without moving anything else
  FOverlay := TRectangle.Create(Self);
  FOverlay.Parent := Self;
  FOverlay.Align := TAlignLayout.Contents;
  FOverlay.Fill.Color := $B0000000;
  FOverlay.Stroke.Kind := TBrushKind.None;
  FOverlay.HitTest := True;   // the view underneath gets no clicks
  FOverlay.Visible := False;
  FOverlayPanel := TRectangle.Create(Self);
  FOverlayPanel.Parent := FOverlay;
  FOverlayPanel.Align := TAlignLayout.Center;
  FOverlayPanel.Width := 600;
  // the height follows the items shown (UpdateOverlay)
  FOverlayPanel.Fill.Color := $FF2A2E33;
  FOverlayPanel.Stroke.Color := $FF5A6068;
  FOverlayPanel.XRadius := 10;
  FOverlayPanel.YRadius := 10;
  FOverlayPanel.Padding.Left := 16;
  FOverlayPanel.Padding.Top := 16;
  FOverlayPanel.Padding.Right := 16;
  FOverlayPanel.Padding.Bottom := 16;
  L := TLabel.Create(Self);
  L.Parent := FOverlayPanel;
  L.Align := TAlignLayout.Top;
  L.Height := 44;
  L.Text := 'Menu';
  StyleLabel(L, 24, OVERLAY_TEXT);
  L.TextSettings.Font.Style := [TFontStyle.fsBold];
  for I := Low(TOverlayItem) to High(TOverlayItem) do
  begin
    FOverlayItems[I] := TRectangle.Create(Self);
    FOverlayItems[I].Parent := FOverlayPanel;
    FOverlayItems[I].Align := TAlignLayout.Top;
    // Align Top stacks by position: below the title, in item order
    FOverlayItems[I].Position.Y := 100 + Ord(I) * 100;
    FOverlayItems[I].Height := ITEM_HEIGHT;
    FOverlayItems[I].Margins.Bottom := ITEM_GAP;
    FOverlayItems[I].Stroke.Kind := TBrushKind.None;
    FOverlayItems[I].XRadius := 6;
    FOverlayItems[I].YRadius := 6;
    FOverlayItems[I].Tag := Ord(I);
    FOverlayItems[I].OnClick := OverlayItemClick;
    FOverlayLabels[I] := TLabel.Create(Self);
    FOverlayLabels[I].Parent := FOverlayItems[I];
    FOverlayLabels[I].Align := TAlignLayout.Client;
    StyleLabel(FOverlayLabels[I], 20, OVERLAY_TEXT);
  end;
  L := TLabel.Create(Self);
  L.Parent := FOverlayPanel;
  L.Align := TAlignLayout.Bottom;
  L.Height := 32;
  L.Text := 'D-pad: move     A: choose     B: back';
  StyleLabel(L, 14, OVERLAY_GREYED);
  FOverlayHint := L;
  UpdateOverlay;
  AddLog('Overlay menu created (hidden)');
end;

function TfrmGamepad.OverlayItemEnabled(I: TOverlayItem): Boolean;
begin
  case I of
    oiController: Result := Length(FMenuPads) > 1;
    oiMotion:    Result := FHasMotion;
    oiRemoteLog: Result := not FRemoteBusy;
  else
    Result := True;
  end;
end;

function TfrmGamepad.PadRowText: string;
var
  P: TSteamInputPlugin;
  H: InputHandle_t;
  Name: string;
begin
  if (FMenuPadIndex < 0) or (FMenuPadIndex > High(FMenuPads)) then
    Exit('');
  H := FMenuPads[FMenuPadIndex];
  P := Input;
  if P <> nil then
    Name := InputTypeName(P.GetInputTypeForHandle(H))
  else
    Name := 'controller';
  // left / right arrows (U+25C0 / U+25B6) round the pad's name
  Result := #$25C0 + '   ' + Name + Format('  (%d of %d)', [FMenuPadIndex + 1, Length(FMenuPads)])
    + IfThen(H = FActive, ' - shown', '') + '   ' + #$25B6;
end;

procedure TfrmGamepad.CyclePad(ADelta: Integer);
var
  N: Integer;
begin
  N := Length(FMenuPads);
  if N < 2 then
    Exit;
  // wraps round however many pads there are
  FMenuPadIndex := ((FMenuPadIndex + ADelta) mod N + N) mod N;
  AddLog('Overlay menu: controller row now names ' + PadRowText);
  UpdateOverlay;
end;

procedure TfrmGamepad.UpdateOverlay;
const
  ITEM_HEIGHT = 48;
  ITEM_GAP = 8;
var
  I: TOverlayItem;
  T: string;
  Shown: Integer;
begin
  // FOverlayHint is made last: nil = the overlay is not (fully) there
  if FOverlayHint = nil then
    Exit;
  if not OverlayItemEnabled(FMenuItem) then
    FMenuItem := oiReturn;
  // the controller row only with more than one pad (hidden, not greyed)
  FOverlayItems[oiController].Visible := Length(FMenuPads) > 1;
  Shown := 0;
  for I := Low(TOverlayItem) to High(TOverlayItem) do
    if FOverlayItems[I].Visible then
      Inc(Shown);
  FOverlayPanel.Height := 16 + 44 + Shown * (ITEM_HEIGHT + ITEM_GAP) + 32 + 16;
  if FOverlayItems[oiController].Visible then
    FOverlayHint.Text := 'D-pad: move, ' + #$25C0 + ' ' + #$25B6 + ' controller     A: choose     B: back'
  else
    FOverlayHint.Text := 'D-pad: move     A: choose     B: back';
  for I := Low(TOverlayItem) to High(TOverlayItem) do
  begin
    case I of
      oiController: T := PadRowText;
      oiReturn: T := 'Return to App';
      oiMotion: T := IfThen(FFollowMotion, 'Disable Motion', 'Enable Motion');
      oiRemoteLog:
        if FSender <> nil then
          T := 'Stop Remote Logging'
        else if FRemoteBusy then
          T := 'Remote Logging: looking for a receiver...'
        else
          T := 'Start Remote Logging';
    else
      T := 'Exit';
    end;
    FOverlayLabels[I].Text := T;
    if OverlayItemEnabled(I) then
      FOverlayLabels[I].TextSettings.FontColor := OVERLAY_TEXT
    else
      FOverlayLabels[I].TextSettings.FontColor := OVERLAY_GREYED;
    if I = FMenuItem then
      FOverlayItems[I].Fill.Color := OVERLAY_SELECTED
    else
      FOverlayItems[I].Fill.Color := OVERLAY_ITEM;
  end;
end;

procedure TfrmGamepad.OpenOverlay;
var
  A: TInputAction;
  M: TMenuAction;
  P: TSteamInputPlugin;
  Unbound: string;
  I: Integer;
begin
  if FOverlay = nil then
    Exit;
  if FMenuSetHandle = 0 then
  begin
    AddLog('Long press of Start: the Menu action set is not loaded (handle 0) - no overlay menu');
    Exit;
  end;
  // the model's buttons and sticks back to rest: the InGame set is not
  // read while the overlay is shown
  for A := Low(TInputAction) to High(TInputAction) do
    FPressed[A] := False;
  ResetAnimState;
  // a Menu button already held now must be let go before it counts
  for M := Low(TMenuAction) to High(TMenuAction) do
    FMenuPressed[M] := True;
  // Does the layout Steam loaded bind the Menu set? (an older copy of our
  // layout has no MenuUp / MenuDown; a player's layout may have nothing)
  Unbound := '';
  P := Input;
  if P <> nil then
    for M := Low(TMenuAction) to High(TMenuAction) do
      if (FMenuHandles[M] = 0)
        or (Length(P.DigitalActionOrigins(FActive, FMenuSetHandle, FMenuHandles[M])) = 0) then
        Unbound := Unbound + ' ' + MenuActionNames[M];
  FMenuUsesInGame := Unbound <> '';
  // the controller row: every connected pad, starting at the one shown
  FMenuPads := nil;
  FMenuPadIndex := 0;
  if P <> nil then
    FMenuPads := P.ConnectedControllers;
  for I := 0 to High(FMenuPads) do
    if FMenuPads[I] = FActive then
      FMenuPadIndex := I;
  if FMenuUsesInGame then
    AddLog('The layout Steam loaded for this pad binds nothing to' + Unbound + ' in the '
      + MENU_SET_NAME + ' set (an older copy of the layout - ours binds them all since r4 - or '
      + 'a player layout): the overlay reads the D-pad, ButtonA and ButtonB of the '
      + SET_NAME + ' set instead');
  FMenuOpen := True;
  FMenuItem := oiReturn;
  UpdateOverlay;
  FOverlay.Visible := True;
  FOverlay.BringToFront;
  AddLog('Long press of Start: overlay menu open, action set '
    + IfThen(FMenuUsesInGame, SET_NAME, MENU_SET_NAME) + Format(' (D-pad up / down, A chooses, '
    + 'B back); %d controller(s) connected', [Length(FMenuPads)]));
end;

procedure TfrmGamepad.CloseOverlay;
var
  A: TInputAction;
begin
  if not FMenuOpen then
    Exit;
  FMenuOpen := False;
  FMenuPads := nil;
  if FOverlay <> nil then
    FOverlay.Visible := False;
  // buttons still held count as new presses in the InGame set (Start
  // cannot reopen the overlay before it is let go: FStartUsed)
  for A := Low(TInputAction) to High(TInputAction) do
    FPressed[A] := False;
  AddLog('Overlay menu closed: action set ' + SET_NAME + ' again');
end;

procedure TfrmGamepad.MoveOverlay(ADelta: Integer);
var
  I: Integer;
begin
  I := Ord(FMenuItem);
  repeat
    Inc(I, ADelta);
    if (I < Ord(Low(TOverlayItem))) or (I > Ord(High(TOverlayItem))) then
      Exit;   // at the end: stay
  until OverlayItemEnabled(TOverlayItem(I));
  FMenuItem := TOverlayItem(I);
  UpdateOverlay;
end;

procedure TfrmGamepad.ChooseOverlayItem;
var
  Item: TOverlayItem;
begin
  Item := FMenuItem;
  if not OverlayItemEnabled(Item) then
    Exit;
  AddLog('Overlay menu: ' + FOverlayLabels[Item].Text);
  // A on the controller row: show the pad it names (only then does the
  // shown controller change). Before CloseOverlay, which forgets the list.
  if (Item = oiController) and (FMenuPadIndex <= High(FMenuPads))
    and (FMenuPads[FMenuPadIndex] <> FActive) then
  begin
    FChosenPad := FMenuPads[FMenuPadIndex];
    AddLog('Overlay menu: switching to controller handle ' + UIntToStr(FChosenPad));
  end;
  // every choice closes the overlay (owner 2026-11-01)
  CloseOverlay;
  case Item of
    oiController, oiReturn:
      ;   // closing is all they do (the switch happens in RefreshControllers)
    oiMotion:
      SetFollowMotion(not FFollowMotion);
    oiRemoteLog:
      if FSender <> nil then
        StopRemoteLog('overlay menu')
      else
        StartRemoteLog('Overlay menu');
    oiExit:
      // after this poll: closing shuts Steam down, which must not happen
      // while the poll is still reading the pad
      TThread.ForceQueue(nil,
        procedure
        begin
          Close;
        end);
  end;
  UpdateOverlay;
end;

procedure TfrmGamepad.OverlayItemClick(Sender: TObject);
var
  I: TOverlayItem;
begin
  I := TOverlayItem(TComponent(Sender).Tag);
  if not OverlayItemEnabled(I) then
    Exit;
  FMenuItem := I;
  UpdateOverlay;
  ChooseOverlayItem;
end;

procedure TfrmGamepad.ReadMenuActions(P: TSteamInputPlugin);
var
  M: TMenuAction;
  D: InputDigitalActionData_t;
  H: UInt64;
begin
  for M := Low(TMenuAction) to High(TMenuAction) do
  begin
    if FMenuUsesInGame then
      H := FActionHandles[MenuFallback[M]]
    else
      H := FMenuHandles[M];
    if H = 0 then
      Continue;
    D := P.GetDigitalActionData(FActive, H);
    if D.bState = FMenuPressed[M] then
      Continue;
    FMenuPressed[M] := D.bState;
    if not D.bState then
      Continue;
    AddLog(IfThen(FMenuUsesInGame, ActionNames[MenuFallback[M]], MenuActionNames[M]) + ' pressed');
    case M of
      maUp:      MoveOverlay(-1);
      maDown:    MoveOverlay(1);
      // left / right only change the controller row (no switch until A)
      maLeft:    if FMenuItem = oiController then CyclePad(-1);
      maRight:   if FMenuItem = oiController then CyclePad(1);
      maConfirm: ChooseOverlayItem;
      maBack:    CloseOverlay;
    end;
    if not FMenuOpen then
      Break;   // closed: the InGame set is read from the next frame
  end;
  // motion data in the menu too: the motion item is enabled as soon as the
  // pad reports any
  ReadMotion(P);
end;

procedure TfrmGamepad.mnuShowBackClick(Sender: TObject);
begin
  FShowBack := not FShowBack;
  if FShowBack then
    mnuShowBack.Text := 'Show face'
  else
    mnuShowBack.Text := 'Show back';
  SetModelRotation(FLastMotion);
  FitView;
  AddLog('Model shows its ' + IfThen(FShowBack, 'back', 'face'));
end;

procedure TfrmGamepad.mnuRecenterClick(Sender: TObject);
begin
  FRecenter := True;
  AddLog('Recenter: the pad''s next orientation becomes the front view');
end;

procedure TfrmGamepad.tmStartTimer(Sender: TObject);
begin
  tmStart.Enabled := False;
  if FClosing or SteamAPI1.IsRunning then
    Exit;
  AddLog('Opening Steam');
  if SteamAPI1.Open then
    AddLog('Open returned True: Steam is running')
  else
    AddLog('Open returned False: Steam did not start');
end;

procedure TfrmGamepad.SteamLog(Sender: TObject; ALevel: TSteamLogLevel; const AMessage: string);
begin
  AddLog('[' + LevelNames[ALevel] + '] ' + AMessage);
end;

procedure TfrmGamepad.SteamInitialized(Sender: TObject);
var
  P: TSteamInputPlugin;
  Path: string;
begin
  AddLog('OnInitialized: Steam is running');
  ResetState;
  P := SteamInput1.Plugin;
  if P = nil then
  begin
    AddLog('ISteamInput plug-in is not active');
    Exit;
  end;
  try
    // Explicit RunFrame: the poll timer calls it on the UI thread right
    // before reading the actions, as a game loop would.
    if not P.Start(True) then
    begin
      AddLog('ISteamInput Init returned False');
      Exit;
    end;
    AddLog('ISteamInput started (Init(True): explicit RunFrame)');
    P.EnableDeviceCallbacks;
    Path := ManifestPath;
    if Path = '' then
      AddLog('Action manifest ' + MANIFEST_FILE + ' NOT FOUND: actions will stay unbound (handles 0)')
    else
      AddLog(Format('SetInputActionManifestFilePath(%s): %s',
        [Path, BoolToStr(P.SetInputActionManifestFilePath(Path), True)]));
    tmPoll.Enabled := True;
    AddLog(Format('Polling every %d ms', [tmPoll.Interval]));
  except
    on E: Exception do AddLog('Starting ISteamInput failed: ' + E.ClassName + ': ' + E.Message);
  end;
end;

procedure TfrmGamepad.SteamInitFailed(Sender: TObject; AResult: Integer; const AMessage: string);
begin
  AddLog(Format('OnInitFailed: result %d: %s', [AResult, AMessage]));
  if not FClosing then
  begin
    // try again later (Steam not running yet, or still starting)
    tmStart.Interval := RETRY_MS;
    tmStart.Enabled := True;
    AddLog(Format('Trying again in %d s', [RETRY_MS div 1000]));
  end;
end;

procedure TfrmGamepad.SteamShutdown(Sender: TObject);
begin
  tmPoll.Enabled := False;
  ResetState;
  RemoveModel;
  lblPadName.Text := 'Steam is not running - waiting for it';
  AddLog('OnShutdown: Steam shut down (ISteamInput was shut down first)');
  if not FClosing then
  begin
    // the Steam client exited (or failed): open again once it is back
    tmStart.Interval := RETRY_MS;
    tmStart.Enabled := True;
    AddLog(Format('Trying to open Steam again in %d s', [RETRY_MS div 1000]));
  end;
end;

procedure TfrmGamepad.SteamClientExit(Sender: TObject);
begin
  AddLog('OnSteamShutdown: the Steam client is exiting');
end;

procedure TfrmGamepad.InputConfigurationLoaded(Sender: TObject; const AData: SteamInputConfigurationLoaded_t);
var
  Text: string;
  I: Integer;
  Found: Boolean;
  A: TInputAction;
  M: TMenuAction;
begin
  AddLog(Format('OnSteamInputConfigurationLoaded: handle %s, mapping by %s, revision %d.%d, '
    + 'uses Steam Input API %s',
    [UIntToStr(AData.m_ulDeviceHandle), AData.m_ulMappingCreator.ToString,
     AData.m_unMajorRevision, AData.m_unMinorRevision, BoolToStr(AData.m_bUsesSteamInputAPI, True)]));
  // creator 0 = the game's own default layout (ours); anything else = a
  // player's layout or a Steam template; API False = Steam Input is off
  Text := Format('mapping by %s, revision %d.%d',
    [AData.m_ulMappingCreator.ToString, AData.m_unMajorRevision, AData.m_unMinorRevision]);
  if not AData.m_bUsesSteamInputAPI then
    Text := 'Steam Input is NOT active for this pad (' + Text + ') - turn Steam Input on for '
      + 'this controller / game in the Steam client'
  else if AData.m_ulMappingCreator.Value = 0 then
    Text := 'Steam loaded the game''s default layout (' + Text + ')'
  else
    Text := 'Steam loaded a DIFFERENT layout, not ours (' + Text
      + ') - choose the game''s default in File > View Controller Settings';
  Found := False;
  for I := 0 to High(FConfigHandles) do
    if FConfigHandles[I] = AData.m_ulDeviceHandle then
    begin
      FConfigTexts[I] := Text;
      Found := True;
    end;
  if not Found then
  begin
    SetLength(FConfigHandles, Length(FConfigHandles) + 1);
    SetLength(FConfigTexts, Length(FConfigTexts) + 1);
    FConfigHandles[High(FConfigHandles)] := AData.m_ulDeviceHandle;
    FConfigTexts[High(FConfigTexts)] := Text;
  end;
  // a new layout: look every handle up again
  FSetHandle := 0;
  FMenuSetHandle := 0;
  for A := Low(TInputAction) to High(TInputAction) do
    FActionHandles[A] := 0;
  for M := Low(TMenuAction) to High(TMenuAction) do
    FMenuHandles[M] := 0;
  FResolved := False;
  FLastResolve := 0;
end;

procedure TfrmGamepad.ResolveHandles(P: TSteamInputPlugin);
var
  A: TInputAction;
  M: TMenuAction;
  Missing: string;
begin
  FLastResolve := Now;
  Missing := '';
  if FSetHandle = 0 then
    FSetHandle := P.GetActionSetHandle(SET_NAME);
  if FSetHandle = 0 then
    Missing := ' ' + SET_NAME;
  for A := Low(TInputAction) to High(TInputAction) do
  begin
    if FActionHandles[A] = 0 then
      if ActionAnalog[A] then
        FActionHandles[A] := P.GetAnalogActionHandle(ActionNames[A])
      else
        FActionHandles[A] := P.GetDigitalActionHandle(ActionNames[A]);
    if FActionHandles[A] = 0 then
      Missing := Missing + ' ' + ActionNames[A];
  end;
  // the Menu set (overlay menu)
  if FMenuSetHandle = 0 then
    FMenuSetHandle := P.GetActionSetHandle(MENU_SET_NAME);
  if FMenuSetHandle = 0 then
    Missing := Missing + ' ' + MENU_SET_NAME;
  for M := Low(TMenuAction) to High(TMenuAction) do
  begin
    if FMenuHandles[M] = 0 then
      FMenuHandles[M] := P.GetDigitalActionHandle(MenuActionNames[M]);
    if FMenuHandles[M] = 0 then
      Missing := Missing + ' ' + MenuActionNames[M];
  end;
  FResolved := Missing = '';
  if FResolved then
  begin
    AddLog(Format('Handles resolved: set %s = %s and %d actions, set %s = %s and %d actions',
      [SET_NAME, UIntToStr(FSetHandle), Ord(High(TInputAction)) + 1,
       MENU_SET_NAME, UIntToStr(FMenuSetHandle), Ord(High(TMenuAction)) + 1]));
    FResolveWarned := False;
  end
  else if not FResolveWarned then
  begin
    AddLog('Handles still 0 for:' + Missing + ' - the manifest is not loaded yet (retrying every '
      + 'second; if it stays so, check the manifest path and that Steam Input is enabled for this game)');
    FResolveWarned := True;
  end;
end;

procedure TfrmGamepad.RefreshControllers(P: TSteamInputPlugin);
var
  List: TSteamInputHandleArray;
  First: InputHandle_t;
  A: TInputAction;
  I: Integer;
begin
  List := P.ConnectedControllers;
  if Length(List) <> FControllerCount then
  begin
    FControllerCount := Length(List);
    AddLog(Format('Connected controllers: %d', [FControllerCount]));
    // the overlay's controller row would be out of date
    CloseOverlay;
  end;
  // the pad chosen in the overlay while it is connected, else the first
  First := 0;
  for I := 0 to High(List) do
    if (FChosenPad <> 0) and (List[I] = FChosenPad) then
      First := FChosenPad;
  if (First = 0) and (Length(List) > 0) then
    First := List[0];
  if First = FActive then
    Exit;
  FActive := First;
  for A := Low(TInputAction) to High(TInputAction) do
    FPressed[A] := False;
  ResetAnimState;
  FMotionLogged := False;
  FHasMotionZero := False;
  // another pad: motion unknown until it reports some; the overlay closes
  FHasMotion := False;
  FStartDownAt := 0;
  FStartUsed := False;
  CloseOverlay;
  UpdateOverlay;
  if FActive = 0 then
    AddLog('No controller to show')
  else
    AddLog(Format('Showing %s (handle %s)', [InputTypeName(P.GetInputTypeForHandle(FActive)),
      UIntToStr(FActive)]));
end;

procedure TfrmGamepad.UpdatePadBanner(P: TSteamInputPlugin);
var
  T: ESteamInputType;
  PadName, Info, Loaded, Key: string;
  I, N: Integer;
  List: TSteamInputHandleArray;
begin
  if FActive = 0 then
    T := k_ESteamInputType_Unknown
  else
    T := P.GetInputTypeForHandle(FActive);
  Loaded := 'no layout loaded yet';
  for I := 0 to High(FConfigHandles) do
    if FConfigHandles[I] = FActive then
      Loaded := FConfigTexts[I];
  Key := Format('%s/%d/%d/%s', [UIntToStr(FActive), Ord(T), FControllerCount, Loaded]);
  if Key = FPadKey then
    Exit;
  FPadKey := Key;
  // the model follows the type (the type may be known only a few frames
  // after the pad appears); no controller -> no model (owner 2026-10-31:
  // a pad drawn while none is connected does not look like "No
  // controller")
  if FActive = 0 then
    RemoveModel
  else
    ShowModelFor(T);
  if FActive = 0 then
  begin
    PadName := 'No controller';
    Info := 'Connect one (Steam Input must be enabled for this game for Xbox / generic pads).';
  end
  else
  begin
    PadName := InputTypeName(T);
    if FControllerCount > 1 then
    begin
      List := P.ConnectedControllers;
      N := 0;
      for I := 0 to High(List) do
        if List[I] = FActive then
          N := I + 1;
      PadName := Format('%s   (%d of %d connected - hold Start to change)',
        [PadName, N, FControllerCount]);
    end;
    Info := Format('Steam type %d - model %s', [Ord(T), FModelFile]) + sLineBreak + Loaded;
  end;
  lblPadName.Text := PadName;
  if FActive <> 0 then
    AddLog('Controller identified: ' + PadName + ' - ' + StringReplace(Info, sLineBreak, ' - ', [rfReplaceAll]));
end;

procedure TfrmGamepad.ResetAnimState;
var
  A: TInputAction;
begin
  for A := Low(TInputAction) to High(TInputAction) do
  begin
    FAnimX[A] := 0;
    FAnimY[A] := 0;
  end;
  if (FAnimator <> nil) and (FAnimator.Model <> nil) then
    FAnimator.StopAll;
end;

procedure TfrmGamepad.AnimateButton(A: TInputAction; APressed: Boolean);
var
  Clip: string;
begin
  if (FAnimator = nil) or (FAnimator.Model = nil) then
    Exit;
  Clip := ButtonClip(A, FPlayStation);
  if Clip = '' then
    Exit;   // nothing on the model for it (trackpad clicks)
  // Press plays to the clip's peak and holds while the button is down;
  // Release plays back to rest. A clip the model lacks returns False
  // (the Xbox model has no back paddles) - nothing to do then.
  if APressed then
    FAnimator.Press(Clip)
  else
    FAnimator.Release(Clip);
end;

procedure TfrmGamepad.AnimateAnalog(A: TInputAction; X, Y: Single);
begin
  if (FAnimator = nil) or (FAnimator.Model = nil) then
    Exit;
  if (X = FAnimX[A]) and (Y = FAnimY[A]) then
    Exit;
  FAnimX[A] := X;
  FAnimY[A] := Y;
  // Signs as in Gorilla3D's ParallelAnimation sample, in the same view
  // (model turned half a turn about X): the stick clips tilt the knob
  // opposite to their names there, so both axes are negated - on the PS5
  // model only. The Xbox and Steam Controller models' clips are the other
  // way round on both axes (FStickSign; owner 2026-11-01: vertical, then
  // horizontal mirrored). Steam's y is positive for up.
  case A of
    iaLeftStick:
      begin
        FAnimator.SetAxis('Stick_Left_Left', 'Stick_Left_Right', FStickSign * X);
        FAnimator.SetAxis('Stick_Left_Down', 'Stick_Left_Up', FStickSign * Y);
      end;
    iaRightStick:
      begin
        FAnimator.SetAxis('Stick_Right_Left', 'Stick_Right_Right', FStickSign * X);
        FAnimator.SetAxis('Stick_Right_Down', 'Stick_Right_Up', FStickSign * Y);
      end;
    // analog 0..1 onto rest .. fully pulled (Soft is only ~59 % of Full)
    iaLeftTrigger:
      FAnimator.SetValue('Trigger_Left_Press_Full', X);
    iaRightTrigger:
      FAnimator.SetValue('Trigger_Right_Press_Full', X);
  end;
  // Gyro and the trackpads have no clips: the gyro turns the whole model
  // (ApplyMotion), the trackpads are not shown yet
end;

procedure TfrmGamepad.ReadActions(P: TSteamInputPlugin);
var
  A: TInputAction;
  D: InputDigitalActionData_t;
  An: InputAnalogActionData_t;
  OpenMenu: Boolean;
begin
  OpenMenu := False;
  for A := Low(TInputAction) to High(TInputAction) do
  begin
    if FActionHandles[A] = 0 then
      Continue;
    if ActionAnalog[A] then
    begin
      An := P.GetAnalogActionData(FActive, FActionHandles[A]);
      AnimateAnalog(A, An.x, An.y);
    end
    else
    begin
      D := P.GetDigitalActionData(FActive, FActionHandles[A]);
      if D.bState <> FPressed[A] then
      begin
        FPressed[A] := D.bState;
        AnimateButton(A, D.bState);
        AddLog(ActionNames[A] + IfThen(D.bState, ' pressed', ' released'));
      end;
      // a LONG press of Start opens the overlay menu (once per hold)
      if A = iaStart then
      begin
        if not D.bState then
        begin
          FStartDownAt := 0;
          FStartUsed := False;
        end
        else if not FStartUsed then
        begin
          if FStartDownAt = 0 then
            FStartDownAt := Now
          else if MilliSecondsBetween(Now, FStartDownAt) >= LONG_PRESS_MS then
          begin
            FStartUsed := True;
            OpenMenu := True;
          end;
        end;
      end;
    end;
  end;
  ReadMotion(P);
  if OpenMenu then
    OpenOverlay;
end;

procedure TfrmGamepad.ReadMotion(P: TSteamInputPlugin);
var
  M: InputMotionData_t;
begin
  M := P.GetMotionData(FActive);
  if not FMotionLogged and ((M.rotQuatX <> 0) or (M.rotQuatY <> 0) or (M.rotQuatZ <> 0)
    or ((M.rotQuatW <> 0) and (M.rotQuatW <> 1))) then
  begin
    FMotionLogged := True;
    AddLog(Format('First motion data: quat %s %s %s %s - the pad has motion sensors (Enable '
      + 'Motion in the overlay menu, or View > Follow pad motion; the orientation then is the '
      + 'front view, View > Recenter motion changes it)',
      [F2(M.rotQuatX), F2(M.rotQuatY), F2(M.rotQuatZ), F2(M.rotQuatW)]));
  end;
  ApplyMotion(M);
end;

procedure TfrmGamepad.tmPollTimer(Sender: TObject);
var
  P: TSteamInputPlugin;
begin
  if FPolling then
    Exit;
  FPolling := True;
  try
    try
      P := Input;
      if P = nil then
        Exit;
      P.RunFrame(False);             // explicit RunFrame (Start(True))
      RefreshControllers(P);
      UpdatePadBanner(P);
      if FActive <> 0 then
      begin
        if not FResolved and (MilliSecondsBetween(Now, FLastResolve) >= 1000) then
          ResolveHandles(P);
        // the overlay menu reads the Menu set, the 3D view the InGame set
        if FMenuOpen and not FMenuUsesInGame and (FMenuSetHandle <> 0) then
          P.ActivateActionSet(FActive, FMenuSetHandle)
        else if FSetHandle <> 0 then
          P.ActivateActionSet(FActive, FSetHandle);
        if FMenuOpen then
          ReadMenuActions(P)
        else
          ReadActions(P);
      end;
    except
      on E: Exception do
      begin
        Inc(FPollErrors);
        AddLog('Poll failed: ' + E.ClassName + ': ' + E.Message);
        if FPollErrors >= 3 then
        begin
          tmPoll.Enabled := False;
          AddLog('Polling stopped after 3 errors');
        end;
      end;
    end;
  finally
    FPolling := False;
  end;
end;

end.
