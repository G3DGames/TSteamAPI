  call :put "src\controllers\controller_switch_pro.vdf" "controllers\"
  call :put "src\controllers\controller_neptune.vdf" "controllers\"
  call :put "src\controllers\controller_steamcontroller_gordon.vdf" "controllers\"
  call :put "src\controllers\controller_triton.vdf" "controllers\"
  call :put "src\controllers\controller_switch2_pro.vdf" "controllers\"
  call :put "src\controllers\controller_switch_joycon_pair.vdf" "controllers\"
  call :put "src\controllers\controller_generic.vdf" "controllers\"
  call :put "..\..\models\XBoxOne_Animated.glb" "models\"
  call :put "..\..\models\PS5_Animated.glb" "models\"
  call :put "..\..\models\SteamController_Animated.glb" "models\"
)
if /i "%PLAT%"=="Win64" (
  call :put "..\..\redistributable_bin\win64\steam_api64.dll" ""
  call :put "src\steam_controllers.vdf" ""
  call :put "src\controllers\controller_xboxone.vdf" "controllers\"
  call :put "src\controllers\controller_xbox360.vdf" "controllers\"
  call :put "src\controllers\controller_ps5.vdf" "controllers\"
  call :put "src\controllers\controller_ps4.vdf" "controllers\"
  call :put "src\controllers\controller_switch_pro.vdf" "controllers\"
  call :put "src\controllers\controller_neptune.vdf" "controllers\"
  call :put "src\controllers\controller_steamcontroller_gordon.vdf" "controllers\"
  call :put "src\controllers\controller_triton.vdf" "controllers\"
  call :put "src\controllers\controller_switch2_pro.vdf" "controllers\"
