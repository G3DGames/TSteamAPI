program VirtualGamepad;

{ 3D gamepad visualiser for the Steamworks library (AppID 2275430): the
  model of the connected controller (models/*.glb) in Gorilla3D, animated
  by the real pad through Steam Input (whole model turned by the pad's
  motion sensors; moving its parts waits for Gorilla3D's parallel
  animator). Needs Gorilla3D 1.5.4 installed (its units come from the
  IDE's library path).
  The redistributable, the Steam Input files (src\*.vdf, generated by
  tools/gen_input_mapping.py) and the models (..\..\models\*.glb) are
  copied next to the executable by the post-build event (Windows) or
  deployed by the Deployment entries (Linux: beside the executable;
  macOS: library in Contents/MacOS, data in Contents/Resources). }

uses
  System.StartUpCopy,
  FMX.Forms,
  FmxLinuxGtkGlobal in 'src\FmxLinuxGtkGlobal.pas',
  FmxLinuxMenu in 'src\FmxLinuxMenu.pas',
  Sprite3DCamera in 'src\Sprite3DCamera.pas',
  Gorilla.Animation.Parallel in 'src\Gorilla.Animation.Parallel.pas',
  uMain in 'src\uMain.pas' {frmGamepad};

begin
{$IFDEF DEBUG}
  // Debug builds list leaked blocks when the program ends (Windows only).
  ReportMemoryLeaksOnShutdown := True;
{$ENDIF}
{$IFDEF POSIX}
  // Start-up markers on stderr (Linux / macOS only - a Windows GUI program
  // has no stderr): under Steam's Linux runtime the program died before
  // its form's OnCreate (owner's runs 2026-11-01), and stderr is what
  // Steam's launch options can capture (%command% > file 2>&1)
  WriteLn(ErrOutput, 'start-up: units initialised');
{$ENDIF}
  Application.Initialize;
{$IFDEF POSIX}
  WriteLn(ErrOutput, 'start-up: application initialised, creating the main form');
{$ENDIF}
  Application.CreateForm(TfrmGamepad, frmGamepad);
{$IFDEF POSIX}
  // FMX only QUEUES the form here; it is created inside Application.Run
  WriteLn(ErrOutput, 'start-up: Application.Run (FMX creates the queued forms now)');
{$ENDIF}
  Application.Run;
end.
