program VirtualGamepad;

{ 3D gamepad visualiser for the Steamworks library (AppID 2275430): the
  model of the connected controller (models/*.glb) in Gorilla3D, animated
  live by the real pad through Steam Input. SKELETON - the Gorilla3D
  viewport and Steam Input come next. The redistributable and the Steam
  Input files (src\*.vdf, generated by tools/gen_input_mapping.py) are
  copied next to the executable by the post-build event (Windows) or
  deployed by the Deployment entries (macOS / Linux). }

uses
  System.StartUpCopy,
  FMX.Forms,
  uMain in 'src\uMain.pas' {frmGamepad};

begin
{$IFDEF DEBUG}
  // Debug builds list leaked blocks when the program ends (Windows only).
  ReportMemoryLeaksOnShutdown := True;
{$ENDIF}
  Application.Initialize;
  Application.CreateForm(TfrmGamepad, frmGamepad);
  Application.Run;
end.
