// Steam Input action manifest of SteamInputDemo (AppID 2275430).
//
// The demo passes this file's absolute path to
// ISteamInput.SetInputActionManifestFilePath, which overrides the manifest
// Steam would otherwise take from the game's depots - for development only.
// A shipped game puts the manifest into its depot instead and sets "Action
// Manifest" on the partner site (Steam Input settings).
//
// Format: Valve's Action Manifest file = "configurations" (default
// controller layouts, one file per controller type, optional) + the
// In-Game Actions "actions" and "localization" sections.
// No default layouts are supplied: choose or create one in the binding
// panel (the demo's "Bindings..." button) the first time.
"Action Manifest"
{
	"configurations"
	{
	}
	"actions"
	{
		"InGame"
		{
			"title"	"#Set_InGame"
			"StickPadGyro"
			{
				"Move"
				{
					"title"	"#Action_Move"
					"input_mode"	"joystick_move"
				}
				"Camera"
				{
					"title"	"#Action_Camera"
					"input_mode"	"absolute_mouse"
				}
			}
			"AnalogTrigger"
			{
				"Throttle"	"#Action_Throttle"
			}
			"Button"
			{
				"Fire"	"#Action_Fire"
				"Jump"	"#Action_Jump"
				"Menu"	"#Action_Menu"
			}
		}
		"Menu"
		{
			"title"	"#Set_Menu"
			"Button"
			{
				"Select"	"#Action_Select"
				"Back"	"#Action_Back"
			}
		}
	}
	"localization"
	{
		"english"
		{
			"Set_InGame"	"In game"
			"Set_Menu"	"Menu"
			"Action_Move"	"Move"
			"Action_Camera"	"Camera"
			"Action_Throttle"	"Throttle"
			"Action_Fire"	"Fire"
			"Action_Jump"	"Jump"
			"Action_Menu"	"Open menu"
			"Action_Select"	"Select"
			"Action_Back"	"Back to game"
		}
	}
}
