@echo off
rem Generated by tools\gen_projects.py - do not edit (it is rewritten).
rem SteamConsole: copies every file a Windows build needs next to the .exe,
rem so the output folder is complete for a Steam depot.
rem   deploy.bat                 Win64 Release
rem   deploy.bat Win32 Debug     any platform / configuration
setlocal
set "PLAT=%~1"
if "%PLAT%"=="" set "PLAT=Win64"
set "CFG=%~2"
if "%CFG%"=="" set "CFG=Release"
cd /d "%~dp0"
set "OUT=%PLAT%\%CFG%"
if not exist "%OUT%\" (echo %OUT% does not exist - build %PLAT% %CFG% first & set ERR=1 & goto done)
set ERR=0
if /i "%PLAT%"=="Win32" (
  call :put "..\..\redistributable_bin\steam_api.dll"
)
if /i "%PLAT%"=="Win64" (
  call :put "..\..\redistributable_bin\win64\steam_api64.dll"
)
echo.
if "%ERR%"=="0" (echo Done: everything is in %OUT%) else (echo FAILED - see above)
:done
if "%~1"=="" pause
exit /b %ERR%

:put
if not exist %1 (echo MISSING %~1 & set ERR=1 & exit /b)
copy /Y %1 "%OUT%\" >nul && echo copied %~nx1 || (echo COULD NOT COPY %~1 & set ERR=1)
exit /b
