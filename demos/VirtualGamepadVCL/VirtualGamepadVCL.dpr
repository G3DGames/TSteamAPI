program VirtualGamepadVCL;

{ 3D gamepad visualiser for the Steamworks library with the VCL and Castle
  Game Engine (Windows; its own AppID - set on SteamAPI1 in src\uMain.dfm,
  the only place it is kept, shared with the FMX VirtualGamepad). The form
  is src\uMain.pas / .dfm; the model's clips are played by
  src\PadAnimator.pas (the same file as VirtualGamepadLCL's); the glow and
  the "in use" lines by src\PadParts.pas (generated by
  tools/gen_pad_parts.py) and src\PadActivity.pas, the same files in all
  three VirtualGamepad demos. Castle Game
  Engine's units come from the IDE's library path (its Delphi install,
  including src\compatibility\delphi-only\fcl-json for PadAnimator). The
  post-build event copies the Steam library, the Steam Input files
  (src\*.vdf, generated by tools/gen_input_mapping.py) and the models
  (..\..\models\*.glb) next to the executable. }

uses
  Vcl.Forms,
  PadAnimator in 'src\PadAnimator.pas',
  PadParts in 'src\PadParts.pas',
  PadActivity in 'src\PadActivity.pas',
  uMain in 'src\uMain.pas' {frmGamepadVCL};

{$R *.res}

begin
{$IFDEF DEBUG}
  // Debug builds list leaked blocks when the program ends (Windows memory manager)
  ReportMemoryLeaksOnShutdown := True;
{$ENDIF}
  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.CreateForm(TfrmGamepadVCL, frmGamepadVCL);
  Application.Run;
end.
