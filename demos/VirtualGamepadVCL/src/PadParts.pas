(* @abstract(Where each control's part sits on the gamepad models: the
  glow and the trackpad dot of VirtualGamepad, VirtualGamepadLCL and
  VirtualGamepadVCL.)

  GENERATED by tools/gen_pad_parts.py from models/*.glb - do not edit; run
  it again after a model is added or changed. The same file in all three
  demos (tools/project_check.py keeps the copies identical).

  Positions are in model space - glTF coordinates, Y up, the face
  towards +Z - the space the programs' model nodes use, so a sphere made
  a child of the model at a part's centre sits on that part. *)
unit PadParts;

{$IFDEF FPC}{$mode delphi}{$H+}{$ENDIF}

interface

type
  { A model this unit was made from. }
  TPadModel = record
    { File name (no folder). }
    FileName: string;
    { Its size in bytes when this unit was made (a different size: the
      file changed, run tools/gen_pad_parts.py again). }
    FileSize: Int64;
  end;

  { The part a clip moves: its joint and where the part sits at rest. }
  TPadPart = record
    { Model file the part belongs to. }
    Model: string;
    { The clip (glTF animation) that moves it. }
    Clip: string;
    { The joint (glTF node) carrying it. }
    Joint: string;
    { Which part it is: the joint's name, so clips moving one joint share
      one part (a stick and its click) - except the D-pad, whose arms are
      parts of their own (DPad/Up, DPad/Right, ...). }
    Key: string;
    { The clip of the control in the mirrored position (left / right
      swapped: Stick_Left_Up - Stick_Right_Up, L4_Press - R4_Press,
      Menu_Press - View_Press); '' on the centre line. The back and top
      views glow the mirrored part (owner 2026-11-05). }
    Mirror: string;
    { Centre x at rest, model space. }
    X: Single;
    { Centre y at rest, model space. }
    Y: Single;
    { Centre z at rest, model space. }
    Z: Single;
    { Distance from the centre to the part's farthest vertex. }
    Radius: Single;
  end;

  { A trackpad marked in a model (empty node Trackpad_Left, _Right or
    _Center): a touch at x, y (-1..1, y up) sits at O + x * U + y * V. }
  TPadTrackpad = record
    { Model file the trackpad belongs to. }
    Model: string;
    { Left, Right or Center. }
    Side: string;
    { Middle of the pad's surface: x. }
    OX: Single;
    { Middle of the pad's surface: y. }
    OY: Single;
    { Middle of the pad's surface: z. }
    OZ: Single;
    { Half-width vector, towards the pad's right edge: x. }
    UX: Single;
    { Half-width vector, towards the pad's right edge: y. }
    UY: Single;
    { Half-width vector, towards the pad's right edge: z. }
    UZ: Single;
    { Half-height vector, towards the pad's top edge: x. }
    VX: Single;
    { Half-height vector, towards the pad's top edge: y. }
    VY: Single;
    { Half-height vector, towards the pad's top edge: z. }
    VZ: Single;
    { Unit normal, out of the surface: x. }
    NX: Single;
    { Unit normal, out of the surface: y. }
    NY: Single;
    { Unit normal, out of the surface: z. }
    NZ: Single;
  end;

