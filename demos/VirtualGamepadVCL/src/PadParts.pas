  { The trackpads the models mark. }
  PAD_TRACKPADS: array[0..0] of TPadTrackpad = (
    (Model: ''; Side: ''; OX: 0; OY: 0; OZ: 0; UX: 0; UY: 0; UZ: 0; VX: 0; VY: 0; VZ: 0; NX: 0; NY: 0; NZ: 0));

{ Whether this unit knows a model file.
  @param(AFileName File name (no folder).)
  @param(ASize Its size in bytes (@link(PadFileSize)).)
  @returns(1 known, 0 unknown, -1 known but of another size - the file
    changed since this unit was made.) }
function PadModelCheck(const AFileName: string; ASize: Int64): Integer;

{ The part clip AClip of model AModel moves.
  @param(AModel Model file name.)
  @param(AClip Clip name.)
  @param(APart The part, when found.)
  @returns(@false when the model has no such clip here.) }
function FindPadPart(const AModel, AClip: string; out APart: TPadPart): Boolean;

{ The trackpad ASide of model AModel.
  @param(AModel Model file name.)
  @param(ASide Left, Right or Center.)
  @param(APad The trackpad, when the model marks it.)
  @returns(@false when the model does not mark that trackpad.) }
function FindPadTrackpad(const AModel, ASide: string; out APad: TPadTrackpad): Boolean;

{ Size of a file in bytes.
  @param(APath The file.)
  @returns(The size, or -1 when it cannot be opened.) }
function PadFileSize(const APath: string): Int64;

implementation

uses
  {$IFDEF FPC}SysUtils, Classes{$ELSE}System.SysUtils, System.Classes{$ENDIF};

function PadModelCheck(const AFileName: string; ASize: Int64): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to PAD_MODEL_COUNT - 1 do
    if SameText(PAD_MODELS[I].FileName, AFileName) then
    begin
      if PAD_MODELS[I].FileSize = ASize then
        Result := 1
      else
        Result := -1;
      Exit;
    end;
end;

function FindPadPart(const AModel, AClip: string; out APart: TPadPart): Boolean;
var
  I: Integer;
begin
  for I := 0 to PAD_PART_COUNT - 1 do
    if SameText(PAD_PARTS[I].Model, AModel) and SameText(PAD_PARTS[I].Clip, AClip) then
    begin
      APart := PAD_PARTS[I];
      Exit(True);
    end;
  Result := False;
end;

function FindPadTrackpad(const AModel, ASide: string; out APad: TPadTrackpad): Boolean;
var
  I: Integer;
begin
  for I := 0 to PAD_TRACKPAD_COUNT - 1 do
    if SameText(PAD_TRACKPADS[I].Model, AModel) and SameText(PAD_TRACKPADS[I].Side, ASide) then
    begin
      APad := PAD_TRACKPADS[I];
      Exit(True);
    end;
  Result := False;
end;

function PadFileSize(const APath: string): Int64;
var
  F: TFileStream;
begin
  try
    F := TFileStream.Create(APath, fmOpenRead or fmShareDenyNone);
    try
      Result := F.Size;
    finally
      F.Free;
    end;
  except
    Result := -1;
  end;
end;

end.
