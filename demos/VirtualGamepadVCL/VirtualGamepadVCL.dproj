<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{8379BDE6-EBDF-4376-B079-0F018E4392C0}</ProjectGuid>
        <ProjectVersion>20.5</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Application</AppType>
        <MainSource>VirtualGamepadVCL.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">VirtualGamepadVCL</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>VirtualGamepadVCL</SanitizedProjectName>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>src;..\..\RemoteLogging\src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>src;..\..\RemoteLogging\src;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_DcuOutput>.\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <PostBuildEvent><![CDATA[echo Steamworks post-build: $(Platform) $(Config), copying steam_api.dll to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\..\..\redistributable_bin\steam_api.dll" "$(OUTPUTDIR)" || (echo ERROR: could not copy steam_api.dll from redistributable_bin\ - if it is missing, copy redistributable_bin from the Steamworks SDK 1.65 into the repository root, then run tools\check_redist.py & exit /b 1)
echo Steamworks post-build: copying steam_controllers.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\steam_controllers.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy steam_controllers.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_xboxone.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_xboxone.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_xboxone.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_xbox360.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_xbox360.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_xbox360.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_ps5.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_ps5.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_ps5.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_ps4.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_ps4.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_ps4.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_switch_pro.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_switch_pro.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_switch_pro.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_neptune.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_neptune.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_neptune.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_steamcontroller_gordon.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_steamcontroller_gordon.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_steamcontroller_gordon.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_triton.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_triton.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_triton.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_switch2_pro.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_switch2_pro.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_switch2_pro.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_switch_joycon_pair.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_switch_joycon_pair.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_switch_joycon_pair.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying controller_generic.vdf to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\src\controller_generic.vdf" "$(OUTPUTDIR)" || (echo ERROR: could not copy controller_generic.vdf next to the executable & exit /b 1)
echo Steamworks post-build: copying XBoxOne_Animated.glb to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\..\..\models\XBoxOne_Animated.glb" "$(OUTPUTDIR)" || (echo ERROR: could not copy XBoxOne_Animated.glb next to the executable & exit /b 1)
echo Steamworks post-build: copying PS5_Animated.glb to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\..\..\models\PS5_Animated.glb" "$(OUTPUTDIR)" || (echo ERROR: could not copy PS5_Animated.glb next to the executable & exit /b 1)
echo Steamworks post-build: copying SteamController_Animated.glb to $(OUTPUTDIR)
copy /Y "$(PROJECTDIR)\..\..\models\SteamController_Animated.glb" "$(OUTPUTDIR)" || (echo ERROR: could not copy SteamController_Animated.glb next to the executable & exit /b 1)]]></PostBuildEvent>
        <PostBuildEventIgnoreExitCode>false</PostBuildEventIgnoreExitCode>
    </PropertyGroup>
