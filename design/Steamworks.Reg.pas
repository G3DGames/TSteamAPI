(* @abstract(Design-time registration of the generated plug-in components.)

  GENERATED by tools/gen_steam_api.py - do not edit. The components are
  framework-independent, so they are registered once, without a framework
  class group, and appear on the Steamworks palette page for FMX and VCL
  alike; each framework's TSteamAPI is registered by its own design
  package. *)
unit Steamworks.Reg;

{$I Steamworks.inc}

interface

{ Registers the plug-in components on the "Steamworks" palette page. }
procedure Register;

implementation

uses
  Classes, DesignIntf, DesignEditors, Steamworks.Components, Steamworks.Plugin.Utils, Steamworks.Plugin.User, Steamworks.Plugin.Friends, Steamworks.Plugin.Apps, Steamworks.Plugin.UserStats, Steamworks.Plugin.RemoteStorage, Steamworks.Plugin.Screenshots, Steamworks.Plugin.Timeline, Steamworks.Plugin.UGC, Steamworks.Plugin.Input, Steamworks.Plugin.Matchmaking, Steamworks.Plugin.Parties, Steamworks.Plugin.Music, Steamworks.Plugin.HTTP, Steamworks.Plugin.HTMLSurface, Steamworks.Plugin.Inventory, Steamworks.Plugin.Video, Steamworks.Plugin.ParentalSettings, Steamworks.Plugin.RemotePlay, Steamworks.Plugin.Networking, Steamworks.Plugin.NetworkingSockets, Steamworks.Plugin.NetworkingMessages, Steamworks.Plugin.NetworkingUtils, Steamworks.Plugin.MatchmakingServers, Steamworks.Plugin.GameServer, Steamworks.Plugin.GameServerStats;

// Palette icons: 24, 16 and 32 px bitmaps named <CLASS>, <CLASS>16 and
// <CLASS>32, built from design/icons by tools/gen_icon_res.py.
{$R Steamworks.Reg.dcr}

type
  // Adds the units the IDE-generated event handlers need (record and
  // callback types) to the form's uses clause.
  TSteamPluginSelectionEditor = class(TSelectionEditor)
  public
    procedure RequiresUnits(Proc: TGetStrProc); override;
  end;

procedure TSteamPluginSelectionEditor.RequiresUnits(Proc: TGetStrProc);
begin
  Proc('Steamworks.Types');
  Proc('Steamworks.SDKTypes');
  Proc('Steamworks.Callbacks');
  Proc('Steamworks.Components');
end;

procedure Register;
begin
  RegisterComponents('Steamworks', [TSteamUtils, TSteamUser, TSteamFriends, TSteamApps, TSteamUserStats, TSteamRemoteStorage, TSteamScreenshots, TSteamTimeline, TSteamUGC, TSteamInput, TSteamMatchmaking, TSteamParties, TSteamMusic, TSteamHTTP, TSteamHTMLSurface, TSteamInventory, TSteamVideo, TSteamParentalSettings, TSteamRemotePlay, TSteamNetworking, TSteamNetworkingSockets, TSteamNetworkingMessages, TSteamNetworkingUtils, TSteamMatchmakingServers, TSteamGameServer, TSteamGameServerStats, TSteamGameServerUtils, TSteamGameServerUGC, TSteamGameServerHTTP, TSteamGameServerInventory, TSteamGameServerNetworking, TSteamGameServerNetworkingSockets, TSteamGameServerNetworkingMessages]);
  RegisterSelectionEditor(TSteamPluginComponent, TSteamPluginSelectionEditor);
end;

end.
