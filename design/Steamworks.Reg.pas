(* @abstract(Design-time registration of the generated plug-in components.)

  GENERATED by tools/gen_steam_api.py - do not edit. The components are
  framework-independent, so they are registered once, without a framework
  class group, and appear on the Steamworks palette page for FMX and VCL
  alike; each framework's TSteamAPI is registered by its own design
  package. *)
unit Steamworks.Reg;

{$I Steamworks.inc}

interface

{ Registers the plug-in components on the "Steamworks" palette page. }
procedure Register;

implementation

uses
  Classes, DesignIntf, DesignEditors, Steamworks.Components, Steamworks.Plugin.Utils, Steamworks.Plugin.User, Steamworks.Plugin.Friends, Steamworks.Plugin.Apps, Steamworks.Plugin.UserStats;

type
  // Adds the units the IDE-generated event handlers need (record and
  // callback types) to the form's uses clause.
  TSteamPluginSelectionEditor = class(TSelectionEditor)
  public
    procedure RequiresUnits(Proc: TGetStrProc); override;
  end;

procedure TSteamPluginSelectionEditor.RequiresUnits(Proc: TGetStrProc);
begin
  Proc('Steamworks.Types');
  Proc('Steamworks.SDKTypes');
  Proc('Steamworks.Callbacks');
  Proc('Steamworks.Components');
end;

procedure Register;
begin
  RegisterComponents('Steamworks', [TSteamUtils, TSteamUser, TSteamFriends, TSteamApps, TSteamUserStats]);
  RegisterSelectionEditor(TSteamPluginComponent, TSteamPluginSelectionEditor);
end;

end.
