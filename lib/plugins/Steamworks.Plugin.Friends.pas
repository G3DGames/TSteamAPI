procedure TSteamFriends.DoAttach;
begin
  SubscribeCallback(PersonaStateChange_t_k_iCallback, HandlePersonaStateChange);
  SubscribeCallback(GameOverlayActivated_t_k_iCallback, HandleGameOverlayActivated);
  SubscribeCallback(GameServerChangeRequested_t_k_iCallback, HandleGameServerChangeRequested);
  SubscribeCallback(GameLobbyJoinRequested_t_k_iCallback, HandleGameLobbyJoinRequested);
  SubscribeCallback(AvatarImageLoaded_t_k_iCallback, HandleAvatarImageLoaded);
  SubscribeCallback(ClanOfficerListResponse_t_k_iCallback, HandleClanOfficerListResponse);
  SubscribeCallback(FriendRichPresenceUpdate_t_k_iCallback, HandleFriendRichPresenceUpdate);
  SubscribeCallback(GameRichPresenceJoinRequested_t_k_iCallback, HandleGameRichPresenceJoinRequested);
  SubscribeCallback(GameConnectedClanChatMsg_t_k_iCallback, HandleGameConnectedClanChatMsg);
  SubscribeCallback(GameConnectedChatJoin_t_k_iCallback, HandleGameConnectedChatJoin);
  SubscribeCallback(GameConnectedChatLeave_t_k_iCallback, HandleGameConnectedChatLeave);
  SubscribeCallback(DownloadClanActivityCountsResult_t_k_iCallback, HandleDownloadClanActivityCountsResult);
  SubscribeCallback(JoinClanChatRoomCompletionResult_t_k_iCallback, HandleJoinClanChatRoomCompletionResult);
  SubscribeCallback(GameConnectedFriendChatMsg_t_k_iCallback, HandleGameConnectedFriendChatMsg);
  SubscribeCallback(FriendsGetFollowerCount_t_k_iCallback, HandleFriendsGetFollowerCount);
  SubscribeCallback(FriendsIsFollowing_t_k_iCallback, HandleFriendsIsFollowing);
  SubscribeCallback(FriendsEnumerateFollowingList_t_k_iCallback, HandleFriendsEnumerateFollowingList);
  SubscribeCallback(UnreadChatMessagesChanged_t_k_iCallback, HandleUnreadChatMessagesChanged);
  SubscribeCallback(OverlayBrowserProtocolNavigation_t_k_iCallback, HandleOverlayBrowserProtocolNavigation);
  SubscribeCallback(EquippedProfileItemsChanged_t_k_iCallback, HandleEquippedProfileItemsChanged);
  SubscribeCallback(EquippedProfileItems_t_k_iCallback, HandleEquippedProfileItems);
end;

procedure TSteamFriends.HandlePersonaStateChange(const AData: TSteamCallbackData);
var
  Ev: PersonaStateChange_t;
begin
  if not Assigned(FOnPersonaStateChange) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'PersonaStateChange_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnPersonaStateChange(Self, Ev);
