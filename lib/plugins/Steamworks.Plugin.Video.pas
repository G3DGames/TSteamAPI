  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMVIDEO_INTERFACE_VERSION, 'SteamVideo');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamVideoFlat);
  Bind(FFlat.GetVideoURL, PFX + 'GetVideoURL', False);
  Bind(FFlat.IsBroadcasting, PFX + 'IsBroadcasting', False);
  Bind(FFlat.GetOPFSettings, PFX + 'GetOPFSettings', False);
  Bind(FFlat.GetOPFStringForApp, PFX + 'GetOPFStringForApp', False);
  Missing := '';
  if not Assigned(FFlat.GetVideoURL) then Missing := Missing + ' GetVideoURL';
  if not Assigned(FFlat.IsBroadcasting) then Missing := Missing + ' IsBroadcasting';
  if not Assigned(FFlat.GetOPFSettings) then Missing := Missing + ' GetOPFSettings';
  if not Assigned(FFlat.GetOPFStringForApp) then Missing := Missing + ' GetOPFStringForApp';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

