function TSteamInventory.GetPlugin: TSteamInventoryPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamInventoryPlugin(TSteamworks.Instance.FindPlugin(TSteamInventoryPlugin));
end;

procedure TSteamInventory.DoAttach;
begin
  SubscribeCallback(SteamInventoryResultReady_t_k_iCallback, HandleSteamInventoryResultReady);
  SubscribeCallback(SteamInventoryFullUpdate_t_k_iCallback, HandleSteamInventoryFullUpdate);
  SubscribeCallback(SteamInventoryDefinitionUpdate_t_k_iCallback, HandleSteamInventoryDefinitionUpdate);
  SubscribeCallback(SteamInventoryEligiblePromoItemDefIDs_t_k_iCallback, HandleSteamInventoryEligiblePromoItemDefIDs);
  SubscribeCallback(SteamInventoryStartPurchaseResult_t_k_iCallback, HandleSteamInventoryStartPurchaseResult);
  SubscribeCallback(SteamInventoryRequestPricesResult_t_k_iCallback, HandleSteamInventoryRequestPricesResult);
end;

procedure TSteamInventory.HandleSteamInventoryResultReady(const AData: TSteamCallbackData);
var
  Ev: SteamInventoryResultReady_t;
begin
  if not Assigned(FOnSteamInventoryResultReady) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamInventoryResultReady_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamInventoryResultReady(Self, Ev);
end;

