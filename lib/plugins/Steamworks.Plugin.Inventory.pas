class function TSteamInventoryPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMINVENTORY_INTERFACE_VERSION);
end;

function TSteamInventoryPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMINVENTORY_INTERFACE_VERSION, 'SteamInventory');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamInventoryFlat);
  Bind(FFlat.GetResultStatus, PFX + 'GetResultStatus', False);
  Bind(FFlat.GetResultItems, PFX + 'GetResultItems', False);
  Bind(FFlat.GetResultItemProperty, PFX + 'GetResultItemProperty', False);
  Bind(FFlat.GetResultTimestamp, PFX + 'GetResultTimestamp', False);
