  { ISteamInventory component: drop it next to a TSteamAPI (linked automatically at run time when
    the owner has exactly one, otherwise set SteamAPI). Its events are the ISteamInventory
    callbacks; call the interface through @link(Plugin). }
  TSteamInventory = class(TSteamPluginComponent)
  private
    { Backing field of @link(OnSteamInventoryResultReady). }
    FOnSteamInventoryResultReady: TSteamInventoryResultReadyEvent;
    { Backing field of @link(OnSteamInventoryFullUpdate). }
    FOnSteamInventoryFullUpdate: TSteamInventoryFullUpdateEvent;
    { Backing field of @link(OnSteamInventoryDefinitionUpdate). }
    FOnSteamInventoryDefinitionUpdate: TSteamInventoryDefinitionUpdateEvent;
    { Backing field of @link(OnSteamInventoryEligiblePromoItemDefIDs). }
    FOnSteamInventoryEligiblePromoItemDefIDs: TSteamInventoryEligiblePromoItemDefIDsEvent;
    { Backing field of @link(OnSteamInventoryStartPurchaseResult). }
    FOnSteamInventoryStartPurchaseResult: TSteamInventoryStartPurchaseResultEvent;
    { Backing field of @link(OnSteamInventoryRequestPricesResult). }
    FOnSteamInventoryRequestPricesResult: TSteamInventoryRequestPricesResultEvent;
    { Read accessor of @link(Plugin). }
    function GetPlugin: TSteamInventoryPlugin;
    { Raises @link(OnSteamInventoryResultReady) for SteamInventoryResultReady_t. }
    procedure HandleSteamInventoryResultReady(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInventoryFullUpdate) for SteamInventoryFullUpdate_t. }
    procedure HandleSteamInventoryFullUpdate(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInventoryDefinitionUpdate) for SteamInventoryDefinitionUpdate_t. }
    procedure HandleSteamInventoryDefinitionUpdate(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInventoryEligiblePromoItemDefIDs) for
      SteamInventoryEligiblePromoItemDefIDs_t. }
    procedure HandleSteamInventoryEligiblePromoItemDefIDs(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInventoryStartPurchaseResult) for SteamInventoryStartPurchaseResult_t. }
    procedure HandleSteamInventoryStartPurchaseResult(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInventoryRequestPricesResult) for SteamInventoryRequestPricesResult_t. }
    procedure HandleSteamInventoryRequestPricesResult(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamInventory plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamInventoryPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 4700 (SteamInventoryResultReady_t): SteamInventoryResultReady_t callbacks are fired
      whenever asynchronous results transition from "Pending" to "OK" or an error state. There
      will always be exactly one callback per handle. }
    property OnSteamInventoryResultReady: TSteamInventoryResultReadyEvent read FOnSteamInventoryResultReady write FOnSteamInventoryResultReady;
    { Callback 4701 (SteamInventoryFullUpdate_t): SteamInventoryFullUpdate_t callbacks are
      triggered when GetAllItems successfully returns a result which is newer / fresher than the
      last known result. (It will not trigger if the inventory hasn't changed, or if results from
      two overlapping calls are reversed in flight and the earlier result is already known to be
      stale/out-of-date.) The normal ResultReady callback will still be triggered immediately
      afterwards; this is an additional notification for your convenience. }
    property OnSteamInventoryFullUpdate: TSteamInventoryFullUpdateEvent read FOnSteamInventoryFullUpdate write FOnSteamInventoryFullUpdate;
    { Callback 4702 (SteamInventoryDefinitionUpdate_t): A SteamInventoryDefinitionUpdate_t
      callback is triggered whenever item definitions have been updated, which could be in
      response to LoadItemDefinitions() or any other async request which required a definition
      update in order to process results from the server. }
    property OnSteamInventoryDefinitionUpdate: TSteamInventoryDefinitionUpdateEvent read FOnSteamInventoryDefinitionUpdate write FOnSteamInventoryDefinitionUpdate;
    { Callback 4703 (SteamInventoryEligiblePromoItemDefIDs_t): Returned. }
    property OnSteamInventoryEligiblePromoItemDefIDs: TSteamInventoryEligiblePromoItemDefIDsEvent read FOnSteamInventoryEligiblePromoItemDefIDs write FOnSteamInventoryEligiblePromoItemDefIDs;
    { Callback 4704 (SteamInventoryStartPurchaseResult_t): Triggered from StartPurchase call. }
    property OnSteamInventoryStartPurchaseResult: TSteamInventoryStartPurchaseResultEvent read FOnSteamInventoryStartPurchaseResult write FOnSteamInventoryStartPurchaseResult;
    { Callback 4705 (SteamInventoryRequestPricesResult_t): Triggered from RequestPrices. }
    property OnSteamInventoryRequestPricesResult: TSteamInventoryRequestPricesResultEvent read FOnSteamInventoryRequestPricesResult write FOnSteamInventoryRequestPricesResult;
  end;

implementation

const
  PFX = 'SteamAPI_ISteamInventory_';

function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamInventoryPlugin }

class function TSteamInventoryPlugin.PluginName: string;
begin
  Result := 'ISteamInventory';
