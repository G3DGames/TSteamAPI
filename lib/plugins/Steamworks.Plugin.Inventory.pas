  Bind(FFlat.DestroyResult, PFX + 'DestroyResult', False);
  Bind(FFlat.GetAllItems, PFX + 'GetAllItems', False);
  Bind(FFlat.GetItemsByID, PFX + 'GetItemsByID', False);
  Bind(FFlat.SerializeResult, PFX + 'SerializeResult', False);
  Bind(FFlat.DeserializeResult, PFX + 'DeserializeResult', False);
  Bind(FFlat.GenerateItems, PFX + 'GenerateItems', False);
  Bind(FFlat.GrantPromoItems, PFX + 'GrantPromoItems', False);
  Bind(FFlat.AddPromoItem, PFX + 'AddPromoItem', False);
  Bind(FFlat.AddPromoItems, PFX + 'AddPromoItems', False);
  Bind(FFlat.ConsumeItem, PFX + 'ConsumeItem', False);
  Bind(FFlat.ExchangeItems, PFX + 'ExchangeItems', False);
  Bind(FFlat.TransferItemQuantity, PFX + 'TransferItemQuantity', False);
  Bind(FFlat.SendItemDropHeartbeat, PFX + 'SendItemDropHeartbeat', False);
  Bind(FFlat.TriggerItemDrop, PFX + 'TriggerItemDrop', False);
  Bind(FFlat.TradeItems, PFX + 'TradeItems', False);
  Bind(FFlat.LoadItemDefinitions, PFX + 'LoadItemDefinitions', False);
  Bind(FFlat.GetItemDefinitionIDs, PFX + 'GetItemDefinitionIDs', False);
  Bind(FFlat.GetItemDefinitionProperty, PFX + 'GetItemDefinitionProperty', False);
  Bind(FFlat.RequestEligiblePromoItemDefinitionsIDs, PFX + 'RequestEligiblePromoItemDefinitionsIDs', False);
  Bind(FFlat.GetEligiblePromoItemDefinitionIDs, PFX + 'GetEligiblePromoItemDefinitionIDs', False);
  Bind(FFlat.StartPurchase, PFX + 'StartPurchase', False);
  Bind(FFlat.RequestPrices, PFX + 'RequestPrices', False);
  Bind(FFlat.GetNumItemsWithPrices, PFX + 'GetNumItemsWithPrices', False);
  Bind(FFlat.GetItemsWithPrices, PFX + 'GetItemsWithPrices', False);
  Bind(FFlat.GetItemPrice, PFX + 'GetItemPrice', False);
  Bind(FFlat.StartUpdateProperties, PFX + 'StartUpdateProperties', False);
  Bind(FFlat.RemoveProperty, PFX + 'RemoveProperty', False);
  Bind(FFlat.SetPropertyString, PFX + 'SetPropertyString', False);
  Bind(FFlat.SetPropertyBool, PFX + 'SetPropertyBool', False);
  Bind(FFlat.SetPropertyInt64, PFX + 'SetPropertyInt64', False);
  Bind(FFlat.SetPropertyFloat, PFX + 'SetPropertyFloat', False);
  Bind(FFlat.SubmitUpdateProperties, PFX + 'SubmitUpdateProperties', False);
  Bind(FFlat.InspectItem, PFX + 'InspectItem', False);
  Missing := '';
  if not Assigned(FFlat.GetResultStatus) then Missing := Missing + ' GetResultStatus';
  if not Assigned(FFlat.GetResultItems) then Missing := Missing + ' GetResultItems';
  if not Assigned(FFlat.GetResultItemProperty) then Missing := Missing + ' GetResultItemProperty';
  if not Assigned(FFlat.GetResultTimestamp) then Missing := Missing + ' GetResultTimestamp';
  if not Assigned(FFlat.CheckResultSteamID) then Missing := Missing + ' CheckResultSteamID';
  if not Assigned(FFlat.DestroyResult) then Missing := Missing + ' DestroyResult';
  if not Assigned(FFlat.GetAllItems) then Missing := Missing + ' GetAllItems';
  if not Assigned(FFlat.GetItemsByID) then Missing := Missing + ' GetItemsByID';
  if not Assigned(FFlat.SerializeResult) then Missing := Missing + ' SerializeResult';
  if not Assigned(FFlat.DeserializeResult) then Missing := Missing + ' DeserializeResult';
  if not Assigned(FFlat.GenerateItems) then Missing := Missing + ' GenerateItems';
  if not Assigned(FFlat.GrantPromoItems) then Missing := Missing + ' GrantPromoItems';
  if not Assigned(FFlat.AddPromoItem) then Missing := Missing + ' AddPromoItem';
  if not Assigned(FFlat.AddPromoItems) then Missing := Missing + ' AddPromoItems';
  if not Assigned(FFlat.ConsumeItem) then Missing := Missing + ' ConsumeItem';
  if not Assigned(FFlat.ExchangeItems) then Missing := Missing + ' ExchangeItems';
  if not Assigned(FFlat.TransferItemQuantity) then Missing := Missing + ' TransferItemQuantity';
  if not Assigned(FFlat.SendItemDropHeartbeat) then Missing := Missing + ' SendItemDropHeartbeat';
  if not Assigned(FFlat.TriggerItemDrop) then Missing := Missing + ' TriggerItemDrop';
  if not Assigned(FFlat.TradeItems) then Missing := Missing + ' TradeItems';
  if not Assigned(FFlat.LoadItemDefinitions) then Missing := Missing + ' LoadItemDefinitions';
  if not Assigned(FFlat.GetItemDefinitionIDs) then Missing := Missing + ' GetItemDefinitionIDs';
  if not Assigned(FFlat.GetItemDefinitionProperty) then Missing := Missing + ' GetItemDefinitionProperty';
  if not Assigned(FFlat.RequestEligiblePromoItemDefinitionsIDs) then Missing := Missing + ' RequestEligiblePromoItemDefinitionsIDs';
  if not Assigned(FFlat.GetEligiblePromoItemDefinitionIDs) then Missing := Missing + ' GetEligiblePromoItemDefinitionIDs';
  if not Assigned(FFlat.StartPurchase) then Missing := Missing + ' StartPurchase';
  if not Assigned(FFlat.RequestPrices) then Missing := Missing + ' RequestPrices';
  if not Assigned(FFlat.GetNumItemsWithPrices) then Missing := Missing + ' GetNumItemsWithPrices';
  if not Assigned(FFlat.GetItemsWithPrices) then Missing := Missing + ' GetItemsWithPrices';
  if not Assigned(FFlat.GetItemPrice) then Missing := Missing + ' GetItemPrice';
  if not Assigned(FFlat.StartUpdateProperties) then Missing := Missing + ' StartUpdateProperties';
  if not Assigned(FFlat.RemoveProperty) then Missing := Missing + ' RemoveProperty';
  if not Assigned(FFlat.SetPropertyString) then Missing := Missing + ' SetPropertyString';
  if not Assigned(FFlat.SetPropertyBool) then Missing := Missing + ' SetPropertyBool';
  if not Assigned(FFlat.SetPropertyInt64) then Missing := Missing + ' SetPropertyInt64';
  if not Assigned(FFlat.SetPropertyFloat) then Missing := Missing + ' SetPropertyFloat';
  if not Assigned(FFlat.SubmitUpdateProperties) then Missing := Missing + ' SubmitUpdateProperties';
  if not Assigned(FFlat.InspectItem) then Missing := Missing + ' InspectItem';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamInventoryPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamInventoryFlat);
end;

procedure TSteamInventoryPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamInventory.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamInventory.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

