function TSteamInventoryPlugin.SubmitUpdateProperties(AHandle: SteamInventoryUpdateHandle_t; var pResultHandle: SteamInventoryResult_t): Boolean;
begin
  Need(Assigned(FFlat.SubmitUpdateProperties), 'SubmitUpdateProperties');
  Result := FFlat.SubmitUpdateProperties(FIntf, AHandle, @pResultHandle);
end;

function TSteamInventoryPlugin.InspectItem(var pResultHandle: SteamInventoryResult_t; const pchItemToken: string): Boolean;
var
  U_pchItemToken: UTF8String;
begin
  Need(Assigned(FFlat.InspectItem), 'InspectItem');
  U_pchItemToken := UTF8String(pchItemToken);
  Result := FFlat.InspectItem(FIntf, @pResultHandle, PAnsiChar(U_pchItemToken));
end;

