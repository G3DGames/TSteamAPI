function TSteamHTMLSurfacePlugin.CreateBrowser(const pchUserAgent: string; const pchUserCSS: string): SteamAPICall_t;
var
  U_pchUserAgent: UTF8String;
  U_pchUserCSS: UTF8String;
begin
  Need(Assigned(FFlat.CreateBrowser), 'CreateBrowser');
  U_pchUserAgent := UTF8String(pchUserAgent);
  U_pchUserCSS := UTF8String(pchUserCSS);
  Result := FFlat.CreateBrowser(FIntf, PAnsiChar(U_pchUserAgent), PAnsiChar(U_pchUserCSS));
end;

function TSteamHTMLSurfacePlugin.CreateBrowserAsync(const pchUserAgent: string; const pchUserCSS: string; AHandler: TSteamCallResultEvent): SteamAPICall_t;
begin
  Result := CreateBrowser(pchUserAgent, pchUserCSS);
  if Result <> k_uAPICallInvalid then
    Steam.Dispatcher.AwaitCallResult(Result, HTML_BrowserReady_t_k_iCallback, AHandler);
end;

