  if not Assigned(FFlat.SetHorizontalScroll) then Missing := Missing + ' SetHorizontalScroll';
  if not Assigned(FFlat.SetVerticalScroll) then Missing := Missing + ' SetVerticalScroll';
  if not Assigned(FFlat.SetKeyFocus) then Missing := Missing + ' SetKeyFocus';
  if not Assigned(FFlat.ViewSource) then Missing := Missing + ' ViewSource';
  if not Assigned(FFlat.CopyToClipboard) then Missing := Missing + ' CopyToClipboard';
  if not Assigned(FFlat.PasteFromClipboard) then Missing := Missing + ' PasteFromClipboard';
