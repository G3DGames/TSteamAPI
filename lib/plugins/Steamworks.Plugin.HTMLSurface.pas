procedure TSteamHTMLSurfacePlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamHTMLSurfaceFlat);
end;

procedure TSteamHTMLSurfacePlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamHTMLSurface.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamHTMLSurface.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

function TSteamHTMLSurfacePlugin.Init: Boolean;
begin
  Need(Assigned(FFlat.Init), 'Init');
  Result := FFlat.Init(FIntf);
end;

function TSteamHTMLSurfacePlugin.Shutdown: Boolean;
begin
  Need(Assigned(FFlat.Shutdown), 'Shutdown');
