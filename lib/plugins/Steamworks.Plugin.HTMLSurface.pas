  if not Assigned(FFlat.LoadURL) then Missing := Missing + ' LoadURL';
  if not Assigned(FFlat.SetSize) then Missing := Missing + ' SetSize';
  if not Assigned(FFlat.StopLoad) then Missing := Missing + ' StopLoad';
  if not Assigned(FFlat.Reload) then Missing := Missing + ' Reload';
  if not Assigned(FFlat.GoBack) then Missing := Missing + ' GoBack';
  if not Assigned(FFlat.GoForward) then Missing := Missing + ' GoForward';
