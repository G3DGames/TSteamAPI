function TSteamNetworkingUtils.GetPlugin: TSteamNetworkingUtilsPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamNetworkingUtilsPlugin(TSteamworks.Instance.FindPlugin(TSteamNetworkingUtilsPlugin));
end;

procedure TSteamNetworkingUtils.DoAttach;
begin
  SubscribeCallback(SteamRelayNetworkStatus_t_k_iCallback, HandleSteamRelayNetworkStatus);
end;

procedure TSteamNetworkingUtils.HandleSteamRelayNetworkStatus(const AData: TSteamCallbackData);
var
  Ev: SteamRelayNetworkStatus_t;
begin
  if not Assigned(FOnSteamRelayNetworkStatus) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamRelayNetworkStatus_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamRelayNetworkStatus(Self, Ev);
end;

initialization
  TSteamworks.RegisterPlugin(TSteamNetworkingUtilsPlugin);

finalization
  TSteamworks.UnregisterPlugin(TSteamNetworkingUtilsPlugin);

end.
