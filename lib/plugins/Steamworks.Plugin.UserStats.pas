  { ISteamUserStats component: drop it next to a TSteamAPI (linked automatically at run time when
    the owner has exactly one, otherwise set SteamAPI). Its events are the ISteamUserStats
    callbacks; call the interface through @link(Plugin). }
  TSteamUserStats = class(TSteamPluginComponent)
  private
    { Backing field of @link(OnUserStatsReceived). }
    FOnUserStatsReceived: TUserStatsReceivedEvent;
    { Backing field of @link(OnUserStatsStored). }
    FOnUserStatsStored: TUserStatsStoredEvent;
    { Backing field of @link(OnUserAchievementStored). }
    FOnUserAchievementStored: TUserAchievementStoredEvent;
    { Backing field of @link(OnLeaderboardFindResult). }
    FOnLeaderboardFindResult: TLeaderboardFindResultEvent;
    { Backing field of @link(OnLeaderboardScoresDownloaded). }
    FOnLeaderboardScoresDownloaded: TLeaderboardScoresDownloadedEvent;
    { Backing field of @link(OnLeaderboardScoreUploaded). }
    FOnLeaderboardScoreUploaded: TLeaderboardScoreUploadedEvent;
    { Backing field of @link(OnNumberOfCurrentPlayers). }
    FOnNumberOfCurrentPlayers: TNumberOfCurrentPlayersEvent;
    { Backing field of @link(OnUserStatsUnloaded). }
    FOnUserStatsUnloaded: TUserStatsUnloadedEvent;
    { Backing field of @link(OnUserAchievementIconFetched). }
    FOnUserAchievementIconFetched: TUserAchievementIconFetchedEvent;
    { Backing field of @link(OnGlobalAchievementPercentagesReady). }
    FOnGlobalAchievementPercentagesReady: TGlobalAchievementPercentagesReadyEvent;
    { Backing field of @link(OnLeaderboardUGCSet). }
    FOnLeaderboardUGCSet: TLeaderboardUGCSetEvent;
    { Backing field of @link(OnGlobalStatsReceived). }
    FOnGlobalStatsReceived: TGlobalStatsReceivedEvent;
    { Read accessor of @link(Plugin). }
    function GetPlugin: TSteamUserStatsPlugin;
    { Raises @link(OnUserStatsReceived) for UserStatsReceived_t. }
    procedure HandleUserStatsReceived(const AData: TSteamCallbackData);
    { Raises @link(OnUserStatsStored) for UserStatsStored_t. }
    procedure HandleUserStatsStored(const AData: TSteamCallbackData);
    { Raises @link(OnUserAchievementStored) for UserAchievementStored_t. }
    procedure HandleUserAchievementStored(const AData: TSteamCallbackData);
    { Raises @link(OnLeaderboardFindResult) for LeaderboardFindResult_t. }
    procedure HandleLeaderboardFindResult(const AData: TSteamCallbackData);
    { Raises @link(OnLeaderboardScoresDownloaded) for LeaderboardScoresDownloaded_t. }
    procedure HandleLeaderboardScoresDownloaded(const AData: TSteamCallbackData);
    { Raises @link(OnLeaderboardScoreUploaded) for LeaderboardScoreUploaded_t. }
    procedure HandleLeaderboardScoreUploaded(const AData: TSteamCallbackData);
    { Raises @link(OnNumberOfCurrentPlayers) for NumberOfCurrentPlayers_t. }
    procedure HandleNumberOfCurrentPlayers(const AData: TSteamCallbackData);
    { Raises @link(OnUserStatsUnloaded) for UserStatsUnloaded_t. }
    procedure HandleUserStatsUnloaded(const AData: TSteamCallbackData);
    { Raises @link(OnUserAchievementIconFetched) for UserAchievementIconFetched_t. }
    procedure HandleUserAchievementIconFetched(const AData: TSteamCallbackData);
    { Raises @link(OnGlobalAchievementPercentagesReady) for GlobalAchievementPercentagesReady_t. }
    procedure HandleGlobalAchievementPercentagesReady(const AData: TSteamCallbackData);
    { Raises @link(OnLeaderboardUGCSet) for LeaderboardUGCSet_t. }
    procedure HandleLeaderboardUGCSet(const AData: TSteamCallbackData);
    { Raises @link(OnGlobalStatsReceived) for GlobalStatsReceived_t. }
    procedure HandleGlobalStatsReceived(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamUserStats plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamUserStatsPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 1101 (UserStatsReceived_t): called when the latests stats and achievements have
      been received from the server. }
    property OnUserStatsReceived: TUserStatsReceivedEvent read FOnUserStatsReceived write FOnUserStatsReceived;
    { Callback 1102 (UserStatsStored_t): result of a request to store the user stats for a game. }
    property OnUserStatsStored: TUserStatsStoredEvent read FOnUserStatsStored write FOnUserStatsStored;
    { Callback 1103 (UserAchievementStored_t): result of a request to store the achievements for a
      game, or an "indicate progress" call. If both m_nCurProgress and m_nMaxProgress are zero,
      that means the achievement has been fully unlocked. }
    property OnUserAchievementStored: TUserAchievementStoredEvent read FOnUserAchievementStored write FOnUserAchievementStored;
    { Callback 1104 (LeaderboardFindResult_t): call result for finding a leaderboard, returned as
      a result of FindOrCreateLeaderboard() or FindLeaderboard() use CCallResult<> to map this
      async result to a member function. }
    property OnLeaderboardFindResult: TLeaderboardFindResultEvent read FOnLeaderboardFindResult write FOnLeaderboardFindResult;
    { Callback 1105 (LeaderboardScoresDownloaded_t): call result indicating scores for a
      leaderboard have been downloaded and are ready to be retrieved, returned as a result of
      DownloadLeaderboardEntries() use CCallResult<> to map this async result to a member
      function. }
    property OnLeaderboardScoresDownloaded: TLeaderboardScoresDownloadedEvent read FOnLeaderboardScoresDownloaded write FOnLeaderboardScoresDownloaded;
    { Callback 1106 (LeaderboardScoreUploaded_t): call result indicating scores has been uploaded,
      returned as a result of UploadLeaderboardScore() use CCallResult<> to map this async result
      to a member function. }
    property OnLeaderboardScoreUploaded: TLeaderboardScoreUploadedEvent read FOnLeaderboardScoreUploaded write FOnLeaderboardScoreUploaded;
    { Callback 1107 (NumberOfCurrentPlayers_t): see the SDK. }
    property OnNumberOfCurrentPlayers: TNumberOfCurrentPlayersEvent read FOnNumberOfCurrentPlayers write FOnNumberOfCurrentPlayers;
    { Callback 1108 (UserStatsUnloaded_t): Callback indicating that a user's stats have been
      unloaded. Call RequestUserStats again to access stats for this user. }
    property OnUserStatsUnloaded: TUserStatsUnloadedEvent read FOnUserStatsUnloaded write FOnUserStatsUnloaded;
    { Callback 1109 (UserAchievementIconFetched_t): Callback indicating that an achievement icon
      has been fetched. }
    property OnUserAchievementIconFetched: TUserAchievementIconFetchedEvent read FOnUserAchievementIconFetched write FOnUserAchievementIconFetched;
    { Callback 1110 (GlobalAchievementPercentagesReady_t): Callback indicating that global
      achievement percentages are fetched. }
    property OnGlobalAchievementPercentagesReady: TGlobalAchievementPercentagesReadyEvent read FOnGlobalAchievementPercentagesReady write FOnGlobalAchievementPercentagesReady;
    { Callback 1111 (LeaderboardUGCSet_t): call result indicating UGC has been uploaded, returned
      as a result of SetLeaderboardUGC(). }
    property OnLeaderboardUGCSet: TLeaderboardUGCSetEvent read FOnLeaderboardUGCSet write FOnLeaderboardUGCSet;
    { Callback 1112 (GlobalStatsReceived_t): callback indicating global stats have been received.
      Returned as a result of RequestGlobalStats(). }
    property OnGlobalStatsReceived: TGlobalStatsReceivedEvent read FOnGlobalStatsReceived write FOnGlobalStatsReceived;
  end;

