function TSteamUserStats.GetPlugin: TSteamUserStatsPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamUserStatsPlugin(TSteamworks.Instance.FindPlugin(TSteamUserStatsPlugin));
end;

procedure TSteamUserStats.DoAttach;
begin
  SubscribeCallback(UserStatsReceived_t_k_iCallback, HandleUserStatsReceived);
  SubscribeCallback(UserStatsStored_t_k_iCallback, HandleUserStatsStored);
  SubscribeCallback(UserAchievementStored_t_k_iCallback, HandleUserAchievementStored);
  SubscribeCallback(LeaderboardFindResult_t_k_iCallback, HandleLeaderboardFindResult);
  SubscribeCallback(LeaderboardScoresDownloaded_t_k_iCallback, HandleLeaderboardScoresDownloaded);
  SubscribeCallback(LeaderboardScoreUploaded_t_k_iCallback, HandleLeaderboardScoreUploaded);
  SubscribeCallback(NumberOfCurrentPlayers_t_k_iCallback, HandleNumberOfCurrentPlayers);
  SubscribeCallback(UserStatsUnloaded_t_k_iCallback, HandleUserStatsUnloaded);
  SubscribeCallback(UserAchievementIconFetched_t_k_iCallback, HandleUserAchievementIconFetched);
  SubscribeCallback(GlobalAchievementPercentagesReady_t_k_iCallback, HandleGlobalAchievementPercentagesReady);
  SubscribeCallback(LeaderboardUGCSet_t_k_iCallback, HandleLeaderboardUGCSet);
  SubscribeCallback(GlobalStatsReceived_t_k_iCallback, HandleGlobalStatsReceived);
end;

procedure TSteamUserStats.HandleUserStatsReceived(const AData: TSteamCallbackData);
var
  Ev: UserStatsReceived_t;
begin
  if not Assigned(FOnUserStatsReceived) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'UserStatsReceived_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnUserStatsReceived(Self, Ev);
end;

