function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamUserStatsPlugin }

class function TSteamUserStatsPlugin.PluginName: string;
begin
  Result := 'ISteamUserStats';
end;

class function TSteamUserStatsPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMUSERSTATS_INTERFACE_VERSION);
end;

