  if not Assigned(FFlat.RequestGlobalAchievementPercentages) then Missing := Missing + ' RequestGlobalAchievementPercentages';
  if not Assigned(FFlat.GetMostAchievedAchievementInfo) then Missing := Missing + ' GetMostAchievedAchievementInfo';
