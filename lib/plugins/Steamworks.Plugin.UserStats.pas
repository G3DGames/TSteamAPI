  if not Assigned(FFlat.GetAchievementProgressLimitsFloat) then Missing := Missing + ' GetAchievementProgressLimitsFloat';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamUserStatsPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamUserStatsFlat);
end;

procedure TSteamUserStatsPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamUserStats.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamUserStats.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

