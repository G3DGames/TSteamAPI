  if not Assigned(FFlat.GetDlcDownloadProgress) then Missing := Missing + ' GetDlcDownloadProgress';
  if not Assigned(FFlat.GetAppBuildId) then Missing := Missing + ' GetAppBuildId';
  if not Assigned(FFlat.RequestAllProofOfPurchaseKeys) then Missing := Missing + ' RequestAllProofOfPurchaseKeys';
  if not Assigned(FFlat.GetFileDetails) then Missing := Missing + ' GetFileDetails';
  if not Assigned(FFlat.GetLaunchCommandLine) then Missing := Missing + ' GetLaunchCommandLine';
  if not Assigned(FFlat.BIsSubscribedFromFamilySharing) then Missing := Missing + ' BIsSubscribedFromFamilySharing';
  if not Assigned(FFlat.BIsTimedTrial) then Missing := Missing + ' BIsTimedTrial';
  if not Assigned(FFlat.SetDlcContext) then Missing := Missing + ' SetDlcContext';
  if not Assigned(FFlat.GetNumBetas) then Missing := Missing + ' GetNumBetas';
  if not Assigned(FFlat.GetBetaInfo) then Missing := Missing + ' GetBetaInfo';
  if not Assigned(FFlat.SetActiveBeta) then Missing := Missing + ' SetActiveBeta';
  if not Assigned(FFlat.SetGamePerformanceSetting) then Missing := Missing + ' SetGamePerformanceSetting';
  if not Assigned(FFlat.SetGameRenderResolution) then Missing := Missing + ' SetGameRenderResolution';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamAppsPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamAppsFlat);
end;

procedure TSteamAppsPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamApps.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamApps.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

