function TSteamApps.GetPlugin: TSteamAppsPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamAppsPlugin(TSteamworks.Instance.FindPlugin(TSteamAppsPlugin));
end;

procedure TSteamApps.DoAttach;
begin
  SubscribeCallback(DlcInstalled_t_k_iCallback, HandleDlcInstalled);
  SubscribeCallback(NewUrlLaunchParameters_t_k_iCallback, HandleNewUrlLaunchParameters);
  SubscribeCallback(AppProofOfPurchaseKeyResponse_t_k_iCallback, HandleAppProofOfPurchaseKeyResponse);
  SubscribeCallback(FileDetailsResult_t_k_iCallback, HandleFileDetailsResult);
  SubscribeCallback(TimedTrialStatus_t_k_iCallback, HandleTimedTrialStatus);
end;

procedure TSteamApps.HandleDlcInstalled(const AData: TSteamCallbackData);
var
  Ev: DlcInstalled_t;
begin
  if not Assigned(FOnDlcInstalled) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'DlcInstalled_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnDlcInstalled(Self, Ev);
end;

