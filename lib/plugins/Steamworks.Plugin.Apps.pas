function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamAppsPlugin }

class function TSteamAppsPlugin.PluginName: string;
begin
  Result := 'ISteamApps';
end;

class function TSteamAppsPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMAPPS_INTERFACE_VERSION);
end;

