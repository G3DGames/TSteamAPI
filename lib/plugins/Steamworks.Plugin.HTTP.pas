procedure TSteamHTTPPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamHTTPFlat);
end;

procedure TSteamHTTPPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamHTTP.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamHTTP.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

function TSteamHTTPPlugin.CreateHTTPRequest(eHTTPRequestMethod: EHTTPMethod; const pchAbsoluteURL: string): HTTPRequestHandle;
var
  U_pchAbsoluteURL: UTF8String;
begin
  Need(Assigned(FFlat.CreateHTTPRequest), 'CreateHTTPRequest');
  U_pchAbsoluteURL := UTF8String(pchAbsoluteURL);
  Result := FFlat.CreateHTTPRequest(FIntf, eHTTPRequestMethod, PAnsiChar(U_pchAbsoluteURL));
end;

function TSteamHTTPPlugin.SetHTTPRequestContextValue(hRequest: HTTPRequestHandle; ulContextValue: UInt64): Boolean;
begin
  Need(Assigned(FFlat.SetHTTPRequestContextValue), 'SetHTTPRequestContextValue');
  Result := FFlat.SetHTTPRequestContextValue(FIntf, hRequest, ulContextValue);
end;

function TSteamHTTPPlugin.SetHTTPRequestNetworkActivityTimeout(hRequest: HTTPRequestHandle; unTimeoutSeconds: UInt32): Boolean;
begin
  Need(Assigned(FFlat.SetHTTPRequestNetworkActivityTimeout), 'SetHTTPRequestNetworkActivityTimeout');
  Result := FFlat.SetHTTPRequestNetworkActivityTimeout(FIntf, hRequest, unTimeoutSeconds);
end;

function TSteamHTTPPlugin.SetHTTPRequestHeaderValue(hRequest: HTTPRequestHandle; const pchHeaderName: string; const pchHeaderValue: string): Boolean;
var
  U_pchHeaderName: UTF8String;
  U_pchHeaderValue: UTF8String;
begin
  Need(Assigned(FFlat.SetHTTPRequestHeaderValue), 'SetHTTPRequestHeaderValue');
  U_pchHeaderName := UTF8String(pchHeaderName);
  U_pchHeaderValue := UTF8String(pchHeaderValue);
  Result := FFlat.SetHTTPRequestHeaderValue(FIntf, hRequest, PAnsiChar(U_pchHeaderName), PAnsiChar(U_pchHeaderValue));
end;

