function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamHTTPPlugin }

class function TSteamHTTPPlugin.PluginName: string;
begin
  Result := 'ISteamHTTP';
end;

class function TSteamHTTPPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMHTTP_INTERFACE_VERSION);
end;

function TSteamHTTPPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMHTTP_INTERFACE_VERSION, 'SteamHTTP');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamHTTPFlat);
  Bind(FFlat.CreateHTTPRequest, PFX + 'CreateHTTPRequest', False);
  Bind(FFlat.SetHTTPRequestContextValue, PFX + 'SetHTTPRequestContextValue', False);
  Bind(FFlat.SetHTTPRequestNetworkActivityTimeout, PFX + 'SetHTTPRequestNetworkActivityTimeout', False);
  Bind(FFlat.SetHTTPRequestHeaderValue, PFX + 'SetHTTPRequestHeaderValue', False);
  Bind(FFlat.SetHTTPRequestGetOrPostParameter, PFX + 'SetHTTPRequestGetOrPostParameter', False);
  Bind(FFlat.SendHTTPRequest, PFX + 'SendHTTPRequest', False);
  Bind(FFlat.SendHTTPRequestAndStreamResponse, PFX + 'SendHTTPRequestAndStreamResponse', False);
  Bind(FFlat.DeferHTTPRequest, PFX + 'DeferHTTPRequest', False);
  Bind(FFlat.PrioritizeHTTPRequest, PFX + 'PrioritizeHTTPRequest', False);
  Bind(FFlat.GetHTTPResponseHeaderSize, PFX + 'GetHTTPResponseHeaderSize', False);
  Bind(FFlat.GetHTTPResponseHeaderValue, PFX + 'GetHTTPResponseHeaderValue', False);
  Bind(FFlat.GetHTTPResponseBodySize, PFX + 'GetHTTPResponseBodySize', False);
  Bind(FFlat.GetHTTPResponseBodyData, PFX + 'GetHTTPResponseBodyData', False);
  Bind(FFlat.GetHTTPStreamingResponseBodyData, PFX + 'GetHTTPStreamingResponseBodyData', False);
  Bind(FFlat.ReleaseHTTPRequest, PFX + 'ReleaseHTTPRequest', False);
  Bind(FFlat.GetHTTPDownloadProgressPct, PFX + 'GetHTTPDownloadProgressPct', False);
  Bind(FFlat.SetHTTPRequestRawPostBody, PFX + 'SetHTTPRequestRawPostBody', False);
  Bind(FFlat.CreateCookieContainer, PFX + 'CreateCookieContainer', False);
  Bind(FFlat.ReleaseCookieContainer, PFX + 'ReleaseCookieContainer', False);
  Bind(FFlat.SetCookie, PFX + 'SetCookie', False);
  Bind(FFlat.SetHTTPRequestCookieContainer, PFX + 'SetHTTPRequestCookieContainer', False);
  Bind(FFlat.SetHTTPRequestUserAgentInfo, PFX + 'SetHTTPRequestUserAgentInfo', False);
  Bind(FFlat.SetHTTPRequestRequiresVerifiedCertificate, PFX + 'SetHTTPRequestRequiresVerifiedCertificate', False);
  Bind(FFlat.SetHTTPRequestAbsoluteTimeoutMS, PFX + 'SetHTTPRequestAbsoluteTimeoutMS', False);
  Bind(FFlat.GetHTTPRequestWasTimedOut, PFX + 'GetHTTPRequestWasTimedOut', False);
  Missing := '';
  if not Assigned(FFlat.CreateHTTPRequest) then Missing := Missing + ' CreateHTTPRequest';
  if not Assigned(FFlat.SetHTTPRequestContextValue) then Missing := Missing + ' SetHTTPRequestContextValue';
  if not Assigned(FFlat.SetHTTPRequestNetworkActivityTimeout) then Missing := Missing + ' SetHTTPRequestNetworkActivityTimeout';
  if not Assigned(FFlat.SetHTTPRequestHeaderValue) then Missing := Missing + ' SetHTTPRequestHeaderValue';
  if not Assigned(FFlat.SetHTTPRequestGetOrPostParameter) then Missing := Missing + ' SetHTTPRequestGetOrPostParameter';
  if not Assigned(FFlat.SendHTTPRequest) then Missing := Missing + ' SendHTTPRequest';
  if not Assigned(FFlat.SendHTTPRequestAndStreamResponse) then Missing := Missing + ' SendHTTPRequestAndStreamResponse';
  if not Assigned(FFlat.DeferHTTPRequest) then Missing := Missing + ' DeferHTTPRequest';
  if not Assigned(FFlat.PrioritizeHTTPRequest) then Missing := Missing + ' PrioritizeHTTPRequest';
  if not Assigned(FFlat.GetHTTPResponseHeaderSize) then Missing := Missing + ' GetHTTPResponseHeaderSize';
  if not Assigned(FFlat.GetHTTPResponseHeaderValue) then Missing := Missing + ' GetHTTPResponseHeaderValue';
  if not Assigned(FFlat.GetHTTPResponseBodySize) then Missing := Missing + ' GetHTTPResponseBodySize';
  if not Assigned(FFlat.GetHTTPResponseBodyData) then Missing := Missing + ' GetHTTPResponseBodyData';
  if not Assigned(FFlat.GetHTTPStreamingResponseBodyData) then Missing := Missing + ' GetHTTPStreamingResponseBodyData';
  if not Assigned(FFlat.ReleaseHTTPRequest) then Missing := Missing + ' ReleaseHTTPRequest';
  if not Assigned(FFlat.GetHTTPDownloadProgressPct) then Missing := Missing + ' GetHTTPDownloadProgressPct';
  if not Assigned(FFlat.SetHTTPRequestRawPostBody) then Missing := Missing + ' SetHTTPRequestRawPostBody';
  if not Assigned(FFlat.CreateCookieContainer) then Missing := Missing + ' CreateCookieContainer';
  if not Assigned(FFlat.ReleaseCookieContainer) then Missing := Missing + ' ReleaseCookieContainer';
  if not Assigned(FFlat.SetCookie) then Missing := Missing + ' SetCookie';
  if not Assigned(FFlat.SetHTTPRequestCookieContainer) then Missing := Missing + ' SetHTTPRequestCookieContainer';
  if not Assigned(FFlat.SetHTTPRequestUserAgentInfo) then Missing := Missing + ' SetHTTPRequestUserAgentInfo';
  if not Assigned(FFlat.SetHTTPRequestRequiresVerifiedCertificate) then Missing := Missing + ' SetHTTPRequestRequiresVerifiedCertificate';
  if not Assigned(FFlat.SetHTTPRequestAbsoluteTimeoutMS) then Missing := Missing + ' SetHTTPRequestAbsoluteTimeoutMS';
  if not Assigned(FFlat.GetHTTPRequestWasTimedOut) then Missing := Missing + ' GetHTTPRequestWasTimedOut';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
