{ TSteamHTTP }

function TSteamHTTP.GetPlugin: TSteamHTTPPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamHTTPPlugin(TSteamworks.Instance.FindPlugin(PluginClass));
end;

class function TSteamHTTP.PluginClass: TSteamPluginClass;
begin
  Result := TSteamHTTPPlugin;
end;

procedure TSteamHTTP.DoAttach;
begin
  SubscribeCallback(HTTPRequestCompleted_t_k_iCallback, HandleHTTPRequestCompleted);
  SubscribeCallback(HTTPRequestHeadersReceived_t_k_iCallback, HandleHTTPRequestHeadersReceived);
  SubscribeCallback(HTTPRequestDataReceived_t_k_iCallback, HandleHTTPRequestDataReceived);
end;

procedure TSteamHTTP.HandleHTTPRequestCompleted(const AData: TSteamCallbackData);
var
  Ev: HTTPRequestCompleted_t;
begin
  if not Assigned(FOnHTTPRequestCompleted) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'HTTPRequestCompleted_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnHTTPRequestCompleted(Self, Ev);
end;

procedure TSteamHTTP.HandleHTTPRequestHeadersReceived(const AData: TSteamCallbackData);
var
  Ev: HTTPRequestHeadersReceived_t;
begin
  if not Assigned(FOnHTTPRequestHeadersReceived) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'HTTPRequestHeadersReceived_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnHTTPRequestHeadersReceived(Self, Ev);
end;

procedure TSteamHTTP.HandleHTTPRequestDataReceived(const AData: TSteamCallbackData);
var
  Ev: HTTPRequestDataReceived_t;
begin
  if not Assigned(FOnHTTPRequestDataReceived) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'HTTPRequestDataReceived_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnHTTPRequestDataReceived(Self, Ev);
end;

