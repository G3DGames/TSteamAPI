    Result := TSteamUtilsPlugin(TSteamworks.Instance.FindPlugin(TSteamUtilsPlugin));
end;

procedure TSteamUtils.DoAttach;
begin
  SubscribeCallback(IPCountry_t_k_iCallback, HandleIPCountry);
  SubscribeCallback(LowBatteryPower_t_k_iCallback, HandleLowBatteryPower);
  SubscribeCallback(CheckFileSignature_t_k_iCallback, HandleCheckFileSignature);
  SubscribeCallback(GamepadTextInputDismissed_t_k_iCallback, HandleGamepadTextInputDismissed);
  SubscribeCallback(AppResumingFromSuspend_t_k_iCallback, HandleAppResumingFromSuspend);
  SubscribeCallback(FloatingGamepadTextInputDismissed_t_k_iCallback, HandleFloatingGamepadTextInputDismissed);
  SubscribeCallback(FilterTextDictionaryChanged_t_k_iCallback, HandleFilterTextDictionaryChanged);
end;

procedure TSteamUtils.HandleIPCountry(const AData: TSteamCallbackData);
var
  Ev: IPCountry_t;
begin
  if not Assigned(FOnIPCountry) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'IPCountry_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnIPCountry(Self, Ev);
end;

