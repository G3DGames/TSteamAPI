  if not Assigned(FFlat.IsRunningUnderProton) then Missing := Missing + ' IsRunningUnderProton';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  F_IsRunningOnSteamDeck := nil;
  Bind(F_IsRunningOnSteamDeck, PFX + 'IsRunningOnSteamDeck', False);
  Subscribe(IPCountry_t_k_iCallback, HandleIPCountry);
  Subscribe(LowBatteryPower_t_k_iCallback, HandleLowBattery);
  Result := True;
