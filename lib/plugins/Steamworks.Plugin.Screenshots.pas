    { @code(SteamAPI_ISteamScreenshots_WriteScreenshot). }
    WriteScreenshot: function(AIntf: Pointer; pubRGB: Pointer; cubRGB: UInt32; nWidth: Integer; nHeight: Integer): ScreenshotHandle; cdecl;
    { @code(SteamAPI_ISteamScreenshots_AddScreenshotToLibrary). }
    AddScreenshotToLibrary: function(AIntf: Pointer; pchFilename: PAnsiChar; pchThumbnailFilename: PAnsiChar; nWidth: Integer; nHeight: Integer): ScreenshotHandle; cdecl;
    { @code(SteamAPI_ISteamScreenshots_TriggerScreenshot). }
    TriggerScreenshot: procedure(AIntf: Pointer); cdecl;
    { @code(SteamAPI_ISteamScreenshots_HookScreenshots). }
    HookScreenshots: procedure(AIntf: Pointer; bHook: Boolean); cdecl;
    { @code(SteamAPI_ISteamScreenshots_SetLocation). }
    SetLocation: function(AIntf: Pointer; hScreenshot: ScreenshotHandle; pchLocation: PAnsiChar): Boolean; cdecl;
    { @code(SteamAPI_ISteamScreenshots_TagUser). }
    TagUser: function(AIntf: Pointer; hScreenshot: ScreenshotHandle; steamID: UInt64): Boolean; cdecl;
    { @code(SteamAPI_ISteamScreenshots_TagPublishedFile). }
    TagPublishedFile: function(AIntf: Pointer; hScreenshot: ScreenshotHandle; unPublishedFileID: PublishedFileId_t): Boolean; cdecl;
    { @code(SteamAPI_ISteamScreenshots_IsScreenshotsHooked). }
    IsScreenshotsHooked: function(AIntf: Pointer): Boolean; cdecl;
    { @code(SteamAPI_ISteamScreenshots_AddVRScreenshotToLibrary). }
    AddVRScreenshotToLibrary: function(AIntf: Pointer; eType: EVRScreenshotType; pchFilename: PAnsiChar; pchVRFilename: PAnsiChar): ScreenshotHandle; cdecl;
  end;

  { ISteamScreenshots plug-in. Registered by linking the unit; find it with
    @code(Steam.FindPlugin(TSteamScreenshotsPlugin)). }
  TSteamScreenshotsPlugin = class(TSteamPlugin)
  private
    { The ISteamScreenshots pointer (@nil when not initialised). }
    FIntf: Pointer;
    { Bound flat exports. }
    FFlat: TSteamScreenshotsFlat;
    { Raises ESteamworksError unless the plug-in is initialised and AOk (the export is bound). }
    procedure Need(AOk: Boolean; const AExport: string);
  protected
    { Acquires ISteamScreenshots and binds its exports (all optional). }
    function DoInitialize: Boolean; override;
    { Forgets the interface pointer and the bound exports. }
    procedure DoFinalize; override;
  public
    { Returns @code('ISteamScreenshots'). }
    class function PluginName: string; override;
    { The interface version, for versioned initialisation. }
    class function InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray; override;

    { Writes a screenshot to the user's screenshot library given the raw image data, which must be
      in RGB format. The return value is a handle that is valid for the duration of the game
      process and can be used to apply tags. }
    function WriteScreenshot(pubRGB: Pointer; cubRGB: UInt32; nWidth: Integer; nHeight: Integer): ScreenshotHandle;
    { Adds a screenshot to the user's screenshot library from disk. If a thumbnail is provided, it
      must be 200 pixels wide and the same aspect ratio as the screenshot, otherwise a thumbnail
      will be generated if the user uploads the screenshot. The screenshots must be in either JPEG
      or TGA format. The return value is a handle that is valid for the duration of the game
      process and can be used to apply tags. JPEG, TGA, and PNG formats are supported. }
    function AddScreenshotToLibrary(const pchFilename: string; const pchThumbnailFilename: string; nWidth: Integer; nHeight: Integer): ScreenshotHandle;
    { Causes the Steam overlay to take a screenshot. If screenshots are being hooked by the game
      then a ScreenshotRequested_t callback is sent back to the game instead. }
    procedure TriggerScreenshot;
    { Toggles whether the overlay handles screenshots when the user presses the screenshot hotkey,
      or the game handles them. If the game is hooking screenshots, then the ScreenshotRequested_t
      callback will be sent if the user presses the hotkey, and the game is expected to call
      WriteScreenshot or AddScreenshotToLibrary in response. }
    procedure HookScreenshots(bHook: Boolean);
    { Sets metadata about a screenshot's location (for example, the name of the map). }
    function SetLocation(hScreenshot: ScreenshotHandle; const pchLocation: string): Boolean;
    { Tags a user as being visible in the screenshot. }
    function TagUser(hScreenshot: ScreenshotHandle; const steamID: TSteamID): Boolean;
    { Tags a published file as being visible in the screenshot. }
    function TagPublishedFile(hScreenshot: ScreenshotHandle; unPublishedFileID: PublishedFileId_t): Boolean;
    { Returns true if the app has hooked the screenshot. }
    function IsScreenshotsHooked: Boolean;
    { Adds a VR screenshot to the user's screenshot library from disk in the supported type.
      pchFilename should be the normal 2D image used in the library view pchVRFilename should
      contain the image that matches the correct type The return value is a handle that is valid
      for the duration of the game process and can be used to apply tags. JPEG, TGA, and PNG
      formats are supported. }
    function AddVRScreenshotToLibrary(eType: EVRScreenshotType; const pchFilename: string; const pchVRFilename: string): ScreenshotHandle;

    { The raw ISteamScreenshots pointer (first argument of every @link(Flat) export). }
    property Handle: Pointer read FIntf;
    { The bound flat exports, for calls the methods do not cover. }
    property Flat: TSteamScreenshotsFlat read FFlat;
  end;

  { Event of @link(TSteamScreenshots.OnScreenshotReady): callback 2301, payload
    @link(ScreenshotReady_t). }
  TScreenshotReadyEvent = procedure(Sender: TObject; const AData: ScreenshotReady_t) of object;
  { Event of @link(TSteamScreenshots.OnScreenshotRequested): callback 2302, payload
    @link(ScreenshotRequested_t). }
  TScreenshotRequestedEvent = procedure(Sender: TObject; const AData: ScreenshotRequested_t) of object;

{$ifndef FPC}
  [ComponentPlatformsAttribute(STEAM_COMPONENT_PLATFORMS)]
{$endif}
  { ISteamScreenshots component: drop it next to a TSteamAPI (linked automatically at run time
    when the owner has exactly one, otherwise set SteamAPI). Its events are the ISteamScreenshots
    callbacks; call the interface through @link(Plugin). }
  TSteamScreenshots = class(TSteamPluginComponent)
  private
    { Backing field of @link(OnScreenshotReady). }
    FOnScreenshotReady: TScreenshotReadyEvent;
    { Backing field of @link(OnScreenshotRequested). }
    FOnScreenshotRequested: TScreenshotRequestedEvent;
    { Read accessor of @link(Plugin). }
    function GetPlugin: TSteamScreenshotsPlugin;
    { Raises @link(OnScreenshotReady) for ScreenshotReady_t. }
    procedure HandleScreenshotReady(const AData: TSteamCallbackData);
    { Raises @link(OnScreenshotRequested) for ScreenshotRequested_t. }
    procedure HandleScreenshotRequested(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamScreenshots plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamScreenshotsPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 2301 (ScreenshotReady_t): Screenshot successfully written or otherwise added to the
      library and can now be tagged. }
    property OnScreenshotReady: TScreenshotReadyEvent read FOnScreenshotReady write FOnScreenshotReady;
    { Callback 2302 (ScreenshotRequested_t): Screenshot has been requested by the user. Only sent
      if HookScreenshots() has been called, in which case Steam will not take the screenshot
      itself. }
    property OnScreenshotRequested: TScreenshotRequestedEvent read FOnScreenshotRequested write FOnScreenshotRequested;
  end;

implementation

const
  PFX = 'SteamAPI_ISteamScreenshots_';

function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamScreenshotsPlugin }

class function TSteamScreenshotsPlugin.PluginName: string;
begin
  Result := 'ISteamScreenshots';
end;

class function TSteamScreenshotsPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMSCREENSHOTS_INTERFACE_VERSION);
end;

function TSteamScreenshotsPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMSCREENSHOTS_INTERFACE_VERSION, 'SteamScreenshots');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamScreenshotsFlat);
  Bind(FFlat.WriteScreenshot, PFX + 'WriteScreenshot', False);
  Bind(FFlat.AddScreenshotToLibrary, PFX + 'AddScreenshotToLibrary', False);
  Bind(FFlat.TriggerScreenshot, PFX + 'TriggerScreenshot', False);
  Bind(FFlat.HookScreenshots, PFX + 'HookScreenshots', False);
  Bind(FFlat.SetLocation, PFX + 'SetLocation', False);
  Bind(FFlat.TagUser, PFX + 'TagUser', False);
  Bind(FFlat.TagPublishedFile, PFX + 'TagPublishedFile', False);
  Bind(FFlat.IsScreenshotsHooked, PFX + 'IsScreenshotsHooked', False);
  Bind(FFlat.AddVRScreenshotToLibrary, PFX + 'AddVRScreenshotToLibrary', False);
  Missing := '';
  if not Assigned(FFlat.WriteScreenshot) then Missing := Missing + ' WriteScreenshot';
  if not Assigned(FFlat.AddScreenshotToLibrary) then Missing := Missing + ' AddScreenshotToLibrary';
  if not Assigned(FFlat.TriggerScreenshot) then Missing := Missing + ' TriggerScreenshot';
  if not Assigned(FFlat.HookScreenshots) then Missing := Missing + ' HookScreenshots';
  if not Assigned(FFlat.SetLocation) then Missing := Missing + ' SetLocation';
  if not Assigned(FFlat.TagUser) then Missing := Missing + ' TagUser';
  if not Assigned(FFlat.TagPublishedFile) then Missing := Missing + ' TagPublishedFile';
  if not Assigned(FFlat.IsScreenshotsHooked) then Missing := Missing + ' IsScreenshotsHooked';
  if not Assigned(FFlat.AddVRScreenshotToLibrary) then Missing := Missing + ' AddVRScreenshotToLibrary';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamScreenshotsPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamScreenshotsFlat);
end;

procedure TSteamScreenshotsPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamScreenshots.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamScreenshots.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

function TSteamScreenshotsPlugin.WriteScreenshot(pubRGB: Pointer; cubRGB: UInt32; nWidth: Integer; nHeight: Integer): ScreenshotHandle;
begin
  Need(Assigned(FFlat.WriteScreenshot), 'WriteScreenshot');
  Result := FFlat.WriteScreenshot(FIntf, pubRGB, cubRGB, nWidth, nHeight);
end;

function TSteamScreenshotsPlugin.AddScreenshotToLibrary(const pchFilename: string; const pchThumbnailFilename: string; nWidth: Integer; nHeight: Integer): ScreenshotHandle;
var
  U_pchFilename: UTF8String;
  U_pchThumbnailFilename: UTF8String;
begin
  Need(Assigned(FFlat.AddScreenshotToLibrary), 'AddScreenshotToLibrary');
  U_pchFilename := UTF8String(pchFilename);
  U_pchThumbnailFilename := UTF8String(pchThumbnailFilename);
  Result := FFlat.AddScreenshotToLibrary(FIntf, PAnsiChar(U_pchFilename), PAnsiChar(U_pchThumbnailFilename), nWidth, nHeight);
end;

procedure TSteamScreenshotsPlugin.TriggerScreenshot;
begin
  Need(Assigned(FFlat.TriggerScreenshot), 'TriggerScreenshot');
  FFlat.TriggerScreenshot(FIntf);
end;

procedure TSteamScreenshotsPlugin.HookScreenshots(bHook: Boolean);
begin
  Need(Assigned(FFlat.HookScreenshots), 'HookScreenshots');
  FFlat.HookScreenshots(FIntf, bHook);
end;

function TSteamScreenshotsPlugin.SetLocation(hScreenshot: ScreenshotHandle; const pchLocation: string): Boolean;
var
  U_pchLocation: UTF8String;
begin
  Need(Assigned(FFlat.SetLocation), 'SetLocation');
  U_pchLocation := UTF8String(pchLocation);
  Result := FFlat.SetLocation(FIntf, hScreenshot, PAnsiChar(U_pchLocation));
end;

function TSteamScreenshotsPlugin.TagUser(hScreenshot: ScreenshotHandle; const steamID: TSteamID): Boolean;
begin
  Need(Assigned(FFlat.TagUser), 'TagUser');
  Result := FFlat.TagUser(FIntf, hScreenshot, steamID.Value);
end;

function TSteamScreenshotsPlugin.TagPublishedFile(hScreenshot: ScreenshotHandle; unPublishedFileID: PublishedFileId_t): Boolean;
begin
  Need(Assigned(FFlat.TagPublishedFile), 'TagPublishedFile');
  Result := FFlat.TagPublishedFile(FIntf, hScreenshot, unPublishedFileID);
end;

function TSteamScreenshotsPlugin.IsScreenshotsHooked: Boolean;
begin
  Need(Assigned(FFlat.IsScreenshotsHooked), 'IsScreenshotsHooked');
  Result := FFlat.IsScreenshotsHooked(FIntf);
end;

function TSteamScreenshotsPlugin.AddVRScreenshotToLibrary(eType: EVRScreenshotType; const pchFilename: string; const pchVRFilename: string): ScreenshotHandle;
var
  U_pchFilename: UTF8String;
  U_pchVRFilename: UTF8String;
begin
  Need(Assigned(FFlat.AddVRScreenshotToLibrary), 'AddVRScreenshotToLibrary');
  U_pchFilename := UTF8String(pchFilename);
  U_pchVRFilename := UTF8String(pchVRFilename);
  Result := FFlat.AddVRScreenshotToLibrary(FIntf, eType, PAnsiChar(U_pchFilename), PAnsiChar(U_pchVRFilename));
end;

{ TSteamScreenshots }

function TSteamScreenshots.GetPlugin: TSteamScreenshotsPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamScreenshotsPlugin(TSteamworks.Instance.FindPlugin(TSteamScreenshotsPlugin));
end;

procedure TSteamScreenshots.DoAttach;
begin
  SubscribeCallback(ScreenshotReady_t_k_iCallback, HandleScreenshotReady);
  SubscribeCallback(ScreenshotRequested_t_k_iCallback, HandleScreenshotRequested);
end;

procedure TSteamScreenshots.HandleScreenshotReady(const AData: TSteamCallbackData);
var
  Ev: ScreenshotReady_t;
begin
  if not Assigned(FOnScreenshotReady) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'ScreenshotReady_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnScreenshotReady(Self, Ev);
end;

procedure TSteamScreenshots.HandleScreenshotRequested(const AData: TSteamCallbackData);
var
  Ev: ScreenshotRequested_t;
begin
  if not Assigned(FOnScreenshotRequested) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'ScreenshotRequested_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnScreenshotRequested(Self, Ev);
end;

initialization
  TSteamworks.RegisterPlugin(TSteamScreenshotsPlugin);

finalization
  TSteamworks.UnregisterPlugin(TSteamScreenshotsPlugin);

end.
