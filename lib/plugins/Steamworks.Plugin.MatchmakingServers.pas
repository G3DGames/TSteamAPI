function TSteamMatchmakingServersPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMMATCHMAKINGSERVERS_INTERFACE_VERSION, 'SteamMatchmakingServers');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamMatchmakingServersFlat);
  Bind(FFlat.RequestInternetServerList, PFX + 'RequestInternetServerList', False);
  Bind(FFlat.RequestLANServerList, PFX + 'RequestLANServerList', False);
  Bind(FFlat.RequestFriendsServerList, PFX + 'RequestFriendsServerList', False);
  Bind(FFlat.RequestFavoritesServerList, PFX + 'RequestFavoritesServerList', False);
  Bind(FFlat.RequestHistoryServerList, PFX + 'RequestHistoryServerList', False);
  Bind(FFlat.RequestSpectatorServerList, PFX + 'RequestSpectatorServerList', False);
  Bind(FFlat.ReleaseRequest, PFX + 'ReleaseRequest', False);
  Bind(FFlat.GetServerDetails, PFX + 'GetServerDetails', False);
  Bind(FFlat.CancelQuery, PFX + 'CancelQuery', False);
  Bind(FFlat.RefreshQuery, PFX + 'RefreshQuery', False);
  Bind(FFlat.IsRefreshing, PFX + 'IsRefreshing', False);
  Bind(FFlat.GetServerCount, PFX + 'GetServerCount', False);
  Bind(FFlat.RefreshServer, PFX + 'RefreshServer', False);
  Bind(FFlat.PingServer, PFX + 'PingServer', False);
  Bind(FFlat.PlayerDetails, PFX + 'PlayerDetails', False);
  Bind(FFlat.ServerRules, PFX + 'ServerRules', False);
  Bind(FFlat.ServerFriends, PFX + 'ServerFriends', False);
  Bind(FFlat.CancelServerQuery, PFX + 'CancelServerQuery', False);
  Missing := '';
  if not Assigned(FFlat.RequestInternetServerList) then Missing := Missing + ' RequestInternetServerList';
  if not Assigned(FFlat.RequestLANServerList) then Missing := Missing + ' RequestLANServerList';
  if not Assigned(FFlat.RequestFriendsServerList) then Missing := Missing + ' RequestFriendsServerList';
  if not Assigned(FFlat.RequestFavoritesServerList) then Missing := Missing + ' RequestFavoritesServerList';
  if not Assigned(FFlat.RequestHistoryServerList) then Missing := Missing + ' RequestHistoryServerList';
  if not Assigned(FFlat.RequestSpectatorServerList) then Missing := Missing + ' RequestSpectatorServerList';
  if not Assigned(FFlat.ReleaseRequest) then Missing := Missing + ' ReleaseRequest';
  if not Assigned(FFlat.GetServerDetails) then Missing := Missing + ' GetServerDetails';
  if not Assigned(FFlat.CancelQuery) then Missing := Missing + ' CancelQuery';
  if not Assigned(FFlat.RefreshQuery) then Missing := Missing + ' RefreshQuery';
  if not Assigned(FFlat.IsRefreshing) then Missing := Missing + ' IsRefreshing';
  if not Assigned(FFlat.GetServerCount) then Missing := Missing + ' GetServerCount';
  if not Assigned(FFlat.RefreshServer) then Missing := Missing + ' RefreshServer';
  if not Assigned(FFlat.PingServer) then Missing := Missing + ' PingServer';
  if not Assigned(FFlat.PlayerDetails) then Missing := Missing + ' PlayerDetails';
  if not Assigned(FFlat.ServerRules) then Missing := Missing + ' ServerRules';
  if not Assigned(FFlat.ServerFriends) then Missing := Missing + ' ServerFriends';
  if not Assigned(FFlat.CancelServerQuery) then Missing := Missing + ' CancelServerQuery';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  FClosing := False;
  Subscribe(SteamServerResponse_k_iPosted, HandlePosted);
  Result := True;
end;

procedure TSteamMatchmakingServersPlugin.DoFinalize;
begin
  CloseResponses;
  FIntf := nil;
  FFlat := Default(TSteamMatchmakingServersFlat);
end;

