const
  { Response object kinds (TSteamServerResponse.Kind). }
  SRK_LIST = 0;
  SRK_PING = 1;
  SRK_PLAYERS = 2;
  SRK_RULES = 3;
  { Seconds an ended object is kept (the pump may still be in RunFrame). }
  SR_KEEP_SECONDS = 5;
  { Pumps an answer may wait for its query handle (see HandlePosted). }
  SR_MAX_RETRIES = 200;

type
  { Header of a posted payload; the UTF-8 text and value bytes follow. }
  TSteamServerPosted = record
    { The object the answer belongs to. }
    Obj: PSteamServerResponse;
    { Its Serial when the answer was posted. }
    Serial: Cardinal;
    { Times the delivery was put off because the query handle was not
      stored yet (see HandlePosted). }
    Retries: Integer;
    { The answer. }
    Event: TSteamServerEvent;
    { Bytes of the text after the header. }
    TextLen: Integer;
    { Bytes of the value after the text. }
    ValueLen: Integer;
  end;

var
  { The four vtables (filled by InitServerVTables). }
  VT_List: array[0..2] of Pointer;
  VT_Ping: array[0..1] of Pointer;
  VT_Players: array[0..2] of Pointer;
  VT_Rules: array[0..2] of Pointer;

function PluginOf(AThis: PSteamServerResponse): TSteamMatchmakingServersPlugin;
begin
  Result := TSteamMatchmakingServersPlugin(AThis^.Plugin);
end;

// Every routine swallows exceptions: nothing may unwind into Steam's C++ frames.

procedure List_ServerResponded(AThis: PSteamServerResponse; ARequest: HServerListRequest;
  AServer: Integer); {$ifdef STEAM_SERVER_THISCALL}stdcall{$else}cdecl{$endif};
var
  Ev: TSteamServerEvent;
begin
  try
    Ev := Default(TSteamServerEvent);
    Ev.Kind := sekServerResponded;
    Ev.Request := ARequest;
    Ev.Index := AServer;
    PluginOf(AThis).FillServer(ARequest, AServer, Ev);
    PluginOf(AThis).PostEvent(AThis, Ev, nil, nil, False);
  except
  end;
end;

procedure List_ServerFailedToRespond(AThis: PSteamServerResponse; ARequest: HServerListRequest;
  AServer: Integer); {$ifdef STEAM_SERVER_THISCALL}stdcall{$else}cdecl{$endif};
var
  Ev: TSteamServerEvent;
begin
  try
    Ev := Default(TSteamServerEvent);
    Ev.Kind := sekServerFailedToRespond;
    Ev.Request := ARequest;
    Ev.Index := AServer;
    PluginOf(AThis).PostEvent(AThis, Ev, nil, nil, False);
  except
  end;
end;

procedure List_RefreshComplete(AThis: PSteamServerResponse; ARequest: HServerListRequest;
  AResponse: EMatchMakingServerResponse); {$ifdef STEAM_SERVER_THISCALL}stdcall{$else}cdecl{$endif};
var
  Ev: TSteamServerEvent;
begin
  try
    Ev := Default(TSteamServerEvent);
    Ev.Kind := sekServerListComplete;
    Ev.Request := ARequest;
    Ev.Response := AResponse;
    // not final: the request lives until StopServerList (RefreshQuery)
    PluginOf(AThis).PostEvent(AThis, Ev, nil, nil, False);
  except
  end;
end;

procedure Ping_ServerResponded(AThis: PSteamServerResponse; AServer: Pgameserveritem_t);
  {$ifdef STEAM_SERVER_THISCALL}stdcall{$else}cdecl{$endif};
var
  Ev: TSteamServerEvent;
begin
  try
    Ev := Default(TSteamServerEvent);
    Ev.Kind := sekPingResponded;
    if AServer <> nil then
    begin
      Ev.Server := AServer^;
      Ev.HasServer := True;
    end;
    PluginOf(AThis).PostEvent(AThis, Ev, nil, nil, True);
  except
  end;
end;

