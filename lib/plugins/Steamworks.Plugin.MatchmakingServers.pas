procedure TSteamMatchmakingServersPlugin.StopServerQuery(AQuery: HServerQuery);
var
  I: Integer;
  Obj, Found: PSteamServerResponse;
  Known: Boolean;
begin
  Need(Assigned(FFlat.CancelServerQuery), 'CancelServerQuery');
  if AQuery = HSERVERQUERY_INVALID then
    Exit;
  Found := nil;
  Known := False;
  FServerLock.Enter;
  try
    // Steam may reuse query numbers: the RUNNING query with that number
    // first, then one that has ended (only marked, nothing to cancel)
    for I := 0 to FObjects.Count - 1 do
    begin
      Obj := FObjects[I];
      if (Obj^.Kind <> SRK_LIST) and (Obj^.Query = AQuery) then
      begin
        Known := True;
        if not (Obj^.Cancelled or Obj^.Finished) then
        begin
          Found := Obj;
          Break;
        end;
      end;
    end;
    if Found <> nil then
      MarkCancelled(Found)
    else
      for I := 0 to FObjects.Count - 1 do
      begin
        Obj := FObjects[I];
        if (Obj^.Kind <> SRK_LIST) and (Obj^.Query = AQuery) then
          MarkCancelled(Obj);   // ended: no more events, no Steam call
      end;
  finally
    FServerLock.Leave;
  end;
  if Found <> nil then
    StopInSteam(Found)
  else if not Known then
    FFlat.CancelServerQuery(FIntf, AQuery);   // a raw query of the generated methods
end;

procedure TSteamMatchmakingServersPlugin.StopOwner(AOwner: TObject);
var
  Stop: TList;
  I: Integer;
  Obj: PSteamServerResponse;
begin
  if AOwner = nil then
    Exit;
  Stop := TList.Create;
  try
    FServerLock.Enter;
    try
      for I := 0 to FObjects.Count - 1 do
      begin
        Obj := FObjects[I];
        if (TMethod(Obj^.Handler).Data = Pointer(AOwner)) and MarkCancelled(Obj) then
          Stop.Add(Obj);
      end;
    finally
      FServerLock.Leave;
    end;
    for I := 0 to Stop.Count - 1 do
      StopInSteam(Stop[I]);
  finally
    Stop.Free;
  end;
end;

function TSteamMatchmakingServersPlugin.ActiveCount: Integer;
var
  I: Integer;
  Obj: PSteamServerResponse;
begin
  Result := 0;
  FServerLock.Enter;
  try
    for I := 0 to FObjects.Count - 1 do
    begin
      Obj := FObjects[I];
      if not (Obj^.Finished or Obj^.Cancelled) then
        Inc(Result);
    end;
  finally
    FServerLock.Leave;
  end;
end;

