procedure TSteamRemoteStoragePlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamRemoteStorageFlat);
end;

procedure TSteamRemoteStoragePlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamRemoteStorage.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamRemoteStorage.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

