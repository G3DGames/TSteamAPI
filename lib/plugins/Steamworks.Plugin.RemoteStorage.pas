procedure TSteamRemoteStorage.DoAttach;
begin
  SubscribeCallback(RemoteStorageFileShareResult_t_k_iCallback, HandleRemoteStorageFileShareResult);
  SubscribeCallback(RemoteStoragePublishFileResult_t_k_iCallback, HandleRemoteStoragePublishFileResult);
  SubscribeCallback(RemoteStorageDeletePublishedFileResult_t_k_iCallback, HandleRemoteStorageDeletePublishedFileResult);
  SubscribeCallback(RemoteStorageEnumerateUserPublishedFilesResult_t_k_iCallback, HandleRemoteStorageEnumerateUserPublishedFilesResult);
  SubscribeCallback(RemoteStorageSubscribePublishedFileResult_t_k_iCallback, HandleRemoteStorageSubscribePublishedFileResult);
  SubscribeCallback(RemoteStorageEnumerateUserSubscribedFilesResult_t_k_iCallback, HandleRemoteStorageEnumerateUserSubscribedFilesResult);
  SubscribeCallback(RemoteStorageUnsubscribePublishedFileResult_t_k_iCallback, HandleRemoteStorageUnsubscribePublishedFileResult);
  SubscribeCallback(RemoteStorageUpdatePublishedFileResult_t_k_iCallback, HandleRemoteStorageUpdatePublishedFileResult);
  SubscribeCallback(RemoteStorageDownloadUGCResult_t_k_iCallback, HandleRemoteStorageDownloadUGCResult);
  SubscribeCallback(RemoteStorageGetPublishedFileDetailsResult_t_k_iCallback, HandleRemoteStorageGetPublishedFileDetailsResult);
  SubscribeCallback(RemoteStorageEnumerateWorkshopFilesResult_t_k_iCallback, HandleRemoteStorageEnumerateWorkshopFilesResult);
  SubscribeCallback(RemoteStorageGetPublishedItemVoteDetailsResult_t_k_iCallback, HandleRemoteStorageGetPublishedItemVoteDetailsResult);
  SubscribeCallback(RemoteStoragePublishedFileSubscribed_t_k_iCallback, HandleRemoteStoragePublishedFileSubscribed);
  SubscribeCallback(RemoteStoragePublishedFileUnsubscribed_t_k_iCallback, HandleRemoteStoragePublishedFileUnsubscribed);
  SubscribeCallback(RemoteStoragePublishedFileDeleted_t_k_iCallback, HandleRemoteStoragePublishedFileDeleted);
  SubscribeCallback(RemoteStorageUpdateUserPublishedItemVoteResult_t_k_iCallback, HandleRemoteStorageUpdateUserPublishedItemVoteResult);
  SubscribeCallback(RemoteStorageUserVoteDetails_t_k_iCallback, HandleRemoteStorageUserVoteDetails);
  SubscribeCallback(RemoteStorageEnumerateUserSharedWorkshopFilesResult_t_k_iCallback, HandleRemoteStorageEnumerateUserSharedWorkshopFilesResult);
  SubscribeCallback(RemoteStorageSetUserPublishedFileActionResult_t_k_iCallback, HandleRemoteStorageSetUserPublishedFileActionResult);
  SubscribeCallback(RemoteStorageEnumeratePublishedFilesByUserActionResult_t_k_iCallback, HandleRemoteStorageEnumeratePublishedFilesByUserActionResult);
  SubscribeCallback(RemoteStoragePublishFileProgress_t_k_iCallback, HandleRemoteStoragePublishFileProgress);
  SubscribeCallback(RemoteStoragePublishedFileUpdated_t_k_iCallback, HandleRemoteStoragePublishedFileUpdated);
  SubscribeCallback(RemoteStorageFileWriteAsyncComplete_t_k_iCallback, HandleRemoteStorageFileWriteAsyncComplete);
  SubscribeCallback(RemoteStorageFileReadAsyncComplete_t_k_iCallback, HandleRemoteStorageFileReadAsyncComplete);
  SubscribeCallback(RemoteStorageLocalFileChange_t_k_iCallback, HandleRemoteStorageLocalFileChange);
end;

procedure TSteamRemoteStorage.HandleRemoteStorageFileShareResult(const AData: TSteamCallbackData);
var
  Ev: RemoteStorageFileShareResult_t;
begin
  if not Assigned(FOnRemoteStorageFileShareResult) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'RemoteStorageFileShareResult_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnRemoteStorageFileShareResult(Self, Ev);
end;

