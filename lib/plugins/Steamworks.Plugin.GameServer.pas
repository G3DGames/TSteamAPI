const
  PFX = 'SteamAPI_ISteamGameServer_';

function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamGameServerPlugin }

class function TSteamGameServerPlugin.PluginName: string;
begin
  Result := 'ISteamGameServer';
end;

class function TSteamGameServerPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMGAMESERVER_INTERFACE_VERSION);
end;

class function TSteamGameServerPlugin.IsGameServer: Boolean;
begin
  Result := True;
end;

function TSteamGameServerPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMGAMESERVER_INTERFACE_VERSION, 'SteamGameServer');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamGameServerFlat);
  Bind(FFlat.SetProduct, PFX + 'SetProduct', False);
  Bind(FFlat.SetGameDescription, PFX + 'SetGameDescription', False);
  Bind(FFlat.SetModDir, PFX + 'SetModDir', False);
  Bind(FFlat.SetDedicatedServer, PFX + 'SetDedicatedServer', False);
  Bind(FFlat.LogOn, PFX + 'LogOn', False);
  Bind(FFlat.LogOnAnonymous, PFX + 'LogOnAnonymous', False);
  Bind(FFlat.LogOff, PFX + 'LogOff', False);
  Bind(FFlat.BLoggedOn, PFX + 'BLoggedOn', False);
  Bind(FFlat.BSecure, PFX + 'BSecure', False);
  Bind(FFlat.GetSteamID, PFX + 'GetSteamID', False);
  Bind(FFlat.WasRestartRequested, PFX + 'WasRestartRequested', False);
  Bind(FFlat.SetMaxPlayerCount, PFX + 'SetMaxPlayerCount', False);
  Bind(FFlat.SetBotPlayerCount, PFX + 'SetBotPlayerCount', False);
  Bind(FFlat.SetServerName, PFX + 'SetServerName', False);
  Bind(FFlat.SetMapName, PFX + 'SetMapName', False);
  Bind(FFlat.SetPasswordProtected, PFX + 'SetPasswordProtected', False);
  Bind(FFlat.SetSpectatorPort, PFX + 'SetSpectatorPort', False);
  Bind(FFlat.SetSpectatorServerName, PFX + 'SetSpectatorServerName', False);
  Bind(FFlat.ClearAllKeyValues, PFX + 'ClearAllKeyValues', False);
  Bind(FFlat.SetKeyValue, PFX + 'SetKeyValue', False);
  Bind(FFlat.SetGameTags, PFX + 'SetGameTags', False);
  Bind(FFlat.SetGameData, PFX + 'SetGameData', False);
  Bind(FFlat.SetRegion, PFX + 'SetRegion', False);
  Bind(FFlat.SetAdvertiseServerActive, PFX + 'SetAdvertiseServerActive', False);
  Bind(FFlat.GetAuthSessionTicket, PFX + 'GetAuthSessionTicket', False);
  Bind(FFlat.BeginAuthSession, PFX + 'BeginAuthSession', False);
  Bind(FFlat.EndAuthSession, PFX + 'EndAuthSession', False);
  Bind(FFlat.CancelAuthTicket, PFX + 'CancelAuthTicket', False);
  Bind(FFlat.UserHasLicenseForApp, PFX + 'UserHasLicenseForApp', False);
  Bind(FFlat.RequestUserGroupStatus, PFX + 'RequestUserGroupStatus', False);
  Bind(FFlat.GetGameplayStats, PFX + 'GetGameplayStats', False);
  Bind(FFlat.GetServerReputation, PFX + 'GetServerReputation', False);
  Bind(FFlat.HandleIncomingPacket, PFX + 'HandleIncomingPacket', False);
  Bind(FFlat.GetNextOutgoingPacket, PFX + 'GetNextOutgoingPacket', False);
  Bind(FFlat.AssociateWithClan, PFX + 'AssociateWithClan', False);
  Bind(FFlat.ComputeNewPlayerCompatibility, PFX + 'ComputeNewPlayerCompatibility', False);
  Bind(FFlat.SendUserConnectAndAuthenticate_DEPRECATED, PFX + 'SendUserConnectAndAuthenticate_DEPRECATED', False);
  Bind(FFlat.CreateUnauthenticatedUserConnection, PFX + 'CreateUnauthenticatedUserConnection', False);
  Bind(FFlat.SendUserDisconnect_DEPRECATED, PFX + 'SendUserDisconnect_DEPRECATED', False);
  Bind(FFlat.BUpdateUserData, PFX + 'BUpdateUserData', False);
  Missing := '';
  if not Assigned(FFlat.SetProduct) then Missing := Missing + ' SetProduct';
  if not Assigned(FFlat.SetGameDescription) then Missing := Missing + ' SetGameDescription';
  if not Assigned(FFlat.SetModDir) then Missing := Missing + ' SetModDir';
  if not Assigned(FFlat.SetDedicatedServer) then Missing := Missing + ' SetDedicatedServer';
  if not Assigned(FFlat.LogOn) then Missing := Missing + ' LogOn';
  if not Assigned(FFlat.LogOnAnonymous) then Missing := Missing + ' LogOnAnonymous';
  if not Assigned(FFlat.LogOff) then Missing := Missing + ' LogOff';
  if not Assigned(FFlat.BLoggedOn) then Missing := Missing + ' BLoggedOn';
  if not Assigned(FFlat.BSecure) then Missing := Missing + ' BSecure';
  if not Assigned(FFlat.GetSteamID) then Missing := Missing + ' GetSteamID';
  if not Assigned(FFlat.WasRestartRequested) then Missing := Missing + ' WasRestartRequested';
  if not Assigned(FFlat.SetMaxPlayerCount) then Missing := Missing + ' SetMaxPlayerCount';
  if not Assigned(FFlat.SetBotPlayerCount) then Missing := Missing + ' SetBotPlayerCount';
  if not Assigned(FFlat.SetServerName) then Missing := Missing + ' SetServerName';
  if not Assigned(FFlat.SetMapName) then Missing := Missing + ' SetMapName';
  if not Assigned(FFlat.SetPasswordProtected) then Missing := Missing + ' SetPasswordProtected';
  if not Assigned(FFlat.SetSpectatorPort) then Missing := Missing + ' SetSpectatorPort';
  if not Assigned(FFlat.SetSpectatorServerName) then Missing := Missing + ' SetSpectatorServerName';
  if not Assigned(FFlat.ClearAllKeyValues) then Missing := Missing + ' ClearAllKeyValues';
  if not Assigned(FFlat.SetKeyValue) then Missing := Missing + ' SetKeyValue';
  if not Assigned(FFlat.SetGameTags) then Missing := Missing + ' SetGameTags';
  if not Assigned(FFlat.SetGameData) then Missing := Missing + ' SetGameData';
  if not Assigned(FFlat.SetRegion) then Missing := Missing + ' SetRegion';
  if not Assigned(FFlat.SetAdvertiseServerActive) then Missing := Missing + ' SetAdvertiseServerActive';
  if not Assigned(FFlat.GetAuthSessionTicket) then Missing := Missing + ' GetAuthSessionTicket';
  if not Assigned(FFlat.BeginAuthSession) then Missing := Missing + ' BeginAuthSession';
  if not Assigned(FFlat.EndAuthSession) then Missing := Missing + ' EndAuthSession';
  if not Assigned(FFlat.CancelAuthTicket) then Missing := Missing + ' CancelAuthTicket';
  if not Assigned(FFlat.UserHasLicenseForApp) then Missing := Missing + ' UserHasLicenseForApp';
  if not Assigned(FFlat.RequestUserGroupStatus) then Missing := Missing + ' RequestUserGroupStatus';
  if not Assigned(FFlat.GetGameplayStats) then Missing := Missing + ' GetGameplayStats';
  if not Assigned(FFlat.GetServerReputation) then Missing := Missing + ' GetServerReputation';
  if not Assigned(FFlat.HandleIncomingPacket) then Missing := Missing + ' HandleIncomingPacket';
  if not Assigned(FFlat.GetNextOutgoingPacket) then Missing := Missing + ' GetNextOutgoingPacket';
  if not Assigned(FFlat.AssociateWithClan) then Missing := Missing + ' AssociateWithClan';
  if not Assigned(FFlat.ComputeNewPlayerCompatibility) then Missing := Missing + ' ComputeNewPlayerCompatibility';
  if not Assigned(FFlat.SendUserConnectAndAuthenticate_DEPRECATED) then Missing := Missing + ' SendUserConnectAndAuthenticate_DEPRECATED';
  if not Assigned(FFlat.CreateUnauthenticatedUserConnection) then Missing := Missing + ' CreateUnauthenticatedUserConnection';
  if not Assigned(FFlat.SendUserDisconnect_DEPRECATED) then Missing := Missing + ' SendUserDisconnect_DEPRECATED';
  if not Assigned(FFlat.BUpdateUserData) then Missing := Missing + ' BUpdateUserData';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  F_GetPublicIP := nil;
  Bind(F_GetPublicIP, PFX + 'GetPublicIP', False);
  Result := True;
end;

procedure TSteamGameServerPlugin.DoFinalize;
begin
  F_GetPublicIP := nil;
  FIntf := nil;
  FFlat := Default(TSteamGameServerFlat);
end;

procedure TSteamGameServerPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamGameServer.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamGameServer.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

