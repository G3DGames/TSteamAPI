function TSteamGameServerPlugin.BUpdateUserData(const steamIDUser: TSteamID; const pchPlayerName: string; uScore: UInt32): Boolean;
var
  U_pchPlayerName: UTF8String;
begin
  Need(Assigned(FFlat.BUpdateUserData), 'BUpdateUserData');
  U_pchPlayerName := UTF8String(pchPlayerName);
  Result := FFlat.BUpdateUserData(FIntf, steamIDUser.Value, PAnsiChar(U_pchPlayerName), uScore);
end;

function TSteamGameServerPlugin.GetPublicIP: SteamIPAddress_t;
begin
  Need(Assigned(F_GetPublicIP), 'GetPublicIP');
  // same test as the TSteamGameServerPublicIPFn declarations
{$if defined(STEAMWORKS_WINDOWS) or not (defined(STEAMWORKS_CPUARM64) or defined(STEAMWORKS_CPU386))}
  FillChar(Result, SizeOf(Result), 0);
  F_GetPublicIP(@Result, FIntf);
{$else}
  Result := F_GetPublicIP(FIntf);
{$endif}
end;

function TSteamGameServerPlugin.PublicIPv4: UInt32;
var
  A: SteamIPAddress_t;
begin
  A := GetPublicIP;
  if A.m_eType = k_ESteamIPTypeIPv4 then
    Result := A.m_unIPv4
  else
    Result := 0;
end;

{ TSteamGameServer }

function TSteamGameServer.GetPlugin: TSteamGameServerPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamGameServerPlugin(TSteamworks.Instance.FindPlugin(PluginClass));
end;

class function TSteamGameServer.PluginClass: TSteamPluginClass;
begin
  Result := TSteamGameServerPlugin;
end;

class function TSteamGameServer.IsGameServer: Boolean;
begin
  Result := True;
end;

procedure TSteamGameServer.DoAttach;
begin
  SubscribeCallback(SteamServersConnected_t_k_iCallback, HandleSteamServersConnected);
  SubscribeCallback(SteamServerConnectFailure_t_k_iCallback, HandleSteamServerConnectFailure);
  SubscribeCallback(SteamServersDisconnected_t_k_iCallback, HandleSteamServersDisconnected);
  SubscribeCallback(GSPolicyResponse_t_k_iCallback, HandleGSPolicyResponse);
  SubscribeCallback(ValidateAuthTicketResponse_t_k_iCallback, HandleValidateAuthTicketResponse);
  SubscribeCallback(GSClientApprove_t_k_iCallback, HandleGSClientApprove);
  SubscribeCallback(GSClientDeny_t_k_iCallback, HandleGSClientDeny);
  SubscribeCallback(GSClientKick_t_k_iCallback, HandleGSClientKick);
  SubscribeCallback(GSClientAchievementStatus_t_k_iCallback, HandleGSClientAchievementStatus);
  SubscribeCallback(GSGameplayStats_t_k_iCallback, HandleGSGameplayStats);
  SubscribeCallback(GSClientGroupStatus_t_k_iCallback, HandleGSClientGroupStatus);
  SubscribeCallback(GSReputation_t_k_iCallback, HandleGSReputation);
  SubscribeCallback(AssociateWithClanResult_t_k_iCallback, HandleAssociateWithClanResult);
  SubscribeCallback(ComputeNewPlayerCompatibilityResult_t_k_iCallback, HandleComputeNewPlayerCompatibilityResult);
end;

procedure TSteamGameServer.HandleSteamServersConnected(const AData: TSteamCallbackData);
var
  Ev: SteamServersConnected_t;
begin
  if not Assigned(FOnSteamServersConnected) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamServersConnected_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamServersConnected(Self, Ev);
end;

