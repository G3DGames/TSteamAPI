procedure TSteamGameServerPlugin.SendUserDisconnect_DEPRECATED(const steamIDUser: TSteamID);
begin
  Need(Assigned(FFlat.SendUserDisconnect_DEPRECATED), 'SendUserDisconnect_DEPRECATED');
  FFlat.SendUserDisconnect_DEPRECATED(FIntf, steamIDUser.Value);
