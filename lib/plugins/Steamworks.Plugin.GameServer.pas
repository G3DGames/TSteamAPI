    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The plug-in class @link(Plugin) looks up: @link(TSteamGameServerPlugin) (a game-server copy
      of this component returns its own subclass). }
    class function PluginClass: TSteamPluginClass; virtual;
    { @true: attaches while the game server runs (TSteamAPI.StartGameServer). }
    class function IsGameServer: Boolean; override;
    { The ISteamGameServer plug-in, for calls; @nil while the game server is not running. }
    property Plugin: TSteamGameServerPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 101 (SteamServersConnected_t): Called when an authenticated connection to the Steam
      back-end has been established. This means the Steam client now has a working connection to
      the Steam servers. Usually this will have occurred before the game has launched, and should
      only be seen if the user has dropped connection due to a networking issue or a Steam server
      update. }
    property OnSteamServersConnected: TSteamServersConnectedEvent read FOnSteamServersConnected write FOnSteamServersConnected;
    { Callback 102 (SteamServerConnectFailure_t): called when a connection attempt has failed this
      will occur periodically if the Steam client is not connected, and has failed in it's retry
      to establish a connection. }
    property OnSteamServerConnectFailure: TSteamServerConnectFailureEvent read FOnSteamServerConnectFailure write FOnSteamServerConnectFailure;
    { Callback 103 (SteamServersDisconnected_t): called if the client has lost connection to the
      Steam servers real-time services will be disabled until a matching SteamServersConnected_t
      has been posted. }
    property OnSteamServersDisconnected: TSteamServersDisconnectedEvent read FOnSteamServersDisconnected write FOnSteamServersDisconnected;
    { Callback 115 (GSPolicyResponse_t): received when the game server requests to be displayed as
      secure (VAC protected) m_bSecure is true if the game server should display itself as secure
      to users, false otherwise. }
    property OnGSPolicyResponse: TGSPolicyResponseEvent read FOnGSPolicyResponse write FOnGSPolicyResponse;
    { Callback 143 (ValidateAuthTicketResponse_t): callback for BeginAuthSession. }
    property OnValidateAuthTicketResponse: TValidateAuthTicketResponseEvent read FOnValidateAuthTicketResponse write FOnValidateAuthTicketResponse;
    { Callback 201 (GSClientApprove_t): client has been approved to connect to this game server. }
    property OnGSClientApprove: TGSClientApproveEvent read FOnGSClientApprove write FOnGSClientApprove;
    { Callback 202 (GSClientDeny_t): client has been denied to connection to this game server. }
    property OnGSClientDeny: TGSClientDenyEvent read FOnGSClientDeny write FOnGSClientDeny;
    { Callback 203 (GSClientKick_t): request the game server should kick the user. }
    property OnGSClientKick: TGSClientKickEvent read FOnGSClientKick write FOnGSClientKick;
    { Callback 206 (GSClientAchievementStatus_t): client achievement info. }
    property OnGSClientAchievementStatus: TGSClientAchievementStatusEvent read FOnGSClientAchievementStatus write FOnGSClientAchievementStatus;
    { Callback 207 (GSGameplayStats_t): GS gameplay stats info. }
    property OnGSGameplayStats: TGSGameplayStatsEvent read FOnGSGameplayStats write FOnGSGameplayStats;
    { Callback 208 (GSClientGroupStatus_t): send as a reply to RequestUserGroupStatus(). }
    property OnGSClientGroupStatus: TGSClientGroupStatusEvent read FOnGSClientGroupStatus write FOnGSClientGroupStatus;
    { Callback 209 (GSReputation_t): Sent as a reply to GetServerReputation(). }
    property OnGSReputation: TGSReputationEvent read FOnGSReputation write FOnGSReputation;
    { Callback 210 (AssociateWithClanResult_t): Sent as a reply to AssociateWithClan(). }
    property OnAssociateWithClanResult: TAssociateWithClanResultEvent read FOnAssociateWithClanResult write FOnAssociateWithClanResult;
    { Callback 211 (ComputeNewPlayerCompatibilityResult_t): Sent as a reply to
      ComputeNewPlayerCompatibility(). }
    property OnComputeNewPlayerCompatibilityResult: TComputeNewPlayerCompatibilityResultEvent read FOnComputeNewPlayerCompatibilityResult write FOnComputeNewPlayerCompatibilityResult;
  end;

