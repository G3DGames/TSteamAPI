function TSteamGameServerPlugin.SendUserConnectAndAuthenticate_DEPRECATED(unIPClient: UInt32; pvAuthBlob: Pointer; cubAuthBlobSize: UInt32; var pSteamIDUser: TSteamID): Boolean;
begin
  Need(Assigned(FFlat.SendUserConnectAndAuthenticate_DEPRECATED), 'SendUserConnectAndAuthenticate_DEPRECATED');
