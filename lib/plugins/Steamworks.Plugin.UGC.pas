procedure TSteamUGCPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamUGCFlat);
end;

procedure TSteamUGCPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamUGC.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamUGC.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

