function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamUGCPlugin }

class function TSteamUGCPlugin.PluginName: string;
begin
  Result := 'ISteamUGC';
end;

class function TSteamUGCPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMUGC_INTERFACE_VERSION);
end;

