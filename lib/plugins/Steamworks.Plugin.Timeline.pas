  Need(Assigned(FFlat.EndGamePhase), 'EndGamePhase');
  FFlat.EndGamePhase(FIntf);
end;

procedure TSteamTimelinePlugin.SetGamePhaseID(const pchPhaseID: string);
var
  U_pchPhaseID: UTF8String;
begin
  Need(Assigned(FFlat.SetGamePhaseID), 'SetGamePhaseID');
  U_pchPhaseID := UTF8String(pchPhaseID);
  FFlat.SetGamePhaseID(FIntf, PAnsiChar(U_pchPhaseID));
end;

function TSteamTimelinePlugin.DoesGamePhaseRecordingExist(const pchPhaseID: string): SteamAPICall_t;
var
  U_pchPhaseID: UTF8String;
begin
  Need(Assigned(FFlat.DoesGamePhaseRecordingExist), 'DoesGamePhaseRecordingExist');
  U_pchPhaseID := UTF8String(pchPhaseID);
  Result := FFlat.DoesGamePhaseRecordingExist(FIntf, PAnsiChar(U_pchPhaseID));
end;

function TSteamTimelinePlugin.DoesGamePhaseRecordingExistAsync(const pchPhaseID: string; AHandler: TSteamCallResultEvent): SteamAPICall_t;
begin
  Result := DoesGamePhaseRecordingExist(pchPhaseID);
  if Result <> k_uAPICallInvalid then
    Steam.Dispatcher.AwaitCallResult(Result, SteamTimelineGamePhaseRecordingExists_t_k_iCallback, AHandler);
end;

