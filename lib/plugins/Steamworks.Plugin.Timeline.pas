{ TSteamTimeline }

function TSteamTimeline.GetPlugin: TSteamTimelinePlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamTimelinePlugin(TSteamworks.Instance.FindPlugin(TSteamTimelinePlugin));
end;

procedure TSteamTimeline.DoAttach;
begin
  SubscribeCallback(SteamTimelineGamePhaseRecordingExists_t_k_iCallback, HandleSteamTimelineGamePhaseRecordingExists);
  SubscribeCallback(SteamTimelineEventRecordingExists_t_k_iCallback, HandleSteamTimelineEventRecordingExists);
end;

procedure TSteamTimeline.HandleSteamTimelineGamePhaseRecordingExists(const AData: TSteamCallbackData);
var
  Ev: SteamTimelineGamePhaseRecordingExists_t;
begin
  if not Assigned(FOnSteamTimelineGamePhaseRecordingExists) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamTimelineGamePhaseRecordingExists_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamTimelineGamePhaseRecordingExists(Self, Ev);
end;

procedure TSteamTimeline.HandleSteamTimelineEventRecordingExists(const AData: TSteamCallbackData);
var
  Ev: SteamTimelineEventRecordingExists_t;
begin
  if not Assigned(FOnSteamTimelineEventRecordingExists) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamTimelineEventRecordingExists_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamTimelineEventRecordingExists(Self, Ev);
end;

initialization
  TSteamworks.RegisterPlugin(TSteamTimelinePlugin);

finalization
  TSteamworks.UnregisterPlugin(TSteamTimelinePlugin);

end.
