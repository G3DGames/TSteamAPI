    property Plugin: TSteamNetworkingPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 1201 (SocketStatusCallback_t): callback notification - status of a socket has
      changed used as part of the CreateListenSocket() / CreateP2PConnectionSocket(). }
    property OnSocketStatusCallback: TSocketStatusCallbackEvent read FOnSocketStatusCallback write FOnSocketStatusCallback;
    { Callback 1202 (P2PSessionRequest_t): callback notification - a user wants to talk to us over
      the P2P channel via the SendP2PPacket() API in response, a call to
      AcceptP2PPacketsFromUser() needs to be made, if you want to talk with them. }
    property OnP2PSessionRequest: TP2PSessionRequestEvent read FOnP2PSessionRequest write FOnP2PSessionRequest;
    { Callback 1203 (P2PSessionConnectFail_t): callback notification - packets can't get through
      to the specified user via the SendP2PPacket() API all packets queued packets unsent at this
