{ TSteamNetworking }

function TSteamNetworking.GetPlugin: TSteamNetworkingPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamNetworkingPlugin(TSteamworks.Instance.FindPlugin(PluginClass));
end;

class function TSteamNetworking.PluginClass: TSteamPluginClass;
begin
  Result := TSteamNetworkingPlugin;
end;

procedure TSteamNetworking.DoAttach;
begin
  SubscribeCallback(SocketStatusCallback_t_k_iCallback, HandleSocketStatusCallback);
  SubscribeCallback(P2PSessionRequest_t_k_iCallback, HandleP2PSessionRequest);
  SubscribeCallback(P2PSessionConnectFail_t_k_iCallback, HandleP2PSessionConnectFail);
end;

procedure TSteamNetworking.HandleSocketStatusCallback(const AData: TSteamCallbackData);
var
  Ev: SocketStatusCallback_t;
begin
  if not Assigned(FOnSocketStatusCallback) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SocketStatusCallback_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSocketStatusCallback(Self, Ev);
end;

procedure TSteamNetworking.HandleP2PSessionRequest(const AData: TSteamCallbackData);
var
  Ev: P2PSessionRequest_t;
begin
  if not Assigned(FOnP2PSessionRequest) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'P2PSessionRequest_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnP2PSessionRequest(Self, Ev);
end;

procedure TSteamNetworking.HandleP2PSessionConnectFail(const AData: TSteamCallbackData);
var
  Ev: P2PSessionConnectFail_t;
begin
  if not Assigned(FOnP2PSessionConnectFail) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'P2PSessionConnectFail_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnP2PSessionConnectFail(Self, Ev);
end;

