function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamNetworkingPlugin }

class function TSteamNetworkingPlugin.PluginName: string;
begin
  Result := 'ISteamNetworking';
end;

class function TSteamNetworkingPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMNETWORKING_INTERFACE_VERSION);
end;

function TSteamNetworkingPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMNETWORKING_INTERFACE_VERSION, 'SteamNetworking');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamNetworkingFlat);
  Bind(FFlat.SendP2PPacket, PFX + 'SendP2PPacket', False);
  Bind(FFlat.IsP2PPacketAvailable, PFX + 'IsP2PPacketAvailable', False);
  Bind(FFlat.ReadP2PPacket, PFX + 'ReadP2PPacket', False);
  Bind(FFlat.AcceptP2PSessionWithUser, PFX + 'AcceptP2PSessionWithUser', False);
  Bind(FFlat.CloseP2PSessionWithUser, PFX + 'CloseP2PSessionWithUser', False);
  Bind(FFlat.CloseP2PChannelWithUser, PFX + 'CloseP2PChannelWithUser', False);
  Bind(FFlat.GetP2PSessionState, PFX + 'GetP2PSessionState', False);
  Bind(FFlat.AllowP2PPacketRelay, PFX + 'AllowP2PPacketRelay', False);
  Bind(FFlat.CreateP2PConnectionSocket, PFX + 'CreateP2PConnectionSocket', False);
  Bind(FFlat.DestroySocket, PFX + 'DestroySocket', False);
  Bind(FFlat.DestroyListenSocket, PFX + 'DestroyListenSocket', False);
  Bind(FFlat.SendDataOnSocket, PFX + 'SendDataOnSocket', False);
  Bind(FFlat.IsDataAvailableOnSocket, PFX + 'IsDataAvailableOnSocket', False);
  Bind(FFlat.RetrieveDataFromSocket, PFX + 'RetrieveDataFromSocket', False);
  Bind(FFlat.IsDataAvailable, PFX + 'IsDataAvailable', False);
  Bind(FFlat.RetrieveData, PFX + 'RetrieveData', False);
  Bind(FFlat.GetSocketInfo, PFX + 'GetSocketInfo', False);
  Bind(FFlat.GetListenSocketInfo, PFX + 'GetListenSocketInfo', False);
  Bind(FFlat.GetSocketConnectionType, PFX + 'GetSocketConnectionType', False);
  Bind(FFlat.GetMaxPacketSize, PFX + 'GetMaxPacketSize', False);
  Missing := '';
  if not Assigned(FFlat.SendP2PPacket) then Missing := Missing + ' SendP2PPacket';
  if not Assigned(FFlat.IsP2PPacketAvailable) then Missing := Missing + ' IsP2PPacketAvailable';
  if not Assigned(FFlat.ReadP2PPacket) then Missing := Missing + ' ReadP2PPacket';
  if not Assigned(FFlat.AcceptP2PSessionWithUser) then Missing := Missing + ' AcceptP2PSessionWithUser';
  if not Assigned(FFlat.CloseP2PSessionWithUser) then Missing := Missing + ' CloseP2PSessionWithUser';
  if not Assigned(FFlat.CloseP2PChannelWithUser) then Missing := Missing + ' CloseP2PChannelWithUser';
  if not Assigned(FFlat.GetP2PSessionState) then Missing := Missing + ' GetP2PSessionState';
  if not Assigned(FFlat.AllowP2PPacketRelay) then Missing := Missing + ' AllowP2PPacketRelay';
  if not Assigned(FFlat.CreateP2PConnectionSocket) then Missing := Missing + ' CreateP2PConnectionSocket';
  if not Assigned(FFlat.DestroySocket) then Missing := Missing + ' DestroySocket';
  if not Assigned(FFlat.DestroyListenSocket) then Missing := Missing + ' DestroyListenSocket';
  if not Assigned(FFlat.SendDataOnSocket) then Missing := Missing + ' SendDataOnSocket';
  if not Assigned(FFlat.IsDataAvailableOnSocket) then Missing := Missing + ' IsDataAvailableOnSocket';
  if not Assigned(FFlat.RetrieveDataFromSocket) then Missing := Missing + ' RetrieveDataFromSocket';
  if not Assigned(FFlat.IsDataAvailable) then Missing := Missing + ' IsDataAvailable';
  if not Assigned(FFlat.RetrieveData) then Missing := Missing + ' RetrieveData';
  if not Assigned(FFlat.GetSocketInfo) then Missing := Missing + ' GetSocketInfo';
  if not Assigned(FFlat.GetListenSocketInfo) then Missing := Missing + ' GetListenSocketInfo';
  if not Assigned(FFlat.GetSocketConnectionType) then Missing := Missing + ' GetSocketConnectionType';
  if not Assigned(FFlat.GetMaxPacketSize) then Missing := Missing + ' GetMaxPacketSize';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamNetworkingPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamNetworkingFlat);
end;

procedure TSteamNetworkingPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamNetworking.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamNetworking.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

function TSteamNetworkingPlugin.SendP2PPacket(const steamIDRemote: TSteamID; pubData: Pointer; cubData: UInt32; eP2PSendType: EP2PSend; nChannel: Integer): Boolean;
begin
  Need(Assigned(FFlat.SendP2PPacket), 'SendP2PPacket');
  Result := FFlat.SendP2PPacket(FIntf, steamIDRemote.Value, pubData, cubData, eP2PSendType, nChannel);
end;

function TSteamNetworkingPlugin.IsP2PPacketAvailable(var pcubMsgSize: UInt32; nChannel: Integer): Boolean;
begin
  Need(Assigned(FFlat.IsP2PPacketAvailable), 'IsP2PPacketAvailable');
  Result := FFlat.IsP2PPacketAvailable(FIntf, @pcubMsgSize, nChannel);
end;

function TSteamNetworkingPlugin.ReadP2PPacket(pubDest: Pointer; cubDest: UInt32; var pcubMsgSize: UInt32; var psteamIDRemote: TSteamID; nChannel: Integer): Boolean;
begin
  Need(Assigned(FFlat.ReadP2PPacket), 'ReadP2PPacket');
  Result := FFlat.ReadP2PPacket(FIntf, pubDest, cubDest, @pcubMsgSize, @psteamIDRemote, nChannel);
end;

