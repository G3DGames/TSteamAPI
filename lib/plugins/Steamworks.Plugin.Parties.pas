  Bind(FFlat.JoinParty, PFX + 'JoinParty', False);
  Bind(FFlat.GetNumAvailableBeaconLocations, PFX + 'GetNumAvailableBeaconLocations', False);
  Bind(FFlat.GetAvailableBeaconLocations, PFX + 'GetAvailableBeaconLocations', False);
  Bind(FFlat.CreateBeacon, PFX + 'CreateBeacon', False);
  Bind(FFlat.OnReservationCompleted, PFX + 'OnReservationCompleted', False);
  Bind(FFlat.CancelReservation, PFX + 'CancelReservation', False);
  Bind(FFlat.ChangeNumOpenSlots, PFX + 'ChangeNumOpenSlots', False);
  Bind(FFlat.DestroyBeacon, PFX + 'DestroyBeacon', False);
  Missing := '';
  if not Assigned(FFlat.GetNumActiveBeacons) then Missing := Missing + ' GetNumActiveBeacons';
  if not Assigned(FFlat.GetBeaconByIndex) then Missing := Missing + ' GetBeaconByIndex';
  if not Assigned(FFlat.GetBeaconDetails) then Missing := Missing + ' GetBeaconDetails';
  if not Assigned(FFlat.JoinParty) then Missing := Missing + ' JoinParty';
  if not Assigned(FFlat.GetNumAvailableBeaconLocations) then Missing := Missing + ' GetNumAvailableBeaconLocations';
  if not Assigned(FFlat.GetAvailableBeaconLocations) then Missing := Missing + ' GetAvailableBeaconLocations';
  if not Assigned(FFlat.CreateBeacon) then Missing := Missing + ' CreateBeacon';
  if not Assigned(FFlat.OnReservationCompleted) then Missing := Missing + ' OnReservationCompleted';
  if not Assigned(FFlat.CancelReservation) then Missing := Missing + ' CancelReservation';
  if not Assigned(FFlat.ChangeNumOpenSlots) then Missing := Missing + ' ChangeNumOpenSlots';
  if not Assigned(FFlat.DestroyBeacon) then Missing := Missing + ' DestroyBeacon';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

