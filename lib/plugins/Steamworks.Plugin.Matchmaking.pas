  if not Assigned(FFlat.SetLinkedLobby) then Missing := Missing + ' SetLinkedLobby';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

procedure TSteamMatchmakingPlugin.DoFinalize;
begin
  FIntf := nil;
  FFlat := Default(TSteamMatchmakingFlat);
end;

procedure TSteamMatchmakingPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamMatchmaking.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamMatchmaking.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

