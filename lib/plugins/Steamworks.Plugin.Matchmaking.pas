  if not Assigned(FFlat.GetLobbyDataCount) then Missing := Missing + ' GetLobbyDataCount';
  if not Assigned(FFlat.GetLobbyDataByIndex) then Missing := Missing + ' GetLobbyDataByIndex';
  if not Assigned(FFlat.DeleteLobbyData) then Missing := Missing + ' DeleteLobbyData';
  if not Assigned(FFlat.GetLobbyMemberData) then Missing := Missing + ' GetLobbyMemberData';
  if not Assigned(FFlat.SetLobbyMemberData) then Missing := Missing + ' SetLobbyMemberData';
