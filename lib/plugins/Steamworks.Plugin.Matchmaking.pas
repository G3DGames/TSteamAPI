function TSteamMatchmaking.GetPlugin: TSteamMatchmakingPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamMatchmakingPlugin(TSteamworks.Instance.FindPlugin(TSteamMatchmakingPlugin));
end;

procedure TSteamMatchmaking.DoAttach;
begin
  SubscribeCallback(FavoritesListChanged_t_k_iCallback, HandleFavoritesListChanged);
  SubscribeCallback(LobbyInvite_t_k_iCallback, HandleLobbyInvite);
  SubscribeCallback(LobbyEnter_t_k_iCallback, HandleLobbyEnter);
  SubscribeCallback(LobbyDataUpdate_t_k_iCallback, HandleLobbyDataUpdate);
  SubscribeCallback(LobbyChatUpdate_t_k_iCallback, HandleLobbyChatUpdate);
  SubscribeCallback(LobbyChatMsg_t_k_iCallback, HandleLobbyChatMsg);
  SubscribeCallback(LobbyGameCreated_t_k_iCallback, HandleLobbyGameCreated);
  SubscribeCallback(LobbyMatchList_t_k_iCallback, HandleLobbyMatchList);
  SubscribeCallback(LobbyKicked_t_k_iCallback, HandleLobbyKicked);
  SubscribeCallback(LobbyCreated_t_k_iCallback, HandleLobbyCreated);
  SubscribeCallback(FavoritesListAccountsUpdated_t_k_iCallback, HandleFavoritesListAccountsUpdated);
end;

procedure TSteamMatchmaking.HandleFavoritesListChanged(const AData: TSteamCallbackData);
var
  Ev: FavoritesListChanged_t;
begin
  if not Assigned(FOnFavoritesListChanged) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'FavoritesListChanged_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnFavoritesListChanged(Self, Ev);
end;

