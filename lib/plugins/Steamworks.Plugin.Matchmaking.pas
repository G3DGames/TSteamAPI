function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamMatchmakingPlugin }

class function TSteamMatchmakingPlugin.PluginName: string;
begin
  Result := 'ISteamMatchmaking';
