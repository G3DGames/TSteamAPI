    { Raises @link(OnLobbyChatUpdate) for LobbyChatUpdate_t. }
    procedure HandleLobbyChatUpdate(const AData: TSteamCallbackData);
    { Raises @link(OnLobbyChatMsg) for LobbyChatMsg_t. }
    procedure HandleLobbyChatMsg(const AData: TSteamCallbackData);
    { Raises @link(OnLobbyGameCreated) for LobbyGameCreated_t. }
    procedure HandleLobbyGameCreated(const AData: TSteamCallbackData);
    { Raises @link(OnLobbyMatchList) for LobbyMatchList_t. }
    procedure HandleLobbyMatchList(const AData: TSteamCallbackData);
    { Raises @link(OnLobbyKicked) for LobbyKicked_t. }
    procedure HandleLobbyKicked(const AData: TSteamCallbackData);
    { Raises @link(OnLobbyCreated) for LobbyCreated_t. }
    procedure HandleLobbyCreated(const AData: TSteamCallbackData);
    { Raises @link(OnFavoritesListAccountsUpdated) for FavoritesListAccountsUpdated_t. }
    procedure HandleFavoritesListAccountsUpdated(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamMatchmaking plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamMatchmakingPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 502 (FavoritesListChanged_t): a server was added/removed from the favorites list,
      you should refresh now. }
    property OnFavoritesListChanged: TFavoritesListChangedEvent read FOnFavoritesListChanged write FOnFavoritesListChanged;
    { Callback 503 (LobbyInvite_t): Someone has invited you to join a Lobby normally you don't
      need to do anything with this, since the Steam UI will also display a '<user> has invited
      you to the lobby, join?' dialog if the user outside a game chooses to join, your game will
      be launched with the parameter "+connect_lobby <64-bit lobby id>", or with the callback
      GameLobbyJoinRequested_t if they're already in-game. }
    property OnLobbyInvite: TLobbyInviteEvent read FOnLobbyInvite write FOnLobbyInvite;
    { Callback 504 (LobbyEnter_t): Sent on entering a lobby, or on failing to enter
      m_EChatRoomEnterResponse will be set to k_EChatRoomEnterResponseSuccess on success, or a
      higher value on failure (see enum EChatRoomEnterResponse). }
    property OnLobbyEnter: TLobbyEnterEvent read FOnLobbyEnter write FOnLobbyEnter;
    { Callback 505 (LobbyDataUpdate_t): The lobby metadata has changed if m_ulSteamIDMember is the
      steamID of a lobby member, use GetLobbyMemberData() to access per-user details if
      m_ulSteamIDMember == m_ulSteamIDLobby, use GetLobbyData() to access lobby metadata. }
    property OnLobbyDataUpdate: TLobbyDataUpdateEvent read FOnLobbyDataUpdate write FOnLobbyDataUpdate;
    { Callback 506 (LobbyChatUpdate_t): The lobby chat room state has changed this is usually sent
      when a user has joined or left the lobby. }
    property OnLobbyChatUpdate: TLobbyChatUpdateEvent read FOnLobbyChatUpdate write FOnLobbyChatUpdate;
    { Callback 507 (LobbyChatMsg_t): A chat message for this lobby has been sent use
      GetLobbyChatEntry( m_iChatID ) to retrieve the contents of this message. }
    property OnLobbyChatMsg: TLobbyChatMsgEvent read FOnLobbyChatMsg write FOnLobbyChatMsg;
    { Callback 509 (LobbyGameCreated_t): A game created a game for all the members of the lobby to
      join, as triggered by a SetLobbyGameServer() it's up to the individual clients to take
      action on this; the usual game behavior is to leave the lobby and connect to the specified
      game server. }
    property OnLobbyGameCreated: TLobbyGameCreatedEvent read FOnLobbyGameCreated write FOnLobbyGameCreated;
    { Callback 510 (LobbyMatchList_t): Number of matching lobbies found iterate the returned
      lobbies with GetLobbyByIndex(), from values 0 to m_nLobbiesMatching-1. }
    property OnLobbyMatchList: TLobbyMatchListEvent read FOnLobbyMatchList write FOnLobbyMatchList;
    { Callback 512 (LobbyKicked_t): posted if a user is forcefully removed from a lobby can occur
      if a user loses connection to Steam. }
    property OnLobbyKicked: TLobbyKickedEvent read FOnLobbyKicked write FOnLobbyKicked;
    { Callback 513 (LobbyCreated_t): Result of our request to create a Lobby m_eResult ==
      k_EResultOK on success at this point, the lobby has been joined and is ready for use a
      LobbyEnter_t callback will also be received (since the local user is joining their own
      lobby). }
    property OnLobbyCreated: TLobbyCreatedEvent read FOnLobbyCreated write FOnLobbyCreated;
    { Callback 516 (FavoritesListAccountsUpdated_t): Result of our request to create a Lobby
      m_eResult == k_EResultOK on success at this point, the lobby has been joined and is ready
      for use a LobbyEnter_t callback will also be received (since the local user is joining their
      own lobby). }
    property OnFavoritesListAccountsUpdated: TFavoritesListAccountsUpdatedEvent read FOnFavoritesListAccountsUpdated write FOnFavoritesListAccountsUpdated;
  end;

