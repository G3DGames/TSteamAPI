function TSteamInput.GetPlugin: TSteamInputPlugin;
begin
  Result := nil;
  if TSteamworks.HasInstance then
    Result := TSteamInputPlugin(TSteamworks.Instance.FindPlugin(TSteamInputPlugin));
end;

procedure TSteamInput.DoAttach;
begin
  SubscribeCallback(SteamInputDeviceConnected_t_k_iCallback, HandleSteamInputDeviceConnected);
  SubscribeCallback(SteamInputDeviceDisconnected_t_k_iCallback, HandleSteamInputDeviceDisconnected);
  SubscribeCallback(SteamInputConfigurationLoaded_t_k_iCallback, HandleSteamInputConfigurationLoaded);
  SubscribeCallback(SteamInputGamepadSlotChange_t_k_iCallback, HandleSteamInputGamepadSlotChange);
end;

procedure TSteamInput.HandleSteamInputDeviceConnected(const AData: TSteamCallbackData);
var
  Ev: SteamInputDeviceConnected_t;
begin
  if not Assigned(FOnSteamInputDeviceConnected) then
    Exit;
  if not PayloadOK(AData, SizeOf(Ev), 'SteamInputDeviceConnected_t') then
    Exit;
  AData.CopyTo(Ev, SizeOf(Ev));
  FOnSteamInputDeviceConnected(Self, Ev);
end;

