    function GetDigitalActionData(inputHandle: InputHandle_t;
      digitalActionHandle: InputDigitalActionHandle_t): InputDigitalActionData_t;
    { Current state of an analog action (a stick, trigger or pad) on one
      controller: @code(x) / @code(y), @code(eMode) the source,
      @code(bActive) as for digital actions. Poll it every frame. }
    function GetAnalogActionData(inputHandle: InputHandle_t;
      analogActionHandle: InputAnalogActionHandle_t): InputAnalogActionData_t;
    { Raw gyro / accelerometer data of a controller that has them (rotation
      quaternion, acceleration, angular velocity); zeros otherwise. }
    function GetMotionData(inputHandle: InputHandle_t): InputMotionData_t;
    { Calls Init(AExplicitlyCallRunFrame) and remembers it, so the plug-in
      calls Shutdown when Steam shuts down (or on @link(Stop)). With @false
      (the default) Steam's callback pump runs RunFrame; with @true the game
      calls RunFrame itself before reading the actions each frame.
      @returns(@true when ISteamInput started.)
      @raises(ESteamworksError when the loaded library lacks the Init export.) }
    function Start(AExplicitlyCallRunFrame: Boolean = False): Boolean;
    { Calls Shutdown if @link(Start) succeeded; harmless otherwise. }
    procedure Stop;
    { Handles of the connected controllers (at most STEAM_INPUT_MAX_COUNT);
      empty until @link(Start) and the first RunFrame. }
    function ConnectedControllers: TSteamInputHandleArray;
    { The origins (buttons) bound to a digital action in an action set,
      for glyphs and "press X" texts (GetStringForActionOrigin). }
    function DigitalActionOrigins(inputHandle: InputHandle_t; actionSetHandle: InputActionSetHandle_t;
      digitalActionHandle: InputDigitalActionHandle_t): TSteamInputOriginArray;
    { The origins (sticks, triggers, pads) bound to an analog action. }
    function AnalogActionOrigins(inputHandle: InputHandle_t; actionSetHandle: InputActionSetHandle_t;
      analogActionHandle: InputAnalogActionHandle_t): TSteamInputOriginArray;
    { @true between a successful @link(Start) and @link(Stop). }
    property Started: Boolean read FStarted;

    { The raw ISteamInput pointer (first argument of every @link(Flat) export). }
    property Handle: Pointer read FIntf;
    { The bound flat exports, for calls the methods do not cover. }
    property Flat: TSteamInputFlat read FFlat;
  end;

  { Event of @link(TSteamInput.OnSteamInputDeviceConnected): callback 2801, payload
    @link(SteamInputDeviceConnected_t). }
  TSteamInputDeviceConnectedEvent = procedure(Sender: TObject; const AData: SteamInputDeviceConnected_t) of object;
  { Event of @link(TSteamInput.OnSteamInputDeviceDisconnected): callback 2802, payload
    @link(SteamInputDeviceDisconnected_t). }
  TSteamInputDeviceDisconnectedEvent = procedure(Sender: TObject; const AData: SteamInputDeviceDisconnected_t) of object;
  { Event of @link(TSteamInput.OnSteamInputConfigurationLoaded): callback 2803, payload
    @link(SteamInputConfigurationLoaded_t). }
  TSteamInputConfigurationLoadedEvent = procedure(Sender: TObject; const AData: SteamInputConfigurationLoaded_t) of object;
  { Event of @link(TSteamInput.OnSteamInputGamepadSlotChange): callback 2804, payload
    @link(SteamInputGamepadSlotChange_t). }
  TSteamInputGamepadSlotChangeEvent = procedure(Sender: TObject; const AData: SteamInputGamepadSlotChange_t) of object;

{$ifndef FPC}
  [ComponentPlatformsAttribute(STEAM_COMPONENT_PLATFORMS)]
{$endif}
  { ISteamInput component: drop it next to a TSteamAPI (linked automatically at run time when the
    owner has exactly one, otherwise set SteamAPI). Its events are the ISteamInput callbacks; call
    the interface through @link(Plugin). }
  TSteamInput = class(TSteamPluginComponent)
  private
    { Backing field of @link(OnSteamInputDeviceConnected). }
    FOnSteamInputDeviceConnected: TSteamInputDeviceConnectedEvent;
    { Backing field of @link(OnSteamInputDeviceDisconnected). }
    FOnSteamInputDeviceDisconnected: TSteamInputDeviceDisconnectedEvent;
    { Backing field of @link(OnSteamInputConfigurationLoaded). }
    FOnSteamInputConfigurationLoaded: TSteamInputConfigurationLoadedEvent;
    { Backing field of @link(OnSteamInputGamepadSlotChange). }
    FOnSteamInputGamepadSlotChange: TSteamInputGamepadSlotChangeEvent;
    { Read accessor of @link(Plugin). }
    function GetPlugin: TSteamInputPlugin;
    { Raises @link(OnSteamInputDeviceConnected) for SteamInputDeviceConnected_t. }
    procedure HandleSteamInputDeviceConnected(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInputDeviceDisconnected) for SteamInputDeviceDisconnected_t. }
    procedure HandleSteamInputDeviceDisconnected(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInputConfigurationLoaded) for SteamInputConfigurationLoaded_t. }
    procedure HandleSteamInputConfigurationLoaded(const AData: TSteamCallbackData);
    { Raises @link(OnSteamInputGamepadSlotChange) for SteamInputGamepadSlotChange_t. }
    procedure HandleSteamInputGamepadSlotChange(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamInput plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamInputPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 2801 (SteamInputDeviceConnected_t): called when a new controller has been
      connected, will fire once per controller if multiple new controllers connect in the same
      frame. }
    property OnSteamInputDeviceConnected: TSteamInputDeviceConnectedEvent read FOnSteamInputDeviceConnected write FOnSteamInputDeviceConnected;
    { Callback 2802 (SteamInputDeviceDisconnected_t): called when a new controller has been
      connected, will fire once per controller if multiple new controllers connect in the same
      frame. }
    property OnSteamInputDeviceDisconnected: TSteamInputDeviceDisconnectedEvent read FOnSteamInputDeviceDisconnected write FOnSteamInputDeviceDisconnected;
    { Callback 2803 (SteamInputConfigurationLoaded_t): called when a controller configuration has
      been loaded, will fire once per controller per focus change for Steam Input enabled
      controllers. }
    property OnSteamInputConfigurationLoaded: TSteamInputConfigurationLoadedEvent read FOnSteamInputConfigurationLoaded write FOnSteamInputConfigurationLoaded;
    { Callback 2804 (SteamInputGamepadSlotChange_t): called when controller gamepad slots change -
      on Linux/macOS these slots are shared for all running apps. }
    property OnSteamInputGamepadSlotChange: TSteamInputGamepadSlotChangeEvent read FOnSteamInputGamepadSlotChange write FOnSteamInputGamepadSlotChange;
  end;

implementation

const
  PFX = 'SteamAPI_ISteamInput_';

function PCharToStr(P: PAnsiChar): string;
begin
  if P = nil then
    Result := ''
  else
    Result := string(UTF8String(P));
end;

{ TSteamInputPlugin }

class function TSteamInputPlugin.PluginName: string;
begin
  Result := 'ISteamInput';
end;

class function TSteamInputPlugin.InterfaceVersions(AVersions: TSteamInterfaceVersions): TSteamStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AVersions.Resolve(STEAMINPUT_INTERFACE_VERSION);
end;

function TSteamInputPlugin.DoInitialize: Boolean;
var
  Missing: string;
begin
  FIntf := AcquireUserInterface(STEAMINPUT_INTERFACE_VERSION, 'SteamInput');
  if FIntf = nil then
    Exit(False);
  FFlat := Default(TSteamInputFlat);
  Bind(FFlat.Init, PFX + 'Init', False);
  Bind(FFlat.Shutdown, PFX + 'Shutdown', False);
  Bind(FFlat.SetInputActionManifestFilePath, PFX + 'SetInputActionManifestFilePath', False);
  Bind(FFlat.RunFrame, PFX + 'RunFrame', False);
  Bind(FFlat.BWaitForData, PFX + 'BWaitForData', False);
  Bind(FFlat.BNewDataAvailable, PFX + 'BNewDataAvailable', False);
  Bind(FFlat.GetConnectedControllers, PFX + 'GetConnectedControllers', False);
  Bind(FFlat.EnableDeviceCallbacks, PFX + 'EnableDeviceCallbacks', False);
  Bind(FFlat.EnableActionEventCallbacks, PFX + 'EnableActionEventCallbacks', False);
  Bind(FFlat.GetActionSetHandle, PFX + 'GetActionSetHandle', False);
  Bind(FFlat.ActivateActionSet, PFX + 'ActivateActionSet', False);
  Bind(FFlat.GetCurrentActionSet, PFX + 'GetCurrentActionSet', False);
  Bind(FFlat.ActivateActionSetLayer, PFX + 'ActivateActionSetLayer', False);
  Bind(FFlat.DeactivateActionSetLayer, PFX + 'DeactivateActionSetLayer', False);
  Bind(FFlat.DeactivateAllActionSetLayers, PFX + 'DeactivateAllActionSetLayers', False);
  Bind(FFlat.GetActiveActionSetLayers, PFX + 'GetActiveActionSetLayers', False);
  Bind(FFlat.GetDigitalActionHandle, PFX + 'GetDigitalActionHandle', False);
  Bind(FFlat.GetDigitalActionOrigins, PFX + 'GetDigitalActionOrigins', False);
  Bind(FFlat.GetStringForDigitalActionName, PFX + 'GetStringForDigitalActionName', False);
  Bind(FFlat.GetAnalogActionHandle, PFX + 'GetAnalogActionHandle', False);
  Bind(FFlat.GetAnalogActionOrigins, PFX + 'GetAnalogActionOrigins', False);
  Bind(FFlat.GetGlyphPNGForActionOrigin, PFX + 'GetGlyphPNGForActionOrigin', False);
  Bind(FFlat.GetGlyphSVGForActionOrigin, PFX + 'GetGlyphSVGForActionOrigin', False);
  Bind(FFlat.GetGlyphForActionOrigin_Legacy, PFX + 'GetGlyphForActionOrigin_Legacy', False);
  Bind(FFlat.GetStringForActionOrigin, PFX + 'GetStringForActionOrigin', False);
  Bind(FFlat.GetStringForAnalogActionName, PFX + 'GetStringForAnalogActionName', False);
  Bind(FFlat.StopAnalogActionMomentum, PFX + 'StopAnalogActionMomentum', False);
  Bind(FFlat.TriggerVibration, PFX + 'TriggerVibration', False);
  Bind(FFlat.TriggerVibrationExtended, PFX + 'TriggerVibrationExtended', False);
  Bind(FFlat.TriggerSimpleHapticEvent, PFX + 'TriggerSimpleHapticEvent', False);
  Bind(FFlat.SetLEDColor, PFX + 'SetLEDColor', False);
  Bind(FFlat.Legacy_TriggerHapticPulse, PFX + 'Legacy_TriggerHapticPulse', False);
  Bind(FFlat.Legacy_TriggerRepeatedHapticPulse, PFX + 'Legacy_TriggerRepeatedHapticPulse', False);
  Bind(FFlat.ShowBindingPanel, PFX + 'ShowBindingPanel', False);
  Bind(FFlat.GetInputTypeForHandle, PFX + 'GetInputTypeForHandle', False);
  Bind(FFlat.GetControllerForGamepadIndex, PFX + 'GetControllerForGamepadIndex', False);
  Bind(FFlat.GetGamepadIndexForController, PFX + 'GetGamepadIndexForController', False);
  Bind(FFlat.GetStringForXboxOrigin, PFX + 'GetStringForXboxOrigin', False);
  Bind(FFlat.GetGlyphForXboxOrigin, PFX + 'GetGlyphForXboxOrigin', False);
  Bind(FFlat.GetActionOriginFromXboxOrigin, PFX + 'GetActionOriginFromXboxOrigin', False);
  Bind(FFlat.TranslateActionOrigin, PFX + 'TranslateActionOrigin', False);
  Bind(FFlat.GetDeviceBindingRevision, PFX + 'GetDeviceBindingRevision', False);
  Bind(FFlat.GetRemotePlaySessionID, PFX + 'GetRemotePlaySessionID', False);
  Bind(FFlat.GetSessionInputConfigurationSettings, PFX + 'GetSessionInputConfigurationSettings', False);
  Bind(FFlat.SetDualSenseTriggerEffect, PFX + 'SetDualSenseTriggerEffect', False);
  Missing := '';
  if not Assigned(FFlat.Init) then Missing := Missing + ' Init';
  if not Assigned(FFlat.Shutdown) then Missing := Missing + ' Shutdown';
  if not Assigned(FFlat.SetInputActionManifestFilePath) then Missing := Missing + ' SetInputActionManifestFilePath';
  if not Assigned(FFlat.RunFrame) then Missing := Missing + ' RunFrame';
  if not Assigned(FFlat.BWaitForData) then Missing := Missing + ' BWaitForData';
  if not Assigned(FFlat.BNewDataAvailable) then Missing := Missing + ' BNewDataAvailable';
  if not Assigned(FFlat.GetConnectedControllers) then Missing := Missing + ' GetConnectedControllers';
  if not Assigned(FFlat.EnableDeviceCallbacks) then Missing := Missing + ' EnableDeviceCallbacks';
  if not Assigned(FFlat.EnableActionEventCallbacks) then Missing := Missing + ' EnableActionEventCallbacks';
  if not Assigned(FFlat.GetActionSetHandle) then Missing := Missing + ' GetActionSetHandle';
  if not Assigned(FFlat.ActivateActionSet) then Missing := Missing + ' ActivateActionSet';
  if not Assigned(FFlat.GetCurrentActionSet) then Missing := Missing + ' GetCurrentActionSet';
  if not Assigned(FFlat.ActivateActionSetLayer) then Missing := Missing + ' ActivateActionSetLayer';
  if not Assigned(FFlat.DeactivateActionSetLayer) then Missing := Missing + ' DeactivateActionSetLayer';
  if not Assigned(FFlat.DeactivateAllActionSetLayers) then Missing := Missing + ' DeactivateAllActionSetLayers';
  if not Assigned(FFlat.GetActiveActionSetLayers) then Missing := Missing + ' GetActiveActionSetLayers';
  if not Assigned(FFlat.GetDigitalActionHandle) then Missing := Missing + ' GetDigitalActionHandle';
  if not Assigned(FFlat.GetDigitalActionOrigins) then Missing := Missing + ' GetDigitalActionOrigins';
  if not Assigned(FFlat.GetStringForDigitalActionName) then Missing := Missing + ' GetStringForDigitalActionName';
  if not Assigned(FFlat.GetAnalogActionHandle) then Missing := Missing + ' GetAnalogActionHandle';
  if not Assigned(FFlat.GetAnalogActionOrigins) then Missing := Missing + ' GetAnalogActionOrigins';
  if not Assigned(FFlat.GetGlyphPNGForActionOrigin) then Missing := Missing + ' GetGlyphPNGForActionOrigin';
  if not Assigned(FFlat.GetGlyphSVGForActionOrigin) then Missing := Missing + ' GetGlyphSVGForActionOrigin';
  if not Assigned(FFlat.GetGlyphForActionOrigin_Legacy) then Missing := Missing + ' GetGlyphForActionOrigin_Legacy';
  if not Assigned(FFlat.GetStringForActionOrigin) then Missing := Missing + ' GetStringForActionOrigin';
  if not Assigned(FFlat.GetStringForAnalogActionName) then Missing := Missing + ' GetStringForAnalogActionName';
  if not Assigned(FFlat.StopAnalogActionMomentum) then Missing := Missing + ' StopAnalogActionMomentum';
  if not Assigned(FFlat.TriggerVibration) then Missing := Missing + ' TriggerVibration';
  if not Assigned(FFlat.TriggerVibrationExtended) then Missing := Missing + ' TriggerVibrationExtended';
  if not Assigned(FFlat.TriggerSimpleHapticEvent) then Missing := Missing + ' TriggerSimpleHapticEvent';
  if not Assigned(FFlat.SetLEDColor) then Missing := Missing + ' SetLEDColor';
  if not Assigned(FFlat.Legacy_TriggerHapticPulse) then Missing := Missing + ' Legacy_TriggerHapticPulse';
  if not Assigned(FFlat.Legacy_TriggerRepeatedHapticPulse) then Missing := Missing + ' Legacy_TriggerRepeatedHapticPulse';
  if not Assigned(FFlat.ShowBindingPanel) then Missing := Missing + ' ShowBindingPanel';
  if not Assigned(FFlat.GetInputTypeForHandle) then Missing := Missing + ' GetInputTypeForHandle';
  if not Assigned(FFlat.GetControllerForGamepadIndex) then Missing := Missing + ' GetControllerForGamepadIndex';
  if not Assigned(FFlat.GetGamepadIndexForController) then Missing := Missing + ' GetGamepadIndexForController';
  if not Assigned(FFlat.GetStringForXboxOrigin) then Missing := Missing + ' GetStringForXboxOrigin';
  if not Assigned(FFlat.GetGlyphForXboxOrigin) then Missing := Missing + ' GetGlyphForXboxOrigin';
  if not Assigned(FFlat.GetActionOriginFromXboxOrigin) then Missing := Missing + ' GetActionOriginFromXboxOrigin';
  if not Assigned(FFlat.TranslateActionOrigin) then Missing := Missing + ' TranslateActionOrigin';
  if not Assigned(FFlat.GetDeviceBindingRevision) then Missing := Missing + ' GetDeviceBindingRevision';
  if not Assigned(FFlat.GetRemotePlaySessionID) then Missing := Missing + ' GetRemotePlaySessionID';
  if not Assigned(FFlat.GetSessionInputConfigurationSettings) then Missing := Missing + ' GetSessionInputConfigurationSettings';
  if not Assigned(FFlat.SetDualSenseTriggerEffect) then Missing := Missing + ' SetDualSenseTriggerEffect';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  F_GetDigitalActionData := nil;
  F_GetAnalogActionData := nil;
  F_GetMotionData := nil;
  FStarted := False;
  Bind(F_GetDigitalActionData, PFX + 'GetDigitalActionData', False);
  Bind(F_GetAnalogActionData, PFX + 'GetAnalogActionData', False);
  Bind(F_GetMotionData, PFX + 'GetMotionData', False);
  Result := True;
end;

procedure TSteamInputPlugin.DoFinalize;
begin
  Stop;
  F_GetDigitalActionData := nil;
  F_GetAnalogActionData := nil;
  F_GetMotionData := nil;
  FIntf := nil;
  FFlat := Default(TSteamInputFlat);
end;

procedure TSteamInputPlugin.Need(AOk: Boolean; const AExport: string);
begin
  if FIntf = nil then
    raise ESteamworksError.Create('ISteamInput.' + AExport + ': the plug-in is not initialised (Steam not running?)');
  if not AOk then
    raise ESteamworksError.Create('ISteamInput.' + AExport + ': the loaded Steam library does not export ' + PFX + AExport);
end;

