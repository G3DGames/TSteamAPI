  Bind(FFlat.BIsBehindNAT, PFX + 'BIsBehindNAT', False);
  Bind(FFlat.AdvertiseGame, PFX + 'AdvertiseGame', False);
  Bind(FFlat.RequestEncryptedAppTicket, PFX + 'RequestEncryptedAppTicket', False);
  Bind(FFlat.GetEncryptedAppTicket, PFX + 'GetEncryptedAppTicket', False);
  Bind(FFlat.GetGameBadgeLevel, PFX + 'GetGameBadgeLevel', False);
  Bind(FFlat.GetPlayerSteamLevel, PFX + 'GetPlayerSteamLevel', False);
  Bind(FFlat.RequestStoreAuthURL, PFX + 'RequestStoreAuthURL', False);
  Bind(FFlat.BIsPhoneVerified, PFX + 'BIsPhoneVerified', False);
  Bind(FFlat.BIsTwoFactorEnabled, PFX + 'BIsTwoFactorEnabled', False);
