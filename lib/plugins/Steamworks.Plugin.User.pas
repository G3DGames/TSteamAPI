procedure TSteamUser.DoAttach;
begin
  SubscribeCallback(SteamServersConnected_t_k_iCallback, HandleSteamServersConnected);
  SubscribeCallback(SteamServerConnectFailure_t_k_iCallback, HandleSteamServerConnectFailure);
  SubscribeCallback(SteamServersDisconnected_t_k_iCallback, HandleSteamServersDisconnected);
  SubscribeCallback(ClientGameServerDeny_t_k_iCallback, HandleClientGameServerDeny);
  SubscribeCallback(IPCFailure_t_k_iCallback, HandleIPCFailure);
  SubscribeCallback(LicensesUpdated_t_k_iCallback, HandleLicensesUpdated);
  SubscribeCallback(ValidateAuthTicketResponse_t_k_iCallback, HandleValidateAuthTicketResponse);
  SubscribeCallback(MicroTxnAuthorizationResponse_t_k_iCallback, HandleMicroTxnAuthorizationResponse);
  SubscribeCallback(EncryptedAppTicketResponse_t_k_iCallback, HandleEncryptedAppTicketResponse);
  SubscribeCallback(GetAuthSessionTicketResponse_t_k_iCallback, HandleGetAuthSessionTicketResponse);
