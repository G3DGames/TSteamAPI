  Bind(FFlat.BSetDurationControlOnlineState, PFX + 'BSetDurationControlOnlineState', False);
  Missing := '';
  if not Assigned(FFlat.GetHSteamUser) then Missing := Missing + ' GetHSteamUser';
  if not Assigned(FFlat.BLoggedOn) then Missing := Missing + ' BLoggedOn';
  if not Assigned(FFlat.GetSteamID) then Missing := Missing + ' GetSteamID';
  if not Assigned(FFlat.InitiateGameConnection_DEPRECATED) then Missing := Missing + ' InitiateGameConnection_DEPRECATED';
  if not Assigned(FFlat.TerminateGameConnection_DEPRECATED) then Missing := Missing + ' TerminateGameConnection_DEPRECATED';
  if not Assigned(FFlat.TrackAppUsageEvent) then Missing := Missing + ' TrackAppUsageEvent';
  if not Assigned(FFlat.GetUserDataFolder) then Missing := Missing + ' GetUserDataFolder';
  if not Assigned(FFlat.StartVoiceRecording) then Missing := Missing + ' StartVoiceRecording';
  if not Assigned(FFlat.StopVoiceRecording) then Missing := Missing + ' StopVoiceRecording';
  if not Assigned(FFlat.GetAvailableVoice) then Missing := Missing + ' GetAvailableVoice';
  if not Assigned(FFlat.GetVoice) then Missing := Missing + ' GetVoice';
  if not Assigned(FFlat.DecompressVoice) then Missing := Missing + ' DecompressVoice';
  if not Assigned(FFlat.GetVoiceOptimalSampleRate) then Missing := Missing + ' GetVoiceOptimalSampleRate';
  if not Assigned(FFlat.GetAuthSessionTicket) then Missing := Missing + ' GetAuthSessionTicket';
  if not Assigned(FFlat.GetAuthTicketForWebApi) then Missing := Missing + ' GetAuthTicketForWebApi';
  if not Assigned(FFlat.BeginAuthSession) then Missing := Missing + ' BeginAuthSession';
  if not Assigned(FFlat.EndAuthSession) then Missing := Missing + ' EndAuthSession';
  if not Assigned(FFlat.CancelAuthTicket) then Missing := Missing + ' CancelAuthTicket';
  if not Assigned(FFlat.UserHasLicenseForApp) then Missing := Missing + ' UserHasLicenseForApp';
  if not Assigned(FFlat.BIsBehindNAT) then Missing := Missing + ' BIsBehindNAT';
  if not Assigned(FFlat.AdvertiseGame) then Missing := Missing + ' AdvertiseGame';
  if not Assigned(FFlat.RequestEncryptedAppTicket) then Missing := Missing + ' RequestEncryptedAppTicket';
  if not Assigned(FFlat.GetEncryptedAppTicket) then Missing := Missing + ' GetEncryptedAppTicket';
  if not Assigned(FFlat.GetGameBadgeLevel) then Missing := Missing + ' GetGameBadgeLevel';
  if not Assigned(FFlat.GetPlayerSteamLevel) then Missing := Missing + ' GetPlayerSteamLevel';
  if not Assigned(FFlat.RequestStoreAuthURL) then Missing := Missing + ' RequestStoreAuthURL';
  if not Assigned(FFlat.BIsPhoneVerified) then Missing := Missing + ' BIsPhoneVerified';
  if not Assigned(FFlat.BIsTwoFactorEnabled) then Missing := Missing + ' BIsTwoFactorEnabled';
  if not Assigned(FFlat.BIsPhoneIdentifying) then Missing := Missing + ' BIsPhoneIdentifying';
  if not Assigned(FFlat.BIsPhoneRequiringVerification) then Missing := Missing + ' BIsPhoneRequiringVerification';
  if not Assigned(FFlat.GetMarketEligibility) then Missing := Missing + ' GetMarketEligibility';
  if not Assigned(FFlat.GetDurationControl) then Missing := Missing + ' GetDurationControl';
  if not Assigned(FFlat.BSetDurationControlOnlineState) then Missing := Missing + ' BSetDurationControlOnlineState';
  if Missing <> '' then
    Log(sllDebug, 'Exports missing from the loaded library (calling them raises):' + Missing);
  Result := True;
end;

