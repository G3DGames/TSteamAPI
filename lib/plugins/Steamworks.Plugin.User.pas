    procedure HandleSteamServerConnectFailure(const AData: TSteamCallbackData);
    { Raises @link(OnSteamServersDisconnected) for SteamServersDisconnected_t. }
    procedure HandleSteamServersDisconnected(const AData: TSteamCallbackData);
    { Raises @link(OnClientGameServerDeny) for ClientGameServerDeny_t. }
    procedure HandleClientGameServerDeny(const AData: TSteamCallbackData);
    { Raises @link(OnIPCFailure) for IPCFailure_t. }
    procedure HandleIPCFailure(const AData: TSteamCallbackData);
    { Raises @link(OnLicensesUpdated) for LicensesUpdated_t. }
    procedure HandleLicensesUpdated(const AData: TSteamCallbackData);
    { Raises @link(OnValidateAuthTicketResponse) for ValidateAuthTicketResponse_t. }
    procedure HandleValidateAuthTicketResponse(const AData: TSteamCallbackData);
    { Raises @link(OnMicroTxnAuthorizationResponse) for MicroTxnAuthorizationResponse_t. }
    procedure HandleMicroTxnAuthorizationResponse(const AData: TSteamCallbackData);
    { Raises @link(OnEncryptedAppTicketResponse) for EncryptedAppTicketResponse_t. }
    procedure HandleEncryptedAppTicketResponse(const AData: TSteamCallbackData);
    { Raises @link(OnGetAuthSessionTicketResponse) for GetAuthSessionTicketResponse_t. }
    procedure HandleGetAuthSessionTicketResponse(const AData: TSteamCallbackData);
    { Raises @link(OnGameWebCallback) for GameWebCallback_t. }
    procedure HandleGameWebCallback(const AData: TSteamCallbackData);
    { Raises @link(OnStoreAuthURLResponse) for StoreAuthURLResponse_t. }
    procedure HandleStoreAuthURLResponse(const AData: TSteamCallbackData);
    { Raises @link(OnMarketEligibilityResponse) for MarketEligibilityResponse_t. }
    procedure HandleMarketEligibilityResponse(const AData: TSteamCallbackData);
    { Raises @link(OnDurationControl) for DurationControl_t. }
    procedure HandleDurationControl(const AData: TSteamCallbackData);
    { Raises @link(OnGetTicketForWebApiResponse) for GetTicketForWebApiResponse_t. }
    procedure HandleGetTicketForWebApiResponse(const AData: TSteamCallbackData);
  protected
    { Subscribes every callback of this interface. }
    procedure DoAttach; override;
  public
    { The ISteamUser plug-in, for calls; @nil while Steam is not running. }
    property Plugin: TSteamUserPlugin read GetPlugin;
  published
    { The TSteamAPI this component belongs to. }
    property SteamAPI;
    { Callback 101 (SteamServersConnected_t): Called when an authenticated connection to the Steam
      back-end has been established. This means the Steam client now has a working connection to
      the Steam servers. Usually this will have occurred before the game has launched, and should
      only be seen if the user has dropped connection due to a networking issue or a Steam server
      update. }
    property OnSteamServersConnected: TSteamServersConnectedEvent read FOnSteamServersConnected write FOnSteamServersConnected;
    { Callback 102 (SteamServerConnectFailure_t): called when a connection attempt has failed this
      will occur periodically if the Steam client is not connected, and has failed in it's retry
      to establish a connection. }
    property OnSteamServerConnectFailure: TSteamServerConnectFailureEvent read FOnSteamServerConnectFailure write FOnSteamServerConnectFailure;
    { Callback 103 (SteamServersDisconnected_t): called if the client has lost connection to the
      Steam servers real-time services will be disabled until a matching SteamServersConnected_t
      has been posted. }
    property OnSteamServersDisconnected: TSteamServersDisconnectedEvent read FOnSteamServersDisconnected write FOnSteamServersDisconnected;
    { Callback 113 (ClientGameServerDeny_t): Sent by the Steam server to the client telling it to
      disconnect from the specified game server, which it may be in the process of or already
      connected to. The game client should immediately disconnect upon receiving this message.
      This can usually occur if the user doesn't have rights to play on the game server. }
    property OnClientGameServerDeny: TClientGameServerDenyEvent read FOnClientGameServerDeny write FOnClientGameServerDeny;
    { Callback 117 (IPCFailure_t): called when the callback system for this client is in an error
      state (and has flushed pending callbacks) When getting this message the client should
      disconnect from Steam, reset any stored Steam state and reconnect. This usually occurs in
      the rare event the Steam client has some kind of fatal error. }
    property OnIPCFailure: TIPCFailureEvent read FOnIPCFailure write FOnIPCFailure;
    { Callback 125 (LicensesUpdated_t): Signaled whenever licenses change. }
    property OnLicensesUpdated: TLicensesUpdatedEvent read FOnLicensesUpdated write FOnLicensesUpdated;
    { Callback 143 (ValidateAuthTicketResponse_t): callback for BeginAuthSession. }
    property OnValidateAuthTicketResponse: TValidateAuthTicketResponseEvent read FOnValidateAuthTicketResponse write FOnValidateAuthTicketResponse;
    { Callback 152 (MicroTxnAuthorizationResponse_t): called when a user has responded to a
      microtransaction authorization request. }
    property OnMicroTxnAuthorizationResponse: TMicroTxnAuthorizationResponseEvent read FOnMicroTxnAuthorizationResponse write FOnMicroTxnAuthorizationResponse;
    { Callback 154 (EncryptedAppTicketResponse_t): Result from RequestEncryptedAppTicket. }
    property OnEncryptedAppTicketResponse: TEncryptedAppTicketResponseEvent read FOnEncryptedAppTicketResponse write FOnEncryptedAppTicketResponse;
    { Callback 163 (GetAuthSessionTicketResponse_t): callback for GetAuthSessionTicket. }
    property OnGetAuthSessionTicketResponse: TGetAuthSessionTicketResponseEvent read FOnGetAuthSessionTicketResponse write FOnGetAuthSessionTicketResponse;
    { Callback 164 (GameWebCallback_t): sent to your game in response to a
      steam://gamewebcallback/ command. }
    property OnGameWebCallback: TGameWebCallbackEvent read FOnGameWebCallback write FOnGameWebCallback;
    { Callback 165 (StoreAuthURLResponse_t): sent to your game in response to
      ISteamUser::RequestStoreAuthURL. }
    property OnStoreAuthURLResponse: TStoreAuthURLResponseEvent read FOnStoreAuthURLResponse write FOnStoreAuthURLResponse;
    { Callback 166 (MarketEligibilityResponse_t): sent in response to
      ISteamUser::GetMarketEligibility. }
    property OnMarketEligibilityResponse: TMarketEligibilityResponseEvent read FOnMarketEligibilityResponse write FOnMarketEligibilityResponse;
    { Callback 167 (DurationControl_t): sent for games with enabled anti indulgence / duration
      control, for enabled users. Lets the game know whether the user can keep playing or whether
      the game should exit, and returns info about remaining gameplay time. This callback is fired
      asynchronously in response to timers triggering. It is also fired in response to calls to
      GetDurationControl(). }
    property OnDurationControl: TDurationControlEvent read FOnDurationControl write FOnDurationControl;
    { Callback 168 (GetTicketForWebApiResponse_t): callback for GetTicketForWebApi. }
    property OnGetTicketForWebApiResponse: TGetTicketForWebApiResponseEvent read FOnGetTicketForWebApiResponse write FOnGetTicketForWebApiResponse;
  end;

