# Delphi build output
Win32/
Win64/
OSX64/
OSXARM64/
Linux64/
__history/
__recovery/
*.dcu
*.local
*.identcache
*.dsk
*.tvsconfig
*.stat
*.deployproj
*.res
*.exe
*.bpl
*.dcp

# Free Pascal / Lazarus build output
# Lazarus puts units in lib/<cpu>-<os>/ (e.g. lib/x86_64-linux). The pattern
# needs the dash, so the library folder lib/ and lib/plugins/ stay tracked.
lib/*-*/
*.o
*.ppu
*.a
*.or
*.rst
*.rsj
*.compiled
*.lps
*.dbg
*.bak
backup/
link*.res
ppas.sh
ppas.bat
heap.trc
*.app/
# Extensionless executables FPC writes next to the .dpr / .lpr
/demos/SteamConsole/SteamConsole
/demos/SteamDemo/SteamDemo
# Lazarus demo output: executable (plus the Steam library you copy next to
# it) in <cpu>-<os>/, units in lib/<cpu>-<os>/
/demos/SteamDemoLCL/*-*/
# its unit output (lib/<cpu>-<os>/ - the lib/*-*/ pattern above is anchored
# to the repository root, so it does not match here)
/demos/SteamDemoLCL/lib/
# Lazarus package output: units in packages/lib/<cpu>-<os>/, and the package
# unit Lazarus regenerates from the .lpk on every compile
/packages/lib/
/packages/SteamworksLCL.pas

# Steamworks SDK redistributables: copied in by each developer, never committed
redistributable_bin/*
!redistributable_bin/README.md

# PasDoc output
docs/html/

# Python bytecode of the tools
__pycache__/
