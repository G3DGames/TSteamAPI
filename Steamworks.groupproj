    </PropertyGroup>
    <ItemGroup>
        <Projects Include="demos\SteamDemo\SteamDemo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="demos\SteamConsole\SteamConsole.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="packages\SteamworksFMX.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="packages\dclSteamworksFMX.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SteamDemo">
        <MSBuild Projects="demos\SteamDemo\SteamDemo.dproj"/>
    </Target>
    <Target Name="SteamDemo:Clean">
        <MSBuild Projects="demos\SteamDemo\SteamDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SteamDemo:Make">
        <MSBuild Projects="demos\SteamDemo\SteamDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="SteamConsole">
        <MSBuild Projects="demos\SteamConsole\SteamConsole.dproj"/>
    </Target>
    <Target Name="SteamConsole:Clean">
        <MSBuild Projects="demos\SteamConsole\SteamConsole.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SteamConsole:Make">
        <MSBuild Projects="demos\SteamConsole\SteamConsole.dproj" Targets="Make"/>
    </Target>
    <Target Name="SteamworksFMX">
        <MSBuild Projects="packages\SteamworksFMX.dproj"/>
    </Target>
    <Target Name="SteamworksFMX:Clean">
        <MSBuild Projects="packages\SteamworksFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SteamworksFMX:Make">
