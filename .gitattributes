*.glb binary
# Palette icons and the resource files built from them (tools/gen_icon_res.py):
# never touched by line-ending conversion
*.ico binary
*.icns binary
*.dcr binary
*.res binary
# Shell scripts run on Linux: always LF, also in a Windows checkout
# (a CRLF script fails with "/bin/sh^M: bad interpreter")
*.sh text eol=lf
# Windows batch files: always CRLF (cmd can mis-handle labels / goto in an
# LF batch file)
*.bat text eol=crlf
